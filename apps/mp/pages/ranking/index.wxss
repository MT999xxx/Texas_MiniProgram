/* pages/ranking/index.wxss */
page {
  background-color: #080808;
  padding-bottom: 120rpx;
}

.container {
  width: 100%;
  min-height: 100vh;
  position: relative;
  z-index: 10;
}

/* 0. 沉浸式背景 (同步全站极致规范) */
.hero-bg-lux-ranking {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  background: 
    radial-gradient(circle at 50% -20%, rgba(212, 175, 55, 0.15) 0%, transparent 60%),
    radial-gradient(circle at -10% 40%, rgba(212, 175, 55, 0.05) 0%, transparent 40%),
    radial-gradient(circle at 110% 60%, rgba(26, 21, 10, 0.8) 0%, #050505 100%);
}

.header-section {
  padding: 20rpx 40rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.store-label {
  position: absolute;
  left: 0; right: 0;
  top: 30rpx;
  text-align: center;
  font-size: 18rpx;
  color: #666;
  letter-spacing: 8rpx;
  opacity: 0.8;
}

.page-title {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 12rpx;
  margin-top: 15rpx;
  margin-bottom: 5rpx;
}

.date-range {
  font-size: 18rpx;
  color: #444;
  margin-bottom: 15rpx;
  letter-spacing: 2rpx;
}

/* Tab 栏 (极简设计) */
.tab-header {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.tab-item {
  position: relative;
  padding: 10rpx 14rpx;
}

.tab-text {
  font-size: 24rpx;
  color: #666;
  letter-spacing: 1rpx;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #D4AF37;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 2rpx;
  background: #D4AF37;
  box-shadow: 0 0 10rpx #D4AF37;
}

/* --- 2. 排行榜列表区域 --- */
.ranking-list-container {
  padding: 10rpx 30rpx;
}

.list-wrapper {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 34rpx 40rpx;
  position: relative;
  overflow: hidden;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.015);
  border: 1rpx solid rgba(255, 255, 255, 0.03);
}

.top-rank {
  border: 1rpx solid rgba(212, 175, 55, 0.25);
  background: rgba(212, 175, 55, 0.03) !important;
}

.rank-1::after {
  content: "";
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.05), transparent);
  animation: logoShimmer 3s infinite;
}

/* 排名勋章 */
.rank-badge {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.rank-num-text {
  font-size: 36rpx;
  font-weight: 800;
  font-style: italic;
  color: #333;
}

.rank-1 .rank-num-text { color: #F9E498; font-size: 48rpx; }
.rank-2 .rank-num-text { color: #C0C0C0; }
.rank-3 .rank-num-text { color: #CD7F32; }

.rank-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  background: #111;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rank-name {
  color: #EEE;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.rank-score {
  color: #D4AF37;
  font-size: 34rpx;
  font-weight: 700;
  font-family: 'SF Pro Text', sans-serif;
}

.score-unit {
  font-size: 18rpx;
  font-weight: 400;
  color: #666;
  margin-left: 4rpx;
}

/* 会员级别徽章 - 基础样式 */
.rank-level-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
  background: rgba(212, 175, 55, 0.1);
  border: 1rpx solid rgba(212, 175, 55, 0.3);
}

.rank-level-text {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #D4AF37;
  white-space: nowrap;
}

/* V1 尊荣白银 - 银白色调 */
.rank-level-badge.level-V1 {
  background: linear-gradient(135deg, rgba(192, 192, 192, 0.15), rgba(160, 160, 160, 0.08));
  border: 1rpx solid rgba(192, 192, 192, 0.4);
}
.rank-level-badge.level-V1 .rank-level-text {
  color: #C0C0C0;
}

/* V2 奢华黄金 - 翡翠绿色调 */
.rank-level-badge.level-V2 {
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.15), rgba(56, 142, 60, 0.08));
  border: 1rpx solid rgba(76, 175, 80, 0.4);
}
.rank-level-badge.level-V2 .rank-level-text {
  color: #66BB6A;
}

/* V3 高贵铂金 - 冰蓝色调 */
.rank-level-badge.level-V3 {
  background: linear-gradient(135deg, rgba(100, 181, 246, 0.15), rgba(66, 165, 245, 0.08));
  border: 1rpx solid rgba(100, 181, 246, 0.4);
}
.rank-level-badge.level-V3 .rank-level-text {
  color: #64B5F6;
}

/* V4 巅峰钻石 - 皇家紫色调 */
.rank-level-badge.level-V4 {
  background: linear-gradient(135deg, rgba(186, 104, 200, 0.15), rgba(171, 71, 188, 0.08));
  border: 1rpx solid rgba(186, 104, 200, 0.4);
}
.rank-level-badge.level-V4 .rank-level-text {
  color: #CE93D8;
}

/* V5 星耀黑金 - 至尊豪华版 */
.rank-level-badge.level-V5 {
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1508 50%, #0a0a0a 100%);
  border: 1rpx solid rgba(212, 175, 55, 0.6);
  box-shadow:
    0 0 12rpx rgba(212, 175, 55, 0.3),
    inset 0 0 8rpx rgba(212, 175, 55, 0.08);
  padding: 10rpx 22rpx;
  position: relative;
  overflow: hidden;
}

/* 流光扫描动画 */
.rank-level-badge.level-V5::after {
  content: "";
  position: absolute;
  top: 0; left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(249, 228, 152, 0.15),
    rgba(212, 175, 55, 0.25),
    rgba(249, 228, 152, 0.15),
    transparent
  );
  animation: v5Shimmer 3s ease-in-out infinite;
}

@keyframes v5Shimmer {
  0% { left: -100%; }
  100% { left: 200%; }
}

.rank-level-badge.level-V5 .rank-level-text {
  background: linear-gradient(135deg, #F9E498 0%, #D4AF37 40%, #F9E498 60%, #B8860B 100%);
  -webkit-background-clip: text;
  color: transparent;
  font-weight: 700;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

/* VP 三条A合伙人 - 彩虹至尊版 */
.rank-level-badge.level-VP {
  position: relative;
  padding: 10rpx 22rpx;
  background: linear-gradient(135deg, #0d0d0d 0%, #1a0d1a 50%, #0d0d0d 100%);
  border-radius: 20rpx;
  /* 彩虹渐变边框通过伪元素实现 */
  border: none;
  box-shadow:
    0 0 0 1rpx transparent,
    0 0 16rpx rgba(180, 100, 255, 0.4),
    0 0 28rpx rgba(100, 200, 255, 0.2);
}

/* 外层彩虹边框（静态，不旋转） */
.rank-level-badge.level-VP::before {
  content: "";
  position: absolute;
  inset: -2rpx;
  border-radius: 22rpx;
  background: conic-gradient(
    from 0deg,
    #ff4d4d, #ff9900, #ffe600,
    #00ff88, #00cfff, #7c4dff,
    #ff4daa, #ff4d4d
  );
  /* 删除 animation，保持静态彩虹 */
  z-index: -1;
}

/* 流彩扫光 */
.rank-level-badge.level-VP::after {
  content: "";
  position: absolute;
  top: 0; left: -100%;
  width: 70%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,0.12),
    rgba(255,220,255,0.2),
    rgba(255,255,255,0.12),
    transparent
  );
  animation: vpShimmer 2.5s ease-in-out infinite;
  z-index: 1;
}


@keyframes vpShimmer {
  0%   { left: -100%; }
  100% { left: 200%; }
}

.rank-level-badge.level-VP .rank-level-text {
  background: linear-gradient(
    90deg,
    #ff9999 0%,
    #ffdd88 20%,
    #88ffbb 40%,
    #88ddff 60%,
    #bb88ff 80%,
    #ff88cc 100%
  );
  -webkit-background-clip: text;
  color: transparent;
  font-weight: 800;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 2;
}

.item-accent {
  position: absolute;
  right: -20rpx; top: -20rpx;
  width: 100rpx; height: 100rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.css-icon-shield {
  width: 80rpx;
  height: 100rpx;
  background: rgba(212, 175, 55, 0.05);
  border: 2rpx solid rgba(212, 175, 55, 0.2);
  border-radius: 10rpx 10rpx 40rpx 40rpx;
  margin-bottom: 40rpx;
  position: relative;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 20rpx;
  color: #333;
}

/* 用户排名卡片 (悬浮) */
.user-rank-card {
  position: fixed;
  bottom: 150rpx;
  left: 30rpx; right: 30rpx;
  padding: 34rpx 44rpx;
  z-index: 100;
  border-radius: 44rpx;
  background: rgba(15, 15, 15, 0.8) !important;
  backdrop-filter: blur(40rpx) !important;
  border: 1rpx solid rgba(212, 175, 55, 0.3) !important;
  box-shadow: 0 -10rpx 40rpx rgba(0,0,0,0.8);
}

.user-rank-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  color: #FDFDFD;
  font-size: 28rpx;
  font-weight: 600;
}

.user-score {
  color: #D4AF37;
  font-size: 22rpx;
}

.rank-text {
  font-size: 40rpx;
  font-weight: 900;
  color: #D4AF37;
  font-style: italic;
  padding-left: 30rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.05);
}

.loading-container {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  color: #444;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}