/* pages/ranking/index.wxss */
page {
  background-color: #080808;
  padding-bottom: 120rpx;
}

.container {
  width: 100%;
  min-height: 100vh;
  background-color: #080808;
}

/* --- 1. 头部区域 --- */
.header-section {
  padding: 60rpx 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  background: radial-gradient(circle at top, #1a1a1a 0%, #080808 100%);
}

.store-label {
  position: absolute;
  left: 40rpx;
  top: 30rpx;
  font-size: 22rpx;
  color: #D4AF37;
  letter-spacing: 4rpx;
  opacity: 0.8;
}

.page-title {
  font-size: 72rpx;
  color: #D4AF37;
  font-weight: 900;
  letter-spacing: 12rpx;
  margin-top: 40rpx;
  text-shadow: 0 0 30rpx rgba(212, 175, 55, 0.2);
}

.date-range {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 50rpx;
}

/* Tab 栏 */
.tab-header {
  width: 100%;
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.tab-item {
  font-size: 28rpx;
  color: #666;
  position: relative;
  padding-bottom: 15rpx;
  letter-spacing: 2rpx;
}

.tab-item.active {
  color: #D4AF37;
  font-weight: bold;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 4rpx;
  background-color: #D4AF37;
  border-radius: 2rpx;
  box-shadow: 0 0 10rpx #D4AF37;
}

/* --- 2. 排行榜列表区域 --- */
.ranking-list-container {
  padding: 40rpx 30rpx;
  margin: 20rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}

.rank-num {
  width: 80rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #333;
  font-style: italic;
}

.rank-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.rank-info {
  flex: 1;
}

.rank-name {
  color: #EEE;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.rank-score {
  color: #666;
  font-size: 24rpx;
}

/* 前三名特殊处理 */
.ranking-item:nth-child(1) .rank-num { color: #D4AF37; text-shadow: 0 0 15rpx rgba(212, 175, 55, 0.3); }
.ranking-item:nth-child(2) .rank-num { color: #C0C0C0; }
.ranking-item:nth-child(3) .rank-num { color: #CD7F32; }

/* 用户排名卡片 (悬浮) */
.user-rank-card {
  position: fixed;
  bottom: 130rpx;
  left: 30rpx;
  right: 30rpx;
  padding: 30rpx;
  z-index: 100;
}

.user-rank-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 2rpx solid #D4AF37;
}

.user-details {
  flex: 1;
}

.user-name {
  color: #FDFDFD;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.user-score {
  color: #888;
  font-size: 24rpx;
}

.rank-text {
  color: #D4AF37;
  font-size: 36rpx;
  font-weight: 800;
  padding-left: 20rpx;
  border-left: 1rpx solid rgba(212, 175, 55, 0.2);
}