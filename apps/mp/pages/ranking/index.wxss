/* pages/ranking/index.wxss */
page {
  background-color: #1c1c1e; /* 页面背景色与列表背景一致，防止露底 */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  padding-bottom: 120rpx; /* 底部导航栏空间 */
}

.container {
  width: 100%;
  min-height: 100vh;
  background-color: #8b0000;
}

/* --- 1. 头部区域 --- */
.header-section {
  background-color: #8b0000;
  padding: 20rpx 40rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.store-label {
  position: absolute;
  left: 40rpx;
  top: 20rpx;
  font-size: 28rpx;
  color: #ffebeb;
  font-weight: bold;
}

.page-title {
  font-size: 80rpx;
  color: #4a0e0e;
  font-weight: 400;
  letter-spacing: 4rpx;
  margin-top: 40rpx;
  margin-bottom: 10rpx;
}

.date-range {
  font-size: 24rpx;
  color: #cc3333;
  margin-bottom: 60rpx;
}

/* Tab 栏 */
.tab-header {
  width: 100%;
  display: flex;
  justify-content: space-around;
  padding-bottom: 30rpx;
}

.tab-item {
  font-size: 30rpx;
  color: #cc9999;
  position: relative;
  padding-bottom: 10rpx;
}

.tab-item.active {
  color: #ffebeb;
  font-weight: bold;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #ffebeb;
  border-radius: 4rpx;
}

/* --- 2. 排行榜列表区域 --- */
.ranking-list-container {
  background-color: #111;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 40rpx 30rpx;
  min-height: 60vh;
  width: 90%;
  margin: -20rpx 24rpx 0 24rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
  border: 1rpx solid #330000;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.rank-num {
  width: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: #cc3333;
  font-weight: bold;
  margin-right: 20rpx;
}

.rank-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  border: 2rpx solid #8b0000;
  margin-right: 30rpx;
}

.rank-info {
  display: flex;
  flex-direction: column;
}

.rank-name {
  color: #cc3333;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.rank-score {
  color: #996666;
  font-size: 24rpx;
}

/* Loading状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400rpx;
}

.loading-text {
  color: #996666;
  font-size: 28rpx;
}

/* 空数据提示 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  padding: 60rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: #cc3333;
  font-size: 32rpx;
  margin-bottom: 15rpx;
}

.empty-hint {
  color: #996666;
  font-size: 24rpx;
}

/* 前三名特殊颜色 */
.rank-1 {
  color: #8b0000 !important;
  text-shadow: 0 0 10rpx rgba(139, 0, 0, 0.5);
}

.rank-2 {
  color: #cc3333 !important;
}

.rank-3 {
  color: #cc9999 !important;
}

.rank-normal {
  color: #996666;
}

/* 用户排名卡片 */
.user-rank-card {
  position: fixed;
  bottom: 120rpx;
  left: 24rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #8b0000 0%, #4a0e0e 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 0, 0, 0.5);
  z-index: 10;
  border: 1rpx solid #330000;
}

.user-rank-content {
  display: flex;
  flex-direction: column;
}

.user-rank-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.user-rank-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid #ffebeb;
  margin-right: 24rpx;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  color: #ffebeb;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.user-score {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
}

.user-rank-badge {
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
}

.rank-text {
  color: #ffebeb;
  font-size: 36rpx;
  font-weight: bold;
}