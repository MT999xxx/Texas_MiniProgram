/* pages/ranking/index.wxss */
page {
  background-color: #050506;
  --setbar-tabbar-space: calc(154rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

.container {
  width: 100%;
  min-height: 100vh;
  position: relative;
  z-index: 10;
}

/* 0. 沉浸式背景 (同步全站极致规范) */
.hero-bg-lux-ranking {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  background:
    linear-gradient(180deg, rgba(5, 5, 6, 0.3), #050506 72%),
    url('/images/setbar-panther-hero.jpg');
  background-size: cover;
  background-position: 70% 12%;
  opacity: 0.88;
}

.header-section {
  padding: 54rpx 34rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.rank-hero-icon {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 0 22rpx rgba(230, 198, 120, 0.3));
}

.store-label {
  text-align: center;
  font-size: 16rpx;
  color: #D64A3B;
  letter-spacing: 5rpx;
  font-weight: 800;
  opacity: 0.96;
}

.page-title {
  font-size: 62rpx;
  font-weight: 900;
  letter-spacing: 0;
  margin-top: 6rpx;
  margin-bottom: 10rpx;
  color: #F8F5EC;
  text-shadow: 0 18rpx 46rpx rgba(0,0,0,0.7);
}

.date-range {
  font-size: 18rpx;
  color: #444;
  margin-bottom: 15rpx;
  letter-spacing: 2rpx;
}

/* Tab 栏 (极简设计) */
.tab-header {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 8rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
  backdrop-filter: blur(20rpx);
}

.tab-item {
  position: relative;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
}

.tab-item.active {
  background: rgba(214, 74, 59, 0.18);
}

.tab-text {
  font-size: 24rpx;
  color: #666;
  letter-spacing: 1rpx;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #FFF3C8;
  font-weight: 600;
}

.tab-indicator {
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 2rpx;
  background: #D64A3B;
  box-shadow: 0 0 10rpx rgba(214, 74, 59, 0.8);
}

/* --- 2. 排行榜列表区域 --- */
.ranking-list-container {
  padding: 14rpx 28rpx;
}

.list-wrapper {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(18rpx);
}

.top-rank {
  border: 1rpx solid rgba(230, 198, 120, 0.22);
  background: linear-gradient(135deg, rgba(230, 198, 120, 0.12), rgba(255, 255, 255, 0.045)) !important;
}

.rank-1::after {
  content: "";
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(230, 198, 120, 0.05), transparent);
  animation: logoShimmer 3s infinite;
}

/* 排名勋章 */
.rank-badge {
  width: 58rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 26rpx;
}

.rank-num-text {
  font-size: 36rpx;
  font-weight: 800;
  font-style: italic;
  color: #333;
}

.rank-1 .rank-num-text { color: #FFF3C8; font-size: 48rpx; }
.rank-2 .rank-num-text { color: #C0C0C0; }
.rank-3 .rank-num-text { color: #CD7F32; }

.rank-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 28rpx;
  margin-right: 30rpx;
  background: #111;
}

.rank-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.rank-name {
  color: #F8F5EC;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-score {
  color: #E6C678;
  font-size: 36rpx;
  font-weight: 700;
  font-family: 'SF Pro Text', sans-serif;
}

.score-unit {
  font-size: 18rpx;
  font-weight: 400;
  color: #666;
  margin-left: 4rpx;
}

/* 会员级别徽章 - 基础样式 */
.rank-level-badge {
  flex-shrink: 0;
  width: 154rpx;
  min-height: 58rpx;
  padding: 7rpx 10rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
  background: rgba(230, 198, 120, 0.1);
  border: 1rpx solid rgba(230, 198, 120, 0.3);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.rank-level-icon {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
  margin-right: 8rpx;
}

.rank-level-copy {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.rank-level-code {
  color: #f3d982;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.1;
}

.rank-level-text {
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 0;
  color: #E6C678;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rank-level-badge.level-V6 { border-color: rgba(216, 93, 85, 0.58); background: rgba(95, 25, 24, 0.24); }
.rank-level-badge.level-V7 { border-color: rgba(240, 199, 94, 0.62); background: rgba(105, 78, 18, 0.22); }
.rank-level-badge.level-V8 { border-color: rgba(77, 120, 201, 0.62); background: rgba(31, 55, 103, 0.28); }
.rank-level-badge.level-V9 { border-color: rgba(76, 168, 122, 0.62); background: rgba(22, 75, 50, 0.25); }
.rank-level-badge.level-V10 { border-color: rgba(200, 77, 66, 0.68); background: rgba(95, 23, 20, 0.3); }

/* V1 尊荣白银 - 银白色调 */
.rank-level-badge.level-V1 {
  background: linear-gradient(135deg, rgba(192, 192, 192, 0.15), rgba(160, 160, 160, 0.08));
  border: 1rpx solid rgba(192, 192, 192, 0.4);
}
.rank-level-badge.level-V1 .rank-level-text {
  color: #C0C0C0;
}

/* V2 奢华黄金 - 翡翠绿色调 */
.rank-level-badge.level-V2 {
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.15), rgba(56, 142, 60, 0.08));
  border: 1rpx solid rgba(76, 175, 80, 0.4);
}
.rank-level-badge.level-V2 .rank-level-text {
  color: #66BB6A;
}

/* V3 高贵铂金 - 冰蓝色调 */
.rank-level-badge.level-V3 {
  background: linear-gradient(135deg, rgba(100, 181, 246, 0.15), rgba(66, 165, 245, 0.08));
  border: 1rpx solid rgba(100, 181, 246, 0.4);
}
.rank-level-badge.level-V3 .rank-level-text {
  color: #64B5F6;
}

/* V4 巅峰钻石 - 深紫夜场色调 */
.rank-level-badge.level-V4 {
  background: linear-gradient(135deg, rgba(186, 104, 200, 0.15), rgba(171, 71, 188, 0.08));
  border: 1rpx solid rgba(186, 104, 200, 0.4);
}
.rank-level-badge.level-V4 .rank-level-text {
  color: #CE93D8;
}

/* V5 星耀黑金 - 至尊豪华版 */
.rank-level-badge.level-V5 {
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1508 50%, #0a0a0a 100%);
  border: 1rpx solid rgba(230, 198, 120, 0.6);
  box-shadow:
    0 0 12rpx rgba(230, 198, 120, 0.3),
    inset 0 0 8rpx rgba(230, 198, 120, 0.08);
  position: relative;
  overflow: hidden;
}

/* 流光扫描动画 */
.rank-level-badge.level-V5::after {
  content: "";
  position: absolute;
  top: 0; left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(249, 228, 152, 0.15),
    rgba(230, 198, 120, 0.25),
    rgba(249, 228, 152, 0.15),
    transparent
  );
  animation: v5Shimmer 3s ease-in-out infinite;
}

@keyframes v5Shimmer {
  0% { left: -100%; }
  100% { left: 200%; }
}

.rank-level-badge.level-V5 .rank-level-text {
  background: linear-gradient(135deg, #FFF3C8 0%, #E6C678 40%, #FFF3C8 60%, #8C6A2F 100%);
  -webkit-background-clip: text;
  color: transparent;
  font-weight: 600;
  font-size: 17rpx;
  letter-spacing: 0;
}

/* V1-V10 use identical badge typography and spacing; color remains level-specific. */
.rank-level-badge.level-V1,
.rank-level-badge.level-V2,
.rank-level-badge.level-V3,
.rank-level-badge.level-V4,
.rank-level-badge.level-V5,
.rank-level-badge.level-V6,
.rank-level-badge.level-V7,
.rank-level-badge.level-V8,
.rank-level-badge.level-V9,
.rank-level-badge.level-V10 {
  padding: 7rpx 10rpx;
}

.rank-level-badge.level-V1 .rank-level-text,
.rank-level-badge.level-V2 .rank-level-text,
.rank-level-badge.level-V3 .rank-level-text,
.rank-level-badge.level-V4 .rank-level-text,
.rank-level-badge.level-V5 .rank-level-text,
.rank-level-badge.level-V6 .rank-level-text,
.rank-level-badge.level-V7 .rank-level-text,
.rank-level-badge.level-V8 .rank-level-text,
.rank-level-badge.level-V9 .rank-level-text,
.rank-level-badge.level-V10 .rank-level-text {
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 0;
}

/* VP Set baR合伙人 - 彩虹至尊版 */
.rank-level-badge.level-VP {
  position: relative;
  padding: 10rpx 22rpx;
  background: linear-gradient(135deg, #0d0d0d 0%, #1a0d1a 50%, #0d0d0d 100%);
  border-radius: 20rpx;
  /* 彩虹渐变边框通过伪元素实现 */
  border: none;
  box-shadow:
    0 0 0 1rpx transparent,
    0 0 16rpx rgba(180, 100, 255, 0.4),
    0 0 28rpx rgba(100, 200, 255, 0.2);
}

/* 外层彩虹边框（静态，不旋转） */
.rank-level-badge.level-VP::before {
  content: "";
  position: absolute;
  inset: -2rpx;
  border-radius: 22rpx;
  background: conic-gradient(
    from 0deg,
    #ff4d4d, #ff9900, #ffe600,
    #00ff88, #00cfff, #7c4dff,
    #ff4daa, #ff4d4d
  );
  /* 删除 animation，保持静态彩虹 */
  z-index: -1;
}

/* 流彩扫光 */
.rank-level-badge.level-VP::after {
  content: "";
  position: absolute;
  top: 0; left: -100%;
  width: 70%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,0.12),
    rgba(255,220,255,0.2),
    rgba(255,255,255,0.12),
    transparent
  );
  animation: vpShimmer 2.5s ease-in-out infinite;
  z-index: 1;
}


@keyframes vpShimmer {
  0%   { left: -100%; }
  100% { left: 200%; }
}

.rank-level-badge.level-VP .rank-level-text {
  background: linear-gradient(
    90deg,
    #ff9999 0%,
    #ffdd88 20%,
    #88ffbb 40%,
    #88ddff 60%,
    #bb88ff 80%,
    #ff88cc 100%
  );
  -webkit-background-clip: text;
  color: transparent;
  font-weight: 800;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 2;
}

.item-accent {
  position: absolute;
  right: -20rpx; top: -20rpx;
  width: 100rpx; height: 100rpx;
  background: radial-gradient(circle, rgba(230, 198, 120, 0.1) 0%, transparent 70%);
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.css-icon-shield {
  width: 80rpx;
  height: 100rpx;
  background: rgba(230, 198, 120, 0.05);
  border: 2rpx solid rgba(230, 198, 120, 0.2);
  border-radius: 10rpx 10rpx 40rpx 40rpx;
  margin-bottom: 40rpx;
  position: relative;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 20rpx;
  color: #333;
}

/* 用户排名卡片 (悬浮) */
.user-rank-card {
  position: fixed;
  bottom: calc(146rpx + env(safe-area-inset-bottom));
  left: 24rpx; right: 24rpx;
  padding: 34rpx 44rpx;
  z-index: 100;
  border-radius: 30rpx;
  background: rgba(10, 10, 12, 0.9) !important;
  backdrop-filter: blur(40rpx) !important;
  border: 1rpx solid rgba(230, 198, 120, 0.3) !important;
  box-shadow: 0 -10rpx 40rpx rgba(0,0,0,0.8);
}

.user-rank-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  color: #FDFDFD;
  font-size: 28rpx;
  font-weight: 600;
}

.user-score {
  color: #E6C678;
  font-size: 22rpx;
}

.rank-text {
  font-size: 40rpx;
  font-weight: 900;
  color: #E6C678;
  font-style: italic;
  padding-left: 30rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.05);
}

.loading-container {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  color: #444;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}
