/* =========================================================
   Home Page - Royal Night Gold Specialist Styles
   ========================================================= */

page {
  background-color: #000;
  overflow: hidden;
}

.home-redesign {
  min-height: 100vh;
  position: relative;
  background-color: #000;
  overflow-x: hidden;
}

/* 0. 背景层优化 */
.hero-bg {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 70vh;
  z-index: 0;
}

.bg-image {
  width: 100%; height: 100%;
  filter: brightness(0.7) blur(4rpx);
}

.bg-vignette {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.9) 80%, #000 100%);
}

/* 1. 自定义沉浸式导航线 */
.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 88rpx;
  z-index: 100;
  background: rgba(8, 8, 8, 0.4);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: env(safe-area-inset-top);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.brand-small {
  font-size: 22rpx;
  color: #D4AF37;
  letter-spacing: 12rpx;
  font-weight: 300;
  opacity: 0.8;
}

/* 2. Hero 品牌区 */
.content-scroller {
  position: relative;
  z-index: 10;
  padding-top: calc(120rpx + env(safe-area-inset-top));
  height: 100vh;
  box-sizing: border-box;
}

.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding: 40rpx 0;
}

.brand-logo-container {
  position: relative;
}

.logo-text {
  font-size: 160rpx;
  font-weight: 900;
  color: #D4AF37;
  letter-spacing: 24rpx;
  background: linear-gradient(180deg, #D4AF37 0%, #B8860B 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
}

.logo-glow {
  position: absolute;
  top: 50%; left: 50%;
  width: 300rpx; height: 150rpx;
  background: rgba(212, 175, 55, 0.15);
  filter: blur(60rpx);
  transform: translate(-50%, -50%);
  z-index: -1;
}

.welcome-premium {
  text-align: center;
  margin-top: 20rpx;
}

.w-top {
  font-size: 20rpx;
  color: #888;
  letter-spacing: 16rpx;
  margin-bottom: 15rpx;
  display: block;
}

.w-divider {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(to right, transparent, #D4AF37, transparent);
  margin: 10rpx auto 20rpx;
}

.w-bottom {
  font-size: 34rpx;
  font-weight: 300;
  letter-spacing: 6rpx;
  color: #D4AF37;
  text-shadow: 0 0 10rpx rgba(212, 175, 55, 0.3);
}

/* 3. 公告/活动浮动栏 */
.floating-notices {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 50rpx;
}

.notice-pill {
  display: flex;
  align-items: center;
  padding: 24rpx 40rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(212, 175, 55, 0.15);
}

.pill-icon { font-size: 28rpx; margin-right: 20rpx; }
.pill-text { font-size: 24rpx; color: #BBB; flex: 1; }

/* 4. 尊享功能卡片 (2列布局) */
.action-grid {
  display: flex;
  justify-content: space-between;
  padding: 40rpx 40rpx;
  gap: 30rpx;
}

.lux-action-card {
  flex: 1;
  height: 320rpx; /* 改为纵向卡片 */
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 40rpx;
  padding: 40rpx 30rpx;
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(15rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.lux-action-card:active {
  transform: translateY(10rpx);
  background: rgba(212, 175, 55, 0.05);
}

.action-img {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
  filter: drop-shadow(0 0 15rpx rgba(212, 175, 55, 0.3));
}

.card-title {
  font-size: 32rpx;
  color: #FDFDFD;
  font-weight: 700;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.card-desc {
  font-size: 18rpx;
  color: #666;
  text-align: center;
  line-height: 1.4;
}

.card-accent {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 80rpx;
  height: 80rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
}

/* 弹窗升级 (首页专用) */
.luxury-modal-home {
  width: 620rpx;
  padding: 60rpx 50rpx;
  border-radius: 30rpx;
}

.modal-head-gold {
  color: #D4AF37;
  font-size: 40rpx;
  text-align: center;
  font-weight: 700;
  margin-bottom: 40rpx;
  letter-spacing: 4rpx;
}

.modal-body-lux {
  max-height: 500rpx;
  margin-bottom: 50rpx;
}

.modal-text-lux {
  color: #BBB;
  font-size: 28rpx;
  line-height: 1.8;
  display: block;
}

.modal-btn-lux {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
}

/* Animations */
@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-30rpx); }
  to { opacity: 1; transform: translateY(0); }
}
