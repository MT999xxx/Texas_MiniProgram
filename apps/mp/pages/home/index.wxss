/* pages/home/index.wxss */
page {
  background: #050506;
  overflow-x: hidden;
}

.home-page {
  min-height: 100vh;
  position: relative;
  overflow: visible;
  color: #F8F5EC;
}

.panther-hero {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
}

.hero-shade {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(5, 5, 6, 0.1) 0%, rgba(5, 5, 6, 0.25) 34%, rgba(5, 5, 6, 0.9) 78%, #050506 100%),
    radial-gradient(circle at 16% 15%, rgba(230, 198, 120, 0.16), transparent 32%),
    radial-gradient(circle at 82% 62%, rgba(157, 46, 69, 0.16), transparent 35%);
}

.hero-noise {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  opacity: 0.16;
  background-image: radial-gradient(rgba(255, 255, 255, 0.22) 1rpx, transparent 1rpx);
  background-size: 72rpx 72rpx;
}

.home-content {
  --setbar-tabbar-space: calc(154rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 3;
  min-height: 100vh;
  padding: calc(34rpx + env(safe-area-inset-top)) 34rpx calc(154rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.top-line {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.brand-mark {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #FFF3C8;
  text-shadow: 0 10rpx 34rpx rgba(230, 198, 120, 0.28);
}

.brand-sub {
  margin-top: 8rpx;
  font-size: 14rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.56);
}

.open-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(5, 5, 6, 0.42);
  border: 1rpx solid rgba(230, 198, 120, 0.18);
  color: rgba(255, 255, 255, 0.72);
  font-size: 16rpx;
  letter-spacing: 2rpx;
  backdrop-filter: blur(18rpx);
}

.open-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D64A3B;
  box-shadow: 0 0 20rpx rgba(214, 74, 59, 0.9);
}

.hero-copy {
  margin-top: auto;
  width: 520rpx;
}

.eyebrow {
  display: block;
  font-size: 18rpx;
  color: #E6C678;
  letter-spacing: 6rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 0;
  font-size: 58rpx;
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: 0;
  color: #F8F5EC;
  text-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.65);
}

.hero-desc {
  display: block;
  margin-top: 22rpx;
  width: 430rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(248, 245, 236, 0.7);
}

.primary-actions {
  margin-top: 42rpx;
  display: flex;
  gap: 18rpx;
}

.primary-action {
  flex: 1;
  min-height: 150rpx;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(26rpx);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.primary-action:active {
  transform: scale(0.98);
  opacity: 0.86;
}

.order-action {
  background: linear-gradient(135deg, rgba(255, 243, 200, 0.95), rgba(230, 198, 120, 0.82));
  color: #080706;
  box-shadow: 0 18rpx 42rpx rgba(230, 198, 120, 0.2);
}

.reserve-action {
  background: rgba(255, 255, 255, 0.075);
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  color: #F8F5EC;
}

.action-icon {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.order-action .action-icon {
  filter: brightness(0.25);
}

.action-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-title {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.1;
}

.action-sub {
  font-size: 18rpx;
  line-height: 1.35;
  opacity: 0.7;
}

.concierge-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.concierge-item {
  min-height: 112rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  backdrop-filter: blur(22rpx);
}

.concierge-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 22rpx;
  filter: drop-shadow(0 0 18rpx rgba(230, 198, 120, 0.26));
}

.concierge-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.concierge-title {
  font-size: 26rpx;
  font-weight: 750;
  color: #F8F5EC;
}

.concierge-sub {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.42);
}

.concierge-arrow {
  font-size: 48rpx;
  color: rgba(230, 198, 120, 0.8);
  line-height: 1;
}

.bottom-space {
  height: 0;
}

.luxury-modal-home {
  width: 620rpx;
  padding: 60rpx 50rpx;
  border-radius: 30rpx;
}

.modal-head-gold {
  color: #E6C678;
  font-size: 40rpx;
  text-align: center;
  font-weight: 700;
  margin-bottom: 40rpx;
  letter-spacing: 4rpx;
}

.modal-body-lux {
  max-height: 500rpx;
  margin-bottom: 50rpx;
}

.modal-text-lux {
  color: #BBB;
  font-size: 28rpx;
  line-height: 1.8;
  display: block;
}

.modal-btn-lux {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
}

.checkin-modal {
  width: 620rpx;
  padding: 50rpx 40rpx;
  border-radius: 30rpx;
  background: rgba(20, 18, 18, 0.98) !important;
  border: 1rpx solid rgba(230, 198, 120, 0.2) !important;
  position: relative;
}

.checkin-close {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 50rpx;
  height: 50rpx;
  font-size: 40rpx;
  color: #888;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.checkin-icon-img {
  width: 50rpx;
  height: 50rpx;
  margin-right: 18rpx;
}

.checkin-title {
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.checkin-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 40rpx;
}

.checkin-day {
  width: 130rpx;
  padding: 24rpx 10rpx;
  background: rgba(50, 48, 42, 0.6);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  transition: all 0.3s ease;
}

.checkin-day.today {
  border: 2rpx solid #E6C678;
  background: rgba(230, 198, 120, 0.1);
}

.checkin-day.claimed {
  background: rgba(230, 198, 120, 0.05);
}

.day-star {
  font-size: 40rpx;
  color: #555;
  margin-bottom: 10rpx;
}

.day-star.active,
.checkin-day.today .day-star {
  color: #E6C678;
  text-shadow: 0 0 10rpx rgba(230, 198, 120, 0.5);
}

.day-points {
  font-size: 22rpx;
  color: #E6C678;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.day-label {
  font-size: 20rpx;
  color: #888;
}

.checkin-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #FFF3C8 0%, #E6C678 100%) !important;
  color: #1a1a1a !important;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  letter-spacing: 4rpx;
}

.checkin-btn.disabled {
  background: rgba(100, 100, 100, 0.3) !important;
  color: #666 !important;
}
