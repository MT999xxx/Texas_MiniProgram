/* =========================================================
   Home Page - Royal Night Gold Specialist Styles
   ========================================================= */

page {
  background-color: #000;
  overflow: hidden;
}

.home-redesign {
  min-height: 100vh;
  position: relative;
  background-color: #000;
  overflow-x: hidden;
}

/* 0. 背景层极致优化 (纯 CSS 沉浸式) */
.home-redesign {
  background: #050505;
}

.hero-bg-lux {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  background: 
    radial-gradient(circle at 50% -20%, rgba(212, 175, 55, 0.15) 0%, transparent 60%),
    radial-gradient(circle at -10% 40%, rgba(212, 175, 55, 0.05) 0%, transparent 40%),
    radial-gradient(circle at 110% 60%, rgba(26, 21, 10, 0.8) 0%, #050505 100%);
  overflow: hidden;
}

/* 动态金粉粒子 */
.hero-bg-lux::before {
  content: "";
  position: absolute;
  top: -50%; left: -50%; width: 200%; height: 200%;
  background-image: radial-gradient(rgba(212, 175, 55, 0.15) 1rpx, transparent 1rpx);
  background-size: 80rpx 80rpx;
  opacity: 0.4;
  animation: floatParticles 60s linear infinite;
  mask-image: radial-gradient(circle at center, black, transparent 80%);
  -webkit-mask-image: radial-gradient(circle at center, black, transparent 80%);
}

@keyframes floatParticles {
  0% { transform: translate(0, 0) rotate(0deg); }
  100% { transform: translate(-5%, -5%) rotate(5deg); }
}

.hero-bg-lux::after {
  content: "";
  position: absolute;
  top: 15%; left: 50%;
  width: 140%; height: 600rpx;
  background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.05) 0%, transparent 70%);
  transform: translateX(-50%) rotate(-5deg);
  filter: blur(100rpx);
}

/* 1. 自定义沉浸式导航线 */
.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 88rpx;
  z-index: 100;
  background: rgba(8, 8, 8, 0.4);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: env(safe-area-inset-top);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.brand-small {
  font-size: 22rpx;
  color: #D4AF37;
  letter-spacing: 12rpx;
  font-weight: 300;
  opacity: 0.8;
}

/* 2. Hero 品牌区 */
.content-scroller {
  position: relative;
  z-index: 10;
  padding-top: calc(120rpx + env(safe-area-inset-top));
  height: 100vh;
  box-sizing: border-box;
}

.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding: 40rpx 0;
}

.brand-logo-container {
  position: relative;
}

.logo-text {
  font-size: 160rpx;
  font-weight: 900;
  color: #D4AF37;
  letter-spacing: 24rpx;
  background: linear-gradient(180deg, #F9E498 0%, #D4AF37 50%, #B8860B 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 10rpx 40rpx rgba(212, 175, 55, 0.3);
  display: block;
}

.brand-desc {
  font-size: 20rpx;
  color: #888;
  letter-spacing: 12rpx;
  margin-top: -20rpx;
  opacity: 0.6;
}

.logo-glow {
  position: absolute;
  top: 50%; left: 50%;
  width: 300rpx; height: 150rpx;
  background: rgba(212, 175, 55, 0.15);
  filter: blur(60rpx);
  transform: translate(-50%, -50%);
  z-index: -1;
}

.welcome-premium {
  text-align: center;
  margin-top: 40rpx;
  animation: fadeIn 1.5s ease;
}

.w-top {
  font-size: 22rpx;
  color: #666;
  letter-spacing: 20rpx;
  margin-bottom: 20rpx;
  display: block;
  font-weight: 300;
}

.w-divider {
  width: 100rpx;
  height: 1rpx;
  background: linear-gradient(to right, transparent, rgba(212, 175, 55, 0.5), transparent);
  margin: 15rpx auto 30rpx;
}

.w-bottom {
  font-size: 38rpx;
  font-weight: 400;
  letter-spacing: 8rpx;
  color: #D4AF37;
  text-shadow: 0 0 20rpx rgba(212, 175, 55, 0.4);
}

/* 3. 公告/活动浮动栏 */
.floating-notices {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 50rpx;
}

.notice-pill {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.02) !important;
  border: 1rpx solid rgba(212, 175, 55, 0.12) !important;
  position: relative;
  overflow: hidden;
}

.pill-icon { 
  font-size: 32rpx; 
  margin-right: 24rpx; 
  filter: drop-shadow(0 0 10rpx rgba(212, 175, 55, 0.5));
}

.pill-text { 
  font-size: 26rpx; 
  color: #999; 
  flex: 1; 
  letter-spacing: 2rpx;
}

/* 4. 尊享功能卡片 (2列布局) */
.action-grid {
  display: flex;
  justify-content: space-between;
  padding: 40rpx 40rpx;
  gap: 30rpx;
}

.lux-action-card {
  flex: 1;
  height: 320rpx; /* 改为纵向卡片 */
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 40rpx;
  padding: 40rpx 30rpx;
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(15rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.lux-action-card:active {
  transform: translateY(10rpx);
  background: rgba(212, 175, 55, 0.05);
}

.action-img {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
  filter: drop-shadow(0 0 15rpx rgba(212, 175, 55, 0.3));
}

/* CSS 纯享图标系统 */
.css-icon-container {
  width: 90rpx;
  height: 90rpx;
  margin-bottom: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.icon-shape-food {
  width: 50rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #F9E498, #D4AF37);
  border-radius: 40rpx 40rpx 4rpx 4rpx; /* 像一个餐盖 */
  position: relative;
}

.icon-shape-food::after {
  content: "";
  position: absolute;
  top: -8rpx; left: 50%;
  width: 12rpx; height: 12rpx;
  background: #D4AF37;
  border-radius: 50%;
  transform: translateX(-50%);
}

.icon-shape-table {
  width: 60rpx;
  height: 12rpx;
  background: linear-gradient(135deg, #F9E498, #D4AF37);
  border-radius: 4rpx;
  position: relative;
}

.icon-shape-table::before,
.icon-shape-table::after {
  content: "";
  position: absolute;
  top: 12rpx;
  width: 6rpx; height: 24rpx;
  background: #D4AF37;
}

.icon-shape-table::before { left: 8rpx; }
.icon-shape-table::after { right: 8rpx; }

.card-title {
  font-size: 32rpx;
  color: #FDFDFD;
  font-weight: 700;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.card-desc-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-desc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  line-height: 1.6;
}

.card-accent {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 100rpx;
  height: 100rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.12) 0%, transparent 70%);
}

/* 弹窗升级 (首页专用) */
.luxury-modal-home {
  width: 620rpx;
  padding: 60rpx 50rpx;
  border-radius: 30rpx;
}

.modal-head-gold {
  color: #D4AF37;
  font-size: 40rpx;
  text-align: center;
  font-weight: 700;
  margin-bottom: 40rpx;
  letter-spacing: 4rpx;
}

.modal-body-lux {
  max-height: 500rpx;
  margin-bottom: 50rpx;
}

.modal-text-lux {
  color: #BBB;
  font-size: 28rpx;
  line-height: 1.8;
  display: block;
}

.modal-btn-lux {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
}

/* Animations */
@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-30rpx); }
  to { opacity: 1; transform: translateY(0); }
}
