<view class="container">
  <image class="bg-image" src="{{bgUrl}}" mode="aspectFill" />
  
  <view class="bg-overlay"></view>

  <view class="header-area">
    <view class="store-info" bindtap="showNotice">
      <text class="store-name">公告专区 ></text>
    </view>
    <view class="notice-btn" bindtap="showActivity">
      <text>活动专区</text>
    </view>
  </view>

  <view class="center-area">
    <text class="brand-title">AAA</text>
    
    <view class="welcome-box">
      <text class="welcome-text">欢迎来到三条A</text>
    </view>
  </view>

  <view class="bottom-panel">
    <view class="action-item" bindtap="goToMenu">
      <image class="action-icon" src="/images/diancan2.png" mode="aspectFit" />
      <text class="action-title">点餐</text>
    </view>

    <view class="action-item" bindtap="goToReservation">
      <image class="action-icon" src="/images/yuyue2.png" mode="aspectFit" />
      <text class="action-title">预约</text>
    </view>
  </view>

  <tab-bar selected="0"></tab-bar>

  <!-- 自定义黑金弹窗 -->
  <view class="custom-modal" wx:if="{{modalVisible}}">
    <view class="modal-mask" bindtap="closeModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">{{modalTitle}}</text>
      </view>
      <scroll-view scroll-y class="modal-body">
        <text class="modal-text">{{modalContent}}</text>
      </scroll-view>
      <view class="modal-footer">
        <view class="modal-btn" bindtap="closeModal">朕知道了</view>
      </view>
    </view>
  </view>
</view>