<view class="container redesign-bg">
  <!-- 1. 奢华页头 -->
  <view class="header-lux glass-panel shadow-lux">
    <view class="title-group">
      <text class="en-title">TRANSACTIONS</text>
      <text class="cn-title text-gold-gradient">充值记录</text>
    </view>
    <view class="recharge-trigger gold-border" bindtap="goToRecharge">
      继续充值
    </view>
  </view>

  <!-- 2. 交互列表 -->
  <view class="list-lux">
    <scroll-view
      scroll-y
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="loadRechargeHistory"
      class="scroll-lux"
    >
      <view 
        wx:for="{{rechargeHistory}}" 
        wx:key="id" 
        class="record-lux glass-panel gold-border"
        bindtap="viewRechargeDetail"
        data-id="{{item.id}}"
      >
        <!-- 交易头部 -->
        <view class="rec-header">
          <view class="info-main">
            <text class="p-name">{{item.package.name}}</text>
            <text class="p-time">{{item.timeText}}</text>
          </view>
          <view class="status-box">
            <view class="badge status-{{item.status}}">
              {{item.statusText}}
            </view>
          </view>
        </view>

        <!-- 财务摘要 -->
        <view class="financial-summary">
          <view class="fin-item">
            <text class="l">支付金额</text>
            <view class="v-box">
              <text class="cur">¥</text>
              <text class="val">{{item.amount}}</text>
            </view>
          </view>
          <view class="fin-item">
            <text class="l">到账积分</text>
            <view class="v-box gold-v">
              <text class="val">{{item.points + (item.bonusPoints || 0)}}</text>
            </view>
          </view>
        </view>

        <!-- 详情动效入口 -->
        <view class="rec-footer">
          <view class="footer-line"></view>
          <view class="detail-link">
            <text>查看收据详情</text>
            <view class="css-arrow-right"></view>
          </view>
        </view>
      </view>

      <!-- 空白境地 -->
      <view wx:if="{{rechargeHistory.length === 0 && !loading}}" class="empty-lux-box">
        <view class="css-icon-vault-empty"></view>
        <text class="empty-text">尚无资金注入记录</text>
        <button class="btn-primary-lux shimmer-effect" bindtap="goToRecharge">立即充值</button>
      </view>

      <!-- 加载波纹 -->
      <view wx:if="{{loading}}" class="loading-more-lux">
        <view class="loading-dot"></view>
        <text>同步中...</text>
      </view>

      <!-- 终章 -->
      <view wx:if="{{!hasMore && rechargeHistory.length > 0}}" class="no-more-lux">
        <text>已呈报全部历史记录</text>
      </view>
    </scroll-view>
  </view>
</view>