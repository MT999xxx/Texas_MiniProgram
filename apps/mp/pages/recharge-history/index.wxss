/* Pages/recharge-history/index.wxss */
page {
  background-color: #080808;
}

.container {
  min-height: 100vh;
}

/* 1. 奢华页头 */
.header-lux {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 50rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  background: rgba(8, 8, 8, 0.9);
  backdrop-filter: blur(20rpx);
}

.title-group {
  display: flex;
  flex-direction: column;
}

.en-title {
  font-size: 16rpx;
  color: #222;
  letter-spacing: 4rpx;
  font-weight: 800;
}

.cn-title {
  font-size: 34rpx;
  font-weight: 800;
}

.recharge-trigger {
  font-size: 22rpx;
  color: #D4AF37;
  padding: 12rpx 30rpx;
  border-radius: 40rpx;
  font-weight: 600;
}

/* 2. 列表区域 */
.list-lux {
  padding: 30rpx;
}

.scroll-lux {
  height: calc(100vh - 160rpx);
}

.record-lux {
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.rec-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.p-name {
  font-size: 32rpx;
  color: #EEE;
  font-weight: 700;
  display: block;
  margin-bottom: 10rpx;
}

.p-time {
  font-size: 20rpx;
  color: #333;
}

.badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 6rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.status-SUCCESS { 
  color: #FFF; 
  background: linear-gradient(135deg, #22C55E 0%, #15803D 100%); 
}

.status-PENDING { 
  color: #000; 
  background: linear-gradient(135deg, #F9E498 0%, #D4AF37 100%); 
  box-shadow: 0 4rpx 10rpx rgba(212, 175, 55, 0.2);
}

.status-FAILED { 
  color: #FFF; 
  background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%); 
}

/* 财务摘要 */
.financial-summary {
  display: flex;
  gap: 60rpx;
  margin-bottom: 40rpx;
}

.fin-item .l {
  font-size: 18rpx;
  color: #222;
  display: block;
  margin-bottom: 12rpx;
}

.v-box {
  display: flex;
  align-items: baseline;
}

.v-box .cur { font-size: 18rpx; color: #444; margin-right: 4rpx; }
.v-box .val { font-size: 36rpx; color: #DDD; font-weight: 700; }

.gold-v .val { color: #D4AF37; }

/* 详情链接 */
.rec-footer {
  margin-top: 20rpx;
}

.footer-line {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.03);
  margin-bottom: 24rpx;
}

.detail-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-link text {
  font-size: 20rpx;
  color: #333;
}

.css-arrow-right {
  width: 12rpx; height: 12rpx;
  border-top: 2rpx solid #333;
  border-right: 2rpx solid #333;
  transform: rotate(45deg);
}

/* 空状态 */
.empty-lux-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 0;
}

.css-icon-vault-empty {
  width: 100rpx;
  height: 120rpx;
  background: rgba(212, 175, 55, 0.02);
  border: 1rpx solid rgba(212, 175, 55, 0.1);
  border-radius: 10rpx;
  margin-bottom: 50rpx;
  position: relative;
  overflow: hidden;
}

.css-icon-vault-empty::before {
  content: "";
  position: absolute;
  top: 30rpx; left: 20rpx; right: 20rpx;
  height: 2rpx;
  background: rgba(212, 175, 55, 0.1);
  box-shadow: 0 20rpx 0 rgba(212, 175, 55, 0.08), 0 40rpx 0 rgba(212, 175, 55, 0.05);
}

.css-icon-vault-empty::after {
  content: "";
  position: absolute;
  top: -20rpx; right: -20rpx;
  width: 60rpx; height: 60rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
}

.empty-text {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 60rpx;
  letter-spacing: 4rpx;
}

.btn-primary-lux {
  background: linear-gradient(135deg, #D4AF37, #B8860B);
  color: #000;
  font-size: 26rpx;
  font-weight: 700;
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
  line-height: 1;
}

/* 加载波纹 */
.loading-more-lux {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx;
}

.loading-dot {
  width: 10rpx; height: 10rpx;
  background: #D4AF37;
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}
@keyframes pulse { 0%, 100% { opacity: 0.2; } 50% { opacity: 1; } }

.loading-more-lux text {
  font-size: 20rpx;
  color: #333;
}

.no-more-lux {
  text-align: center;
  padding: 60rpx;
  font-size: 18rpx;
  color: #222;
  letter-spacing: 2rpx;
}