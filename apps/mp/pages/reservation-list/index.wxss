/* Pages/reservation-list/index.wxss */
page {
  background-color: #080808;
}

.container {
  min-height: 100vh;
}

/* 标签页 (极简极致) */
.tabs {
  display: flex;
  background: rgba(8, 8, 8, 0.82);
  backdrop-filter: blur(20rpx);
  padding: 0 40rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 34rpx 0;
  position: relative;
}

.tab-text {
  font-size: 26rpx;
  color: #444;
  letter-spacing: 2rpx;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #D4AF37;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 2rpx;
  background: #D4AF37;
  box-shadow: 0 0 10rpx #D4AF37;
}

/* 列表容器 */
.list-container {
  padding: 30rpx;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.css-icon-calendar {
  width: 70rpx;
  height: 80rpx;
  border: 4rpx solid rgba(212, 175, 55, 0.1);
  border-radius: 12rpx;
  margin-bottom: 40rpx;
  position: relative;
}

.css-icon-calendar::after {
  content: "";
  position: absolute;
  top: 10rpx; left: 0; right: 0;
  height: 4rpx;
  background: rgba(212, 175, 55, 0.1);
}

.empty-text {
  color: #333;
  font-size: 26rpx;
  margin-bottom: 60rpx;
  letter-spacing: 4rpx;
}

.btn-goto-reserve {
  background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
  color: #000;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  box-shadow: 0 10rpx 20rpx rgba(212, 175, 55, 0.15);
}

/* 预约项 */
.reservation-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.reservation-item {
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

/* 状态标签 */
.status-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 10rpx 30rpx;
  border-radius: 0 0 0 24rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.status-PENDING { background: rgba(212, 175, 55, 0.1); color: #D4AF37; }
.status-CONFIRMED { background: rgba(34, 197, 94, 0.1); color: #22C55E; }
.status-IN_USE { background: rgba(212, 175, 55, 0.2); color: #F9E498; }
.status-CHECKED_IN { background: rgba(59, 130, 246, 0.1); color: #3B82F6; }
.status-CANCELLED { background: rgba(51, 51, 51, 0.1); color: #444; }

/* 预约内容 */
.reservation-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
}

.info-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #222;
  margin-right: 20rpx;
}

.info-row .label {
  font-size: 22rpx;
  color: #444;
  margin-right: 20rpx;
  min-width: 100rpx;
}

.info-row .value {
  font-size: 26rpx;
  color: #BBB;
  font-weight: 500;
}

.capacity-lux, .phone-lux {
  font-size: 20rpx;
  color: #444;
  margin-left: 16rpx;
}

.note-box {
  margin-top: 10rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.02);
}

.note-text {
  color: #D4AF37 !important;
  opacity: 0.8;
}

/* 底部操作区 */
.item-footer {
  margin-top: 34rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.created-time {
  font-size: 18rpx;
  color: #333;
}

.btn-cancel-lux {
  font-size: 22rpx;
  color: #555;
  padding: 10rpx 24rpx;
  border: 1rpx solid #222;
  border-radius: 30rpx;
}

.btn-cancel-lux:active {
  background: rgba(255, 255, 255, 0.02);
  color: #888;
}

.loading-box { text-align: center; padding: 60rpx 0; }
.loading-text { color: #222; font-size: 22rpx; letter-spacing: 4rpx; }