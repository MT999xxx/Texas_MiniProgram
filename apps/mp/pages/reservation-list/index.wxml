<view class="container redesign-bg">
  <!-- 1. 顶部标签页 (极简设计) -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="status"
      class="tab-item {{currentTab === item.status ? 'active' : ''}}"
      bindtap="switchTab"
      data-status="{{item.status}}"
    >
      <text class="tab-text">{{item.label}}</text>
      <view wx:if="{{currentTab === item.status}}" class="tab-indicator"></view>
    </view>
  </view>

  <!-- 2. 预约列表区域 -->
  <view class="list-container">
    <!-- Loading状态 (骨架屏) -->
    <view class="skeleton-list" wx:if="{{loading}}">
      <block wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="reservation-item glass-panel gold-border shadow-lux" style="border: none;">
          <skeleton shape="line" customStyle="width: 40%; margin-bottom: 30rpx; height: 40rpx;" />
          <skeleton shape="line" customStyle="width: 80%; margin-bottom: 20rpx;" />
          <skeleton shape="line" customStyle="width: 60%; margin-bottom: 20rpx;" />
          <skeleton shape="line" customStyle="width: 70%;" />
        </view>
      </block>
    </view>

    <!-- 空数据提示 (图形化) -->
    <empty 
      wx:elif="{{reservations.length === 0}}"
      type="box"
      text="尚无名仕预约"
      description="您还没有任何预约记录，点击下方按钮即刻开启专享体验"
    >
      <button class="btn-goto-reserve shimmer-effect" bindtap="gotoReserve" style="margin-top: 40rpx;">即刻预定</button>
    </empty>

    <view wx:else class="reservation-list">
      <view
        wx:for="{{reservations}}"
        wx:key="id"
        class="reservation-item glass-panel gold-border shadow-lux"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <!-- 状态标签 (极简发光) -->
        <view class="status-badge status-{{item.status}}">
          {{item.statusText}}
        </view>

        <!-- 预约内容 -->
        <view class="reservation-content">
          <view class="info-row">
            <view class="info-dot"></view>
            <text class="label">预约时间</text>
            <text class="value text-gold-gradient">{{item.reservedAtText}}</text>
          </view>

          <view class="info-row">
            <view class="info-dot"></view>
            <text class="label">尊享桌台</text>
            <text class="value">{{item.table.name}}</text>
            <text class="capacity-lux">{{item.table.capacity}}人座</text>
          </view>

          <view class="info-row">
            <view class="info-dot"></view>
            <text class="label">就餐人数</text>
            <text class="value">{{item.partySize}} 人</text>
          </view>

          <view class="info-row">
            <view class="info-dot"></view>
            <text class="label">预留贵宾</text>
            <text class="value">{{item.customerName}}</text>
            <text class="phone-lux">{{item.phone}}</text>
          </view>

          <view wx:if="{{item.note}}" class="info-row note-box">
            <text class="label">名仕备注:</text>
            <text class="value note-text">{{item.note}}</text>
          </view>
        </view>

        <!-- 底部操作区 -->
        <view class="item-footer">
          <text class="created-time">预约于 {{item.createdAtText}}</text>
          <view class="action-buttons" wx:if="{{item.status === 'PENDING' || item.status === 'CONFIRMED' || item.status === 'IN_USE'}}">
            <view
              class="btn-cancel-lux"
              catchtap="cancelReservation"
              data-id="{{item.id}}"
            >
              取消预约
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
