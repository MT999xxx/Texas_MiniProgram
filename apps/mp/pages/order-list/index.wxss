/* Pages/order-list/index.wxss */
page {
  background-color: #080808;
}

.container {
  min-height: 100vh;
}

/* 标签页 (同极简规范) */
.tabs {
  display: flex;
  background: rgba(8, 8, 8, 0.85);
  backdrop-filter: blur(20rpx);
  padding: 0 40rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 34rpx 0;
  position: relative;
}

.tab-text {
  font-size: 26rpx;
  color: #444;
  letter-spacing: 2rpx;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #D4AF37;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 2rpx;
  background: #D4AF37;
  box-shadow: 0 0 10rpx #D4AF37;
}

/* 列表容器 */
.list-container {
  padding: 30rpx;
}

/* 加载盒子 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.loading-text { font-size: 22rpx; color: #222; letter-spacing: 4rpx; }

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 0;
}

.css-icon-order-empty {
  width: 100rpx;
  height: 120rpx;
  background: rgba(212, 175, 55, 0.02);
  border: 1rpx solid rgba(212, 175, 55, 0.1);
  border-radius: 10rpx;
  margin-bottom: 50rpx;
  position: relative;
  overflow: hidden;
}

.css-icon-order-empty::before {
  content: "";
  position: absolute;
  top: 30rpx; left: 20rpx; right: 20rpx;
  height: 2rpx;
  background: rgba(212, 175, 55, 0.1);
  box-shadow: 0 20rpx 0 rgba(212, 175, 55, 0.08), 0 40rpx 0 rgba(212, 175, 55, 0.05);
}

.css-icon-order-empty::after {
  content: "";
  position: absolute;
  top: -20rpx; right: -20rpx;
  width: 60rpx; height: 60rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
}

.empty-text {
  color: #333;
  font-size: 26rpx;
  margin-bottom: 60rpx;
  letter-spacing: 4rpx;
}

.btn-goto-menu {
  background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
  color: #000;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* 订单卡片 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.order-item {
  padding: 40rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-id-box {
  display: flex;
  align-items: baseline;
}

.order-label {
  font-size: 18rpx;
  color: #444;
  font-weight: 800;
  margin-right: 8rpx;
}

.order-sn {
  font-size: 28rpx;
  color: #EEE;
  font-family: "Courier New", Courier, monospace;
}

.status-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 6rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.status-PENDING { 
  color: #000;
  background: linear-gradient(135deg, #F9E498 0%, #D4AF37 100%);
  box-shadow: 0 4rpx 10rpx rgba(212, 175, 55, 0.2);
}

.status-PAID, .status-SUCCESS { 
  color: #FFF;
  background: linear-gradient(135deg, #22C55E 0%, #15803D 100%);
}

.status-IN_PROGRESS { 
  color: #FFF;
  background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);
}

.status-COMPLETED { 
  color: #BBB;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.status-CANCELLED { 
  color: #666;
  background: rgba(255, 255, 255, 0.02);
}

.order-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.order-time {
  font-size: 20rpx;
  color: #555;
}

.location-badge {
  display: flex;
  align-items: center;
}

.loc-dot {
  width: 8rpx; height: 8rpx;
  background: #D4AF37;
  border-radius: 50%;
  margin-right: 12rpx;
}

.loc-name {
  font-size: 22rpx;
  color: #888;
}

/* 商品预览区 */
.items-preview {
  background: rgba(255, 255, 255, 0.01);
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.03);
  margin-bottom: 24rpx;
}

.preview-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.p-name {
  font-size: 26rpx;
  color: #BBB;
  flex: 1;
}

.p-spec {
  font-size: 22rpx;
  color: #555;
}

.p-count {
  font-size: 24rpx;
  color: #888;
  margin-left: 30rpx;
}

.more-items {
  text-align: center;
  color: #222;
  font-size: 20rpx;
  line-height: 1;
}

/* 汇总区 */
.order-summary {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.sum-count {
  font-size: 22rpx;
  color: #444;
}

.sum-price {
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 20rpx;
  color: #D4AF37;
  margin-right: 4rpx;
}

.amount {
  font-size: 38rpx;
  font-weight: 800;
}

/* 底部操作 */
.action-footer {
  margin-top: 30rpx;
}

.footer-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.05);
  margin-bottom: 30rpx;
}

.btn-group-lux {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.btn-cancel-lux {
  font-size: 24rpx;
  color: #555;
  padding: 16rpx 40rpx;
  border: 1rpx solid #222;
  border-radius: 40rpx;
}

.btn-pay-lux {
  font-size: 24rpx;
  color: #000;
  background: #D4AF37;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-weight: 700;
}

.btn-reorder-lux {
  font-size: 24rpx;
  color: #DDD;
  padding: 16rpx 40rpx;
  border: 1rpx solid #333;
  border-radius: 40rpx;
}