<view class="container redesign-bg">
  <!-- 1. 顶部标签页 (极简设计) -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="status"
      class="tab-item {{currentTab === item.status ? 'active' : ''}}"
      bindtap="switchTab"
      data-status="{{item.status}}"
    >
      <text class="tab-text">{{item.label}}</text>
      <view wx:if="{{currentTab === item.status}}" class="tab-indicator"></view>
    </view>
  </view>

  <!-- 2. 订单列表区域 -->
  <view class="list-container">
    <!-- Loading状态 (骨架屏) -->
    <view class="skeleton-list" wx:if="{{loading}}">
      <block wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="order-item glass-panel gold-border shadow-lux" style="border: none;">
          <view class="order-header" style="border: none; margin-bottom: 20rpx;">
            <skeleton shape="line" customStyle="width: 30%; height: 40rpx;" />
            <skeleton shape="line" customStyle="width: 20%; height: 40rpx;" />
          </view>
          <skeleton shape="line" customStyle="width: 60%; margin-bottom: 20rpx;" />
          <skeleton shape="line" customStyle="width: 80%; margin-bottom: 20rpx;" />
          <skeleton shape="line" customStyle="width: 40%;" />
        </view>
      </block>
    </view>

    <!-- 空数据提示 (图形化) -->
    <empty 
      wx:elif="{{orders.length === 0}}"
      type="box"
      text="尚无点餐记录"
      description="您还没有任何消费记录，快去浏览我们的精致珍馐吧"
    >
      <button class="btn-goto-menu shimmer-effect" bindtap="gotoMenu" style="margin-top: 40rpx;">浏览珍馐</button>
    </empty>

    <view wx:else class="order-list">
      <view
        wx:for="{{orders}}"
        wx:key="id"
        class="order-item glass-panel gold-border shadow-lux"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <!-- 订单头部 -->
        <view class="order-header">
          <view class="order-id-box">
            <text class="order-label">订单号</text>
            <text class="order-sn">{{item.orderNumber}}</text>
          </view>
          <view class="status-badge status-{{item.status}}">
            {{item.statusText}}
          </view>
        </view>

        <!-- 副标题 & 时间 -->
        <view class="order-meta">
          <text class="order-time">{{item.createdAtText}}</text>
          <view wx:if="{{item.table}}" class="location-badge">
            <view class="loc-dot"></view>
            <text class="loc-name">{{item.table.name}}</text>
          </view>
        </view>

        <!-- 商品简述 -->
        <view class="items-preview">
          <view
            wx:for="{{item.items}}"
            wx:for-item="product"
            wx:key="id"
            wx:if="{{index < 3}}"
            class="preview-row"
          >
            <text class="p-name">{{product.menuItem.name}}</text>
            <text class="p-spec" wx:if="{{product.spec}}"> / {{product.spec}}</text>
            <text class="p-count">×{{product.quantity}}</text>
          </view>
          <view wx:if="{{item.items.length > 3}}" class="more-items">...</view>
        </view>

        <!-- 汇总区域 -->
        <view class="order-summary">
          <text class="sum-count">共 {{item.totalQuantity}} 件商品</text>
          <view class="sum-price">
            <text class="currency">¥</text>
            <text class="amount text-gold-gradient">{{item.totalAmount}}</text>
          </view>
        </view>

        <!-- 操作区 (仅在需要时显示) -->
        <view class="action-footer" wx:if="{{item.status === 'PENDING' || item.status === 'COMPLETED'}}">
          <view class="footer-divider"></view>
          <view class="btn-group-lux">
            <view wx:if="{{item.status === 'PENDING'}}" class="btn-cancel-lux" catchtap="cancelOrder" data-id="{{item.id}}">取消</view>
            <view wx:if="{{item.status === 'PENDING'}}" class="btn-pay-lux shimmer-effect" catchtap="payOrder" data-id="{{item.id}}">立即结算</view>
            <view wx:if="{{item.status === 'COMPLETED'}}" class="btn-reorder-lux" catchtap="reorder" data-id="{{item.id}}">再来一单</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
