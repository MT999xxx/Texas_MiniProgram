<view class="container redesign-bg">
  <view class="hero-bg-lux-member"></view>

  <view class="nav-header">
    <view class="back-btn" bindtap="goBack"><text class="back-icon">‹</text></view>
    <text class="nav-title">会员等级</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="level-overview">
    <text class="brand-mark">Set baR</text>
    <text class="overview-title">尊享等级</text>
    <view class="overview-data">
      <text>当前 V{{actualLevel}}</text>
    </view>
  </view>

  <swiper
    class="level-swiper"
    current="{{currentLevel}}"
    bindchange="onSwiperChange"
    previous-margin="48rpx"
    next-margin="48rpx"
  >
    <swiper-item wx:for="{{memberLevels}}" wx:key="code">
      <view class="level-card" style="--level-accent: {{item.accent}};">
        <image class="level-badge" src="{{item.icon}}" mode="aspectFill"></image>
        <view class="level-copy">
          <view class="level-heading">
            <text class="level-code">{{item.code}}</text>
            <text class="level-name">{{item.name}}</text>
          </view>
          <text class="level-status">{{item.status}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <scroll-view class="level-indicators" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="indicator-row">
      <view
        wx:for="{{memberLevels}}"
        wx:key="code"
        class="indicator {{currentLevel === index ? 'active' : ''}}"
        bindtap="onIndicatorTap"
        data-index="{{index}}"
      >{{item.code}}</view>
    </view>
  </scroll-view>

  <view class="benefits-section">
    <view class="benefit-header">
      <text class="benefit-kicker">升级奖励</text>
      <text class="benefit-level">{{memberLevels[currentLevel].code}}</text>
    </view>
    <text class="benefit-name">{{memberLevels[currentLevel].name}}</text>
    <text class="benefit-detail">{{memberLevels[currentLevel].reward}}</text>
    <view class="benefit-note">
      达到对应等级后生成待发奖励，由管理员确认后到账；跨级时逐级累计生成。
    </view>
  </view>

  <view class="recharge-action">
    <button class="btn-primary recharge-btn" bindtap="goRecharge">前往充值</button>
  </view>
  <view class="safe-bottom"></view>
</view>
