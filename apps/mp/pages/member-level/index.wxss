.container {
  min-height: 100vh;
  color: #f6f2ea;
  padding-bottom: env(safe-area-inset-bottom);
}

.nav-header {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(var(--safe-area-top, 44px) + 18rpx) 30rpx 18rpx;
}

.back-btn,
.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(230, 198, 120, 0.28);
  border-radius: 50%;
  background: rgba(11, 10, 10, 0.72);
}

.back-icon {
  color: #e6c678;
  font-size: 44rpx;
  line-height: 1;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
}

.level-overview {
  position: relative;
  z-index: 2;
  padding: 36rpx 42rpx 18rpx;
}

.brand-mark {
  display: block;
  color: #d45546;
  font-size: 22rpx;
  font-weight: 700;
}

.overview-title {
  display: block;
  margin-top: 8rpx;
  font-size: 54rpx;
  font-weight: 700;
}

.overview-data {
  display: flex;
  gap: 28rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.52);
  font-size: 22rpx;
}

.level-swiper {
  height: 420rpx;
  margin-top: 14rpx;
}

.level-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 28rpx;
  height: 338rpx;
  margin: 18rpx 10rpx;
  padding: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(230, 198, 120, 0.26);
  border-radius: 12rpx;
  background: #11100f;
  box-shadow: 0 22rpx 54rpx rgba(0, 0, 0, 0.38);
}

.level-card::after {
  position: absolute;
  right: -90rpx;
  bottom: -130rpx;
  width: 300rpx;
  height: 300rpx;
  border: 1rpx solid var(--level-accent);
  border-radius: 50%;
  opacity: 0.16;
  content: '';
}

.level-badge {
  width: 218rpx;
  height: 240rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #050505;
}

.level-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.level-heading {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex-wrap: wrap;
}

.level-code {
  color: var(--level-accent);
  font-size: 50rpx;
  font-weight: 800;
}

.level-name {
  font-size: 32rpx;
  font-weight: 700;
}

.level-status {
  display: block;
}

.level-status {
  display: inline-flex;
  margin-top: 20rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--level-accent);
  border-radius: 999rpx;
  color: var(--level-accent);
  font-size: 20rpx;
}

.level-indicators {
  width: 100%;
  white-space: nowrap;
}

.indicator-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 36rpx 20rpx;
}

.indicator {
  min-width: 66rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.38);
  text-align: center;
  font-size: 20rpx;
}

.indicator.active {
  border-color: #e6c678;
  background: rgba(230, 198, 120, 0.12);
  color: #f2d98e;
}

.benefits-section {
  margin: 22rpx 36rpx 0;
  padding: 34rpx;
  border: 1rpx solid rgba(230, 198, 120, 0.22);
  border-radius: 8rpx;
  background: rgba(17, 16, 15, 0.92);
}

.benefit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.benefit-kicker,
.benefit-level {
  color: #e6c678;
  font-size: 22rpx;
}

.benefit-level {
  font-weight: 700;
}

.benefit-name {
  display: block;
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.benefit-detail {
  display: block;
  margin-top: 16rpx;
  color: #f2d98e;
  font-size: 27rpx;
  line-height: 1.55;
}

.benefit-note {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.42);
  font-size: 21rpx;
  line-height: 1.65;
}

.recharge-action {
  padding: 30rpx 36rpx 0;
}

.recharge-btn {
  width: 100%;
  height: 92rpx;
  border: none;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #f1d88a 0%, #b88b3c 100%);
  color: #17120b;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.recharge-btn::after {
  border: none;
}

.safe-bottom {
  height: 40rpx;
}
