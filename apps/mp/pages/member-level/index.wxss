/* 会员等级权益页面样式 */

/* 导航栏 */
.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-top: calc(var(--safe-area-top, 44px) + 20rpx);
  position: relative;
  z-index: 10;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  backdrop-filter: blur(10px);
}

.back-icon {
  font-size: 40rpx;
  color: var(--gold-500, #E6C678);
  font-weight: bold;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--gold-500, #E6C678);
}

.nav-placeholder {
  width: 60rpx;
}

/* 等级卡片轮播 */
.level-swiper {
  height: 400rpx;
  margin-top: 20rpx;
}

.level-card {
  margin: 0 10rpx;
  height: 320rpx;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
  position: relative;
  overflow: hidden;
  color: #fff;
}

/* 深色文字模式 (用于浅色背景卡片) */
.level-card.dark-text {
  color: #2c3e50;
}

.level-card.dark-text .rule-link,
.level-card.dark-text .progress-text {
  color: rgba(44, 62, 80, 0.6);
}

.level-card.dark-text .status-tag {
  color: rgba(44, 62, 80, 0.8);
}

/* 背景大V盾牌 */
.v-shield-bg {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 240rpx;
  height: 240rpx;
  opacity: 0.15;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(15deg);
}

.v-shield-text {
  font-size: 200rpx;
  font-weight: 900;
  font-family: 'Inter', sans-serif;
  line-height: 1;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  z-index: 2;
}

.level-v-mark {
  font-size: 64rpx;
  font-weight: 900;
  font-style: italic;
  font-family: 'Inter', sans-serif;
  opacity: 0.4;
  display: flex;
  align-items: baseline;
}

.level-v-mark .v-num {
  font-size: 56rpx;
  margin-left: -10rpx;
}

.level-name {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  position: relative;
  z-index: 2;
}

.status-info {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.status-tag {
  opacity: 0.8;
}

.progress-text {
  opacity: 0.6;
}

.rule-link {
  font-size: 22rpx;
  opacity: 0.6;
}


/* 等级指示器 */
.level-indicators {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 30rpx;
}

.indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.indicator.active {
  width: 40rpx;
  border-radius: 8rpx;
}

/* 福利区域 */
.benefits-section {
  margin: 40rpx 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  background: rgba(30, 20, 10, 0.85);
}

.section-title {
  margin-bottom: 30rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gold-500, #E6C678);
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30rpx 20rpx;
}

.benefits-empty {
  min-height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.42);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.benefit-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(230, 198, 120, 0.15);
  border-radius: 16rpx;
  font-size: 36rpx;
}

.benefit-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  line-height: 1.3;
}

/* 充值按钮 */
.recharge-action {
  padding: 30rpx;
  margin-top: 20rpx;
}

.recharge-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #E6C678 0%, #8C6A2F 100%);
  color: #1a1a1a;
  border: none;
  box-shadow: 0 10rpx 30rpx rgba(230, 198, 120, 0.3);
}

.recharge-btn::after {
  border: none;
}
