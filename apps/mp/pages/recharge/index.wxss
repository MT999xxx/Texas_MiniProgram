/* Pages/recharge/index.wxss */
page {
  background-color: #050506;
}

.container {
  min-height: 100vh;
  padding: 40rpx 30rpx;
  position: relative;
  z-index: 10;
}

/* 0. 沉浸式背景 (同步全站极致规范) */
.hero-bg-lux-recharge {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  background:
    radial-gradient(circle at 100% 100%, rgba(230, 198, 120, 0.05) 0%, transparent 40%),
    radial-gradient(circle at -20% -20%, rgba(26, 21, 10, 0.5) 0%, #050506 100%);
}

/* 1. 账户英雄位 */
.account-hero {
  padding: 60rpx 50rpx;
  margin-bottom: 60rpx;
  position: relative;
  overflow: hidden;
}

.account-hero::before {
  content: "";
  position: absolute;
  top: -20%; right: -10%;
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, rgba(230, 198, 120, 0.1) 0%, transparent 70%);
}

.user-main {
  display: flex;
  align-items: center;
  margin-bottom: 50rpx;
}

.avatar-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  padding: 4rpx;
  margin-right: 30rpx;
}

.avatar {
  width: 100%; height: 100%;
  border-radius: 50%;
}

.nickname {
  font-size: 34rpx;
  color: #EEE;
  font-weight: 800;
  display: block;
}

.membership-tag {
  font-size: 16rpx;
  color: #E6C678;
  letter-spacing: 4rpx;
  font-weight: 700;
}

.balance-display {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.balance-item .label {
  font-size: 20rpx;
  color: #444;
  margin-bottom: 10rpx;
  display: block;
}

.balance-item .value {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
  color: #E6C678;
  text-shadow: 0 0 40rpx rgba(230, 198, 120, 0.4);
  font-family: 'SF Pro Display', sans-serif;
}

.history-trigger {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.css-icon-history {
  width: 30rpx; height: 30rpx;
  border: 2rpx solid #333;
  border-radius: 50%;
  position: relative;
}
.css-icon-history::after {
  content: "";
  position: absolute;
  top: 6rpx; left: 13rpx;
  width: 2rpx; height: 10rpx;
  background: #333;
  transform-origin: bottom;
  box-shadow: 4rpx -2rpx 0 #333; /* 模拟分针 */
}

.history-trigger text {
  font-size: 18rpx;
  color: #333;
  letter-spacing: 2rpx;
}

/* 2. 套餐网格 */
.sec-title-box {
  display: flex;
  align-items: center;
  margin-bottom: 34rpx;
}

.sec-indicator {
  width: 20rpx; height: 4rpx;
  background: #E6C678;
  margin-right: 16rpx;
}

.sec-title {
  font-size: 24rpx;
  color: #888;
  letter-spacing: 2rpx;
  font-weight: 700;
}

.package-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.package-lux {
  padding: 50rpx 30rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all 0.3s;
  border: 1rpx solid rgba(255, 255, 255, 0.03);
}

.package-lux:active {
  transform: translateY(-4rpx);
  background: rgba(230, 198, 120, 0.05) !important;
  border-color: rgba(230, 198, 120, 0.3) !important;
}

.package-featured {
  background: rgba(230, 198, 120, 0.03) !important;
  border-color: rgba(230, 198, 120, 0.25) !important;
}

.featured-ribbon {
  position: absolute;
  top: 10rpx; right: -30rpx;
  background: #E6C678;
  color: #000;
  font-size: 14rpx;
  font-weight: 900;
  padding: 4rpx 40rpx;
  transform: rotate(45deg);
}

.pack-header {
  margin-bottom: 40rpx;
}

.pack-name {
  font-size: 32rpx;
  font-weight: 800;
  display: block;
}

.pack-price {
  margin-top: 10rpx;
}
.pack-price .cur { font-size: 20rpx; color: #EEE; }
.pack-price .amt { font-size: 40rpx; color: #EEE; font-weight: 700; }

.pack-body {
  flex: 1;
}

.benefit-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.benefit-row .b-l { font-size: 20rpx; color: #333; }
.benefit-row .b-v { font-size: 20rpx; color: #555; font-family: monospace; }

.gold-benefit .b-l, .gold-benefit .b-v {
  color: #E6C678;
}

.pack-footer {
  margin-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.03);
  padding-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.total-label { font-size: 18rpx; color: #222; }
.total-points { font-size: 24rpx; color: #E6C678; font-weight: 700; }

/* 3. 温馨提示 */
.service-notes {
  margin-top: 80rpx;
  padding: 40rpx;
}

.notes-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.notes-dot {
  width: 8rpx; height: 8rpx;
  background: #E6C678;
  border-radius: 50%;
  margin-right: 16rpx;
}

.notes-header text {
  font-size: 22rpx;
  color: #888;
  font-weight: 700;
}

.notes-list .note-item {
  font-size: 20rpx;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

/* 4. 安全背书 */
.footer-security {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.css-icon-shield-gold {
  width: 30rpx; height: 36rpx;
  border: 2rpx solid rgba(230, 198, 120, 0.2);
  border-radius: 4rpx 4rpx 15rpx 15rpx;
  position: relative;
}
.css-icon-shield-gold::before {
  content: "";
  position: absolute;
  top: 10rpx; left: 8rpx;
  width: 10rpx; height: 10rpx;
  background: rgba(230, 198, 120, 0.2);
  border-radius: 50%;
}

.footer-security text {
  font-size: 18rpx;
  color: #222;
  letter-spacing: 2rpx;
  font-variant: small-caps;
}

/* 加载遮罩 */
.pay-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.pay-modal {
  padding: 60rpx;
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.orb-loading {
  width: 80rpx; height: 80rpx;
  border: 2rpx solid rgba(230, 198, 120, 0.1);
  border-top-color: #E6C678;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 40rpx;
}

@keyframes spin { to { transform: rotate(360deg); } }

.pay-text {
  font-size: 24rpx;
  color: #E6C678;
  letter-spacing: 2rpx;
}