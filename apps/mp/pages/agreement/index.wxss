.container {
  padding: 32rpx;
  background: linear-gradient(180deg, #120a0a 0%, #1a0e0e 100%);
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #d4af37;
  text-align: center;
  margin-bottom: 40rpx;
}

.update-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-bottom: 40rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #d4af37;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #d4af37;
}

.section-content {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.8;
}

.highlight {
  color: #d4af37;
}

.footer {
  margin-top: 60rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid rgba(212, 175, 55, 0.2);
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}
