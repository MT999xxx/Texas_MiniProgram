/* Pages/points/index.wxss */
page {
  background-color: #050506;
}

.container {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 1. 积分宏观概览 */
.points-hero-box {
  margin: 40rpx 30rpx;
  padding: 60rpx 40rpx;
}

.points-display {
  text-align: center;
  margin-bottom: 50rpx;
}

.p-val {
  font-size: 100rpx;
  font-weight: 900;
  display: block;
  line-height: 1;
  margin-bottom: 16rpx;
}

.p-label-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.p-label {
  font-size: 18rpx;
  color: #222;
  letter-spacing: 4rpx;
  font-weight: 800;
}

.p-sub-label {
  font-size: 20rpx;
  color: #333;
}

.trend-lux {
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid rgba(255, 255, 255, 0.03);
  padding-top: 40rpx;
}

.trend-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.t-l { font-size: 14rpx; color: #222; font-weight: 800; letter-spacing: 2rpx; }
.t-v { font-size: 32rpx; font-weight: 700; font-family: monospace; }
.plus { color: #22C55E; }
.minus { color: #E6C678; }

.trend-divider {
  width: 1rpx; height: 30rpx;
  background: rgba(255, 255, 255, 0.05);
}

/* 2. 功能网格 */
.function-lux-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 0 30rpx;
  margin-bottom: 60rpx;
}

.func-lux-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 10rpx;
  transition: all 0.3s;
}

.func-lux-item:active { transform: scale(0.95); }

.func-lux-item text {
  font-size: 20rpx;
  color: #555;
  font-weight: 600;
}

/* CSS Icons */
.css-icon-doc-gold {
  width: 24rpx; height: 30rpx;
  border: 2rpx solid #E6C678;
  border-radius: 4rpx;
  position: relative;
}
.css-icon-doc-gold::after {
  content: "";
  position: absolute;
  top: 6rpx; left: 6rpx;
  width: 10rpx; height: 2rpx;
  background: #E6C678;
  box-shadow: 0 6rpx 0 #E6C678, 0 12rpx 0 #E6C678;
}

.css-icon-gift-gold {
  width: 28rpx; height: 24rpx;
  border: 2rpx solid #E6C678;
  border-radius: 4rpx;
  position: relative;
  margin-top: 6rpx;
}
.css-icon-gift-gold::before {
  content: "";
  position: absolute;
  top: -8rpx; left: 11rpx;
  width: 2rpx; height: 32rpx;
  background: #E6C678;
}

.css-icon-rank-gold {
  width: 30rpx; height: 20rpx;
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
}
.css-icon-rank-gold::before { content: ""; width: 8rpx; height: 12rpx; background: #E6C678; border-radius: 2rpx; }
.css-icon-rank-gold::after { content: ""; width: 8rpx; height: 20rpx; background: #E6C678; border-radius: 2rpx; box-shadow: -12rpx 8rpx 0 #E6C678; }

/* 3. 流水详细 */
.details-lux-sec {
  padding: 0 30rpx;
}

.sec-header-lux {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.sec-indicator {
  width: 20rpx; height: 4rpx;
  background: #E6C678;
  margin-right: 16rpx;
}

.sec-title {
  font-size: 24rpx;
  color: #888;
  font-weight: 700;
  margin-right: 30rpx;
}

.filter-lux {
  flex: 1;
  white-space: nowrap;
}

.f-tab {
  display: inline-block;
  font-size: 18rpx;
  color: #333;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.03);
}

.f-tab.active {
  background: #E6C678;
  color: #000;
  font-weight: 800;
}

.scroll-lux {
  height: 600rpx;
}

.trans-card {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.trans-name {
  font-size: 28rpx;
  color: #EEE;
  font-weight: 700;
  display: block;
  margin-bottom: 10rpx;
}

.trans-time {
  font-size: 18rpx;
  color: #333;
}

.trans-r {
  text-align: right;
}

.trans-amt {
  font-size: 34rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 8rpx;
}

.earned-v { color: #22C55E; }
.spent-v { color: #E6C678; }

.trans-status-tag {
  font-size: 14rpx;
  color: #222;
  letter-spacing: 2rpx;
}

/* 4. 尊享弹窗通用 */
.lux-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0; visibility: hidden;
  transition: all 0.3s;
}

.lux-modal.show { opacity: 1; visibility: visible; }

.modal-lux-content {
  width: 85%;
  border-radius: 40rpx;
  overflow: hidden;
  padding-bottom: 40rpx;
}

.modal-lux-header {
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.modal-lux-title {
  font-size: 24rpx;
  color: #E6C678;
  letter-spacing: 4rpx;
  font-weight: 900;
}

.modal-lux-close {
  width: 30rpx; height: 30rpx;
  position: relative;
}
.modal-lux-close::before, .modal-lux-close::after {
  content: "";
  position: absolute;
  top: 14rpx; left: 0;
  width: 100%; height: 2rpx;
  background: #333;
  transform: rotate(45deg);
}
.modal-lux-close::after { transform: rotate(-45deg); }

.modal-lux-body {
  max-height: 60vh;
  padding: 40rpx;
}

/* 规则 LI */
.rules-lux-group {
  margin-bottom: 40rpx;
}

.rule-lux-header {
  font-size: 18rpx;
  color: #E6C678;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.rule-lux-li {
  font-size: 22rpx;
  color: #888;
  line-height: 1.8;
  margin-bottom: 10rpx;
}

/* 兑换卡片 */
.exchange-lux-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}

.ex-name {
  font-size: 28rpx;
  color: #EEE;
  font-weight: 700;
  display: block;
}

.ex-desc {
  font-size: 18rpx;
  color: #444;
}

.ex-r { text-align: right; }

.ex-price {
  font-size: 24rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 16rpx;
}

.btn-lux-exchange {
  background: #E6C678;
  color: #000;
  font-size: 18rpx;
  font-weight: 800;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  line-height: 1;
}

.btn-disabled { background: #111; color: #333; }

/* 虚无状态 */
.empty-lux-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.css-icon-points-empty {
  width: 40rpx; height: 40rpx;
  border: 2rpx solid rgba(230, 198, 120, 0.1);
  border-radius: 50%;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 20rpx;
  color: #222;
  letter-spacing: 2rpx;
}

/* 加载波纹 */
.loading-more-lux {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

.loading-pulse-gold {
  width: 20rpx; height: 20rpx;
  border: 2rpx solid #E6C678;
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}
@keyframes pulse { 0% { transform: scale(0.8); opacity: 0; } 50% { opacity: 1; } 100% { transform: scale(1.5); opacity: 0; } }