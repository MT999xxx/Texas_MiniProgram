<view class="container redesign-bg">
  <!-- 1. 积分宏观概览 -->
  <view class="points-hero-box glass-panel shadow-lux">
    <view class="hero-main">
      <view class="points-display">
        <text class="p-val text-gold-gradient">{{totalPoints}}</text>
        <view class="p-label-group">
          <text class="p-label">POINTS BALANCE</text>
          <text class="p-sub-label">账户当前积分</text>
        </view>
      </view>
    </view>
    
    <view class="trend-lux">
      <view class="trend-item">
        <text class="t-l">MONTHLY EARNED</text>
        <text class="t-v plus">+{{monthlyEarned}}</text>
      </view>
      <view class="trend-divider"></view>
      <view class="trend-item">
        <text class="t-l">MONTHLY SPENT</text>
        <text class="t-v minus">-{{monthlyUsed}}</text>
      </view>
    </view>
  </view>

  <!-- 2. 四大尊享功能区 -->
  <view class="function-lux-grid">
    <view class="func-lux-item glass-panel gold-border" bindtap="showRules">
      <view class="css-icon-doc-gold"></view>
      <text>权益规则</text>
    </view>
    <view class="func-lux-item glass-panel gold-border" bindtap="showExchange">
      <view class="css-icon-gift-gold"></view>
      <text>积分兑礼</text>
    </view>
    <view class="func-lux-item glass-panel gold-border" bindtap="navigateToRanking">
      <view class="css-icon-rank-gold"></view>
      <text>风云榜单</text>
    </view>
  </view>

  <!-- 3. 积分流水明细 -->
  <view class="details-lux-sec">
    <view class="sec-header-lux">
      <view class="sec-indicator"></view>
      <text class="sec-title">积分流水账单</text>
      <scroll-view class="filter-lux" scroll-x>
        <text
          wx:for="{{filterTabs}}"
          wx:key="value"
          class="f-tab {{currentTab === item.value ? 'active' : ''}}"
          bindtap="switchTab"
          data-tab="{{item.value}}"
        >{{item.label}}</text>
      </scroll-view>
    </view>

    <view class="list-lux">
      <scroll-view class="scroll-lux" scroll-y refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
        <view wx:if="{{transactions.length === 0 && !loading}}" class="empty-lux-box">
          <view class="css-icon-points-empty"></view>
          <text class="empty-text">尚无积分流动记录</text>
        </view>

        <view wx:for="{{transactions}}" wx:key="id" class="trans-card glass-panel gold-border">
          <view class="trans-l">
            <text class="trans-name">{{item.description}}</text>
            <text class="trans-time">{{item.formattedDate}}</text>
          </view>
          <view class="trans-r">
            <text class="trans-amt {{item.type === 'EARNED' ? 'earned-v' : 'spent-v'}}">
              {{item.type === 'EARNED' ? '+' : '-'}}{{item.amount}}
            </text>
            <view class="trans-status-tag">{{item.statusText}}</view>
          </view>
        </view>

        <view wx:if="{{loading}}" class="loading-more-lux">
          <view class="loading-pulse-gold"></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 4. 尊享弹窗 - 规则 -->
  <view class="lux-modal {{showRulesModal ? 'show' : ''}}" catchtap="hideRules">
    <view class="modal-lux-content glass-panel gold-border shadow-lux" catchtap="stopPropagation">
      <view class="modal-lux-header">
        <text class="modal-lux-title">CLUB POINTS RULES</text>
        <view class="modal-lux-close" bindtap="hideRules"></view>
      </view>
      <scroll-view class="modal-lux-body" scroll-y>
        <view class="rules-lux-group">
          <view class="rule-lux-header">获取途径 EARN POINTS</view>
          <view class="rule-lux-li">· 尊客店内消费，每 1 CNY 均可累积 1 积分。</view>
          <view class="rule-lux-li">· 成功邀约贵宾签到，获赠 50 尊享积分。</view>
          <view class="rule-lux-li">· 参与俱乐部指定赛事，赢取高额积分奖励。</view>
        </view>

        <view class="rules-lux-group">
          <view class="rule-lux-header">权益消耗 USE POINTS</view>
          <view class="rule-lux-li">· 每 100 积分可抵扣 1 CNY 店内消费金额。</view>
          <view class="rule-lux-li">· 积分可于礼遇中心兑换限量俱乐部定制好礼。</view>
        </view>

        <view class="rules-lux-group">
          <view class="rule-lux-header">服务须知 TERMS</view>
          <view class="rule-lux-li">· 积分有效期为 365 天，到期未消耗将自动失效。</view>
          <view class="rule-lux-li">· 最终解释权归本私人俱乐部所有。</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 5. 尊享弹窗 - 兑换 -->
  <view class="lux-modal {{showExchangeModal ? 'show' : ''}}" catchtap="hideExchange">
    <view class="modal-lux-content glass-panel gold-border shadow-lux" catchtap="stopPropagation">
      <view class="modal-lux-header">
        <text class="modal-lux-title">PREMIUM EXCHANGE</text>
        <view class="modal-lux-close" bindtap="hideExchange"></view>
      </view>
      <scroll-view class="modal-lux-body" scroll-y>
        <view wx:for="{{exchangeItems}}" wx:key="id" class="exchange-lux-card">
          <view class="ex-l">
            <text class="ex-name">{{item.name}}</text>
            <text class="ex-desc">{{item.description}}</text>
          </view>
          <view class="ex-r">
            <text class="ex-price text-gold-gradient">{{item.points}} PTS</text>
            <button
              class="btn-lux-exchange {{totalPoints >= item.points ? 'shimmer-effect' : 'btn-disabled'}}"
              bindtap="exchangeItem"
              data-id="{{item.id}}"
              disabled="{{totalPoints < item.points}}"
            >
              {{totalPoints >= item.points ? '立即兑换' : '积分余额不足'}}
            </button>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>