/* Pages/reservation/index.wxss */
page {
  background-color: #050506;
}

.container {
  min-height: 100vh;
  padding: 40rpx 30rpx;
}

/* 头部渲染 */
.header-section {
  text-align: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.page-title {
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: 12rpx;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 18rpx;
  color: #444;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

/* 表单卡片 */
.form-card {
  padding: 50rpx 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  margin-top: 20rpx;
}

.sec-icon-line {
  width: 6rpx;
  height: 30rpx;
  background: #E6C678;
  margin-right: 20rpx;
  box-shadow: 0 0 10rpx #E6C678;
}

.sec-title {
  font-size: 30rpx;
  color: #EEE;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-row-lux {
  display: flex;
  gap: 30rpx;
}

.flex-1 { flex: 1; }

.form-label {
  font-size: 24rpx;
  color: #555;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #E6C678;
  margin-right: 6rpx;
}

.form-input-lux, .picker-value-lux, .form-textarea-lux {
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  color: #CCC;
  font-size: 28rpx;
  padding: 0 30rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
}

.lux-placeholder {
  color: #333;
}

.picker-value-lux::after {
  content: "";
  width: 12rpx; height: 12rpx;
  border-right: 2rpx solid #333;
  border-bottom: 2rpx solid #333;
  transform: rotate(45deg);
  margin-left: auto;
}

.form-textarea-lux {
  height: 180rpx;
  padding: 24rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 提示框 */
.tips-box {
  display: flex;
  padding: 30rpx;
  margin-top: 20rpx;
  position: relative;
  overflow: hidden;
}

.tips-dot {
  width: 12rpx;
  height: 12rpx;
  background: #E6C678;
  border-radius: 50%;
  margin-right: 20rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.tips-content {
  flex: 1;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  display: block;
}

.tips-text {
  font-size: 22rpx;
  color: #444;
  line-height: 1.6;
  display: block;
}

/* 按钮 */
.button-group {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.btn-submit-lux {
  width: 100% !important;
  height: 100rpx !important;
  line-height: 100rpx !important;
  background: linear-gradient(135deg, #E6C678 0%, #8C6A2F 100%) !important;
  color: #000 !important;
  border-radius: 50rpx !important;
  font-size: 32rpx !important;
  font-weight: 800 !important;
  box-shadow: 0 10rpx 30rpx rgba(230, 198, 120, 0.3) !important;
}

.btn-history {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  letter-spacing: 2rpx;
}
