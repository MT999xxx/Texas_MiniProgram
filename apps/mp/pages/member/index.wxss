/* pages/member/index.wxss */
page {
  background-color: #030304;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  padding-bottom: 120rpx;
}

/* =========================================================
   Member Page - Royal Night Gold Specialist Styles
   ========================================================= */

.redesign-bg {
  min-height: 100vh;
  background: radial-gradient(circle at top right, #0a0a0a 0%, #050505 100%);
  padding: 40rpx 30rpx;
}

/* 1. 用户信息区域 */
.premium-user-box {
  display: flex;
  align-items: center;
  margin-bottom: 50rpx;
  padding-left: 10rpx;
}

.avatar-border {
  padding: 4rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4AF37, #4a0e0e);
  margin-right: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(212, 175, 55, 0.2);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #000;
  background: #111;
}

.user-nickname {
  font-size: 40rpx;
  font-weight: 700;
  color: #FDFDFD;
  margin-bottom: 8rpx;
  display: block;
}

.user-id-badge {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #888;
  background: rgba(255, 255, 255, 0.05);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.id-label { margin-right: 8rpx; }

/* 2. 奢华会员卡 */
.luxury-card {
  padding: 40rpx;
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.level-box {
  display: flex;
  align-items: baseline;
}

.level-v {
  font-style: italic;
  font-size: 48rpx;
  color: #D4AF37;
  font-weight: 800;
  margin-right: 4rpx;
}

.level-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #D4AF37;
  margin-right: 16rpx;
}

.level-title {
  font-size: 24rpx;
  color: rgba(212, 175, 55, 0.8);
  letter-spacing: 2rpx;
}

.growth-box {
  text-align: right;
  width: 240rpx;
}

.growth-text {
  font-size: 20rpx;
  color: #888;
  margin-bottom: 12rpx;
  display: block;
}

.growth-bar {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 3rpx;
}

.growth-inner {
  height: 100%;
  background: #D4AF37;
  box-shadow: 0 0 10rpx #D4AF37;
  border-radius: 3rpx;
}

/* 统计数据区 */
.premium-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 50rpx;
  padding: 20rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-val {
  font-size: 44rpx;
  margin-bottom: 10rpx;
  text-shadow: 0 0 20rpx rgba(212, 175, 55, 0.3);
}

.stat-name {
  font-size: 22rpx;
  color: #888;
}

.scale-up {
  transform: scale(1.1);
}

/* 主充值按钮 */
.main-recharge {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 40rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

/* 快捷导航 */
.quick-nav {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-item text {
  font-size: 22rpx;
  color: #D4AF37;
  margin-top: 12rpx;
}

.icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.03);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

/* 3. 功能菜单列表 */
.menu-container {
  margin-top: 50rpx;
}

.menu-group-title {
  font-size: 24rpx;
  color: #444;
  margin-left: 10rpx;
  margin-bottom: 20rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.premium-menu {
  overflow: hidden;
}

.premium-menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.02);
}

.premium-menu-item:last-child {
  border-bottom: none;
}

.menu-info {
  display: flex;
  align-items: center;
}

.menu-icon-text {
  font-size: 32rpx;
  margin-right: 24rpx;
  opacity: 0.8;
}

.menu-label {
  font-size: 30rpx;
  color: #DDD;
}

.menu-arrow-icon {
  font-family: 'Material Icons';
  color: #333;
  font-size: 24rpx;
}

/* 登出区域 */
.logout-wrapper {
  margin-top: 60rpx;
  padding: 0 40rpx;
}

.logout-btn-new {
  width: 100% !important;
  background: transparent !important;
  opacity: 0.6;
}

/* 4. 尊享弹窗样式 */
.luxury-modal {
  width: 600rpx;
  padding: 60rpx 40rpx;
  position: relative;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-head {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #D4AF37;
  margin-bottom: 50rpx;
}

.premium-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.grid-item {
  padding: 30rpx 0;
  text-align: center;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  transition: all 0.2s;
}

.active-grid {
  background: rgba(212, 175, 55, 0.1);
  border-color: #D4AF37;
}

.grid-val {
  font-size: 32rpx;
  color: #D4AF37;
  font-weight: bold;
  display: block;
}

.grid-sub {
  font-size: 20rpx;
  color: #666;
}

.input-luxury {
  border-bottom: 2rpx solid rgba(212, 175, 55, 0.2);
  padding: 20rpx 0;
  margin-bottom: 30rpx;
}
.lux-bonus {
  font-size: 22rpx;
  color: #D4AF37;
  margin-top: 10rpx;
  opacity: 0.8;
}

.lux-rules {
  background: rgba(255, 255, 255, 0.02);
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
}

.lux-rules text {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  transition: all 0.2s;
}

.btn-cancel {
  background: rgba(255, 255, 255, 0.05);
  color: #888;
}

.btn-confirm {
  background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
  color: #000;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(212, 175, 55, 0.3);
}

.btn-confirm:active {
  transform: scale(0.96);
}

.action-text {
  color: #cc9966;
  font-size: 24rpx;
}

.action-btn:active {
  background: rgba(139, 0, 0, 0.3);
}

/* --- 7. 弹窗额外样式 --- */
.deposit-rules {
  display: flex;
  flex-direction: column;
  background: rgba(255, 200, 100, 0.1);
  padding: 20rpx;
  border-radius: 10rpx;
  margin: 20rpx 0;
}

.deposit-rules text {
  color: #cc9966;
  font-size: 24rpx;
  line-height: 1.8;
}

.balance-tip {
  color: #999;
  font-size: 24rpx;
  text-align: center;
  margin: 20rpx 0;
}

.exchange-rate {
  background: linear-gradient(90deg, #8b0000, #4a0e0e);
  color: #fff;
  text-align: center;
  padding: 16rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.exchange-preview {
  color: #cc9966;
  font-size: 28rpx;
  text-align: center;
  padding: 16rpx;
  background: rgba(139, 0, 0, 0.1);
  border-radius: 10rpx;
  margin: 20rpx 0;
}
