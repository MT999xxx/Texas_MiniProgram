/* pages/member/index.wxss */
page {
  background-color: #030304;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  --setbar-tabbar-space: calc(154rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

/* =========================================================
   Member Page - Set baR Specialist Styles
   ========================================================= */

.redesign-bg {
  min-height: 100vh;
  position: relative;
  z-index: 10;
  padding: 40rpx 30rpx calc(160rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

/* 0. 背景层深度优化 (同步首页) */
.hero-bg-lux-member {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  background:
    linear-gradient(180deg, rgba(5, 5, 6, 0.48), #050506 72%),
    url('/images/setbar-panther-hero.jpg');
  background-size: cover;
  background-position: 76% 14%;
  opacity: 0.78;
}

.hero-bg-lux-member::before {
  content: "";
  position: absolute;
  top: -50%; left: -50%; width: 200%; height: 200%;
  background-image: radial-gradient(rgba(230, 198, 120, 0.1) 1rpx, transparent 1rpx);
  background-size: 100rpx 100rpx;
  opacity: 0.3;
  animation: floatParticles 80s linear infinite;
}

.member-page-title {
  position: relative;
  z-index: 11;
  margin: 12rpx 0 34rpx 10rpx;
  display: flex;
  flex-direction: column;
}

.member-kicker {
  font-size: 16rpx;
  color: #D64A3B;
  letter-spacing: 6rpx;
  font-weight: 800;
}

.member-heading {
  margin-top: 8rpx;
  font-size: 58rpx;
  line-height: 1;
  color: #F8F5EC;
  font-weight: 900;
  text-shadow: 0 18rpx 44rpx rgba(0,0,0,0.72);
}

/* 1. 用户信息区域 */
.premium-user-box {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-left: 10rpx;
}

.avatar-border {
  padding: 6rpx;
  border-radius: 34rpx;
  background: conic-gradient(from 0deg, #E6C678, #D64A3B, #421018, #E6C678);
  margin-right: 30rpx;
  box-shadow: 0 0 30rpx rgba(230, 198, 120, 0.2);
  animation: rotateGlow 4s linear infinite;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes rotateGlow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  border: 4rpx solid #000;
  background: #111;
  transform: rotate(-0deg); /* 抵消外层旋转 */
}

.user-nickname {
  font-size: 40rpx;
  font-weight: 700;
  color: #FDFDFD;
  margin-bottom: 8rpx;
  display: block;
}

/* 2. 会员身份与数据展示 (毛玻璃卡片) */
.luxury-card {
  margin: 24rpx 0 30rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

/* 默认 V1 / 通用样式 - 天蓝白紫渐变 */
.luxury-card.level-theme-v1 {
  background: linear-gradient(135deg, #dce8f8 0%, #eef4ff 40%, #e8e0f5 100%);
  color: #2c3560;
  box-shadow: 0 12rpx 40rpx rgba(100, 150, 240, 0.18);
}
.luxury-card.level-theme-v1 .level-v,
.luxury-card.level-theme-v1 .level-num,
.luxury-card.level-theme-v1 .level-title,
.luxury-card.level-theme-v1 .growth-text,
.luxury-card.level-theme-v1 .stat-label {
  color: #3a4f9a;
}

/* V2 荣耀黄金 - 深天蓝转淡紫 */
.luxury-card.level-theme-v2 {
  background: linear-gradient(135deg, #b8d4f0 0%, #d6e8ff 45%, #c8b8e8 100%);
  color: #1e3060;
  box-shadow: 0 12rpx 40rpx rgba(80, 130, 220, 0.22);
}
.luxury-card.level-theme-v2 .level-v,
.luxury-card.level-theme-v2 .level-num,
.luxury-card.level-theme-v2 .level-title,
.luxury-card.level-theme-v2 .growth-text {
  color: #2a4a8a;
}

/* V3 高贵铂金 - 天蓝白紫柔和过渡 */
.luxury-card.level-theme-v3 {
  background: linear-gradient(135deg, #a8c8f0 0%, #f0f4ff 50%, #c0a8e8 100%);
  color: #1a2860;
  box-shadow: 0 12rpx 40rpx rgba(120, 100, 220, 0.22);
}
.luxury-card.level-theme-v3 .level-v,
.luxury-card.level-theme-v3 .level-num,
.luxury-card.level-theme-v3 .level-title,
.luxury-card.level-theme-v3 .growth-text {
  color: #2040a0;
}

/* V4 巳峰钓石 - 深紫蓝天蓝元气 */
.luxury-card.level-theme-v4 {
  background: linear-gradient(135deg, #8ab0e8 0%, #d0dcff 40%, #a888d8 100%);
  color: #140840;
  box-shadow: 0 12rpx 40rpx rgba(140, 80, 220, 0.28);
}
.luxury-card.level-theme-v4 .level-v,
.luxury-card.level-theme-v4 .level-num,
.luxury-card.level-theme-v4 .level-title,
.luxury-card.level-theme-v4 .growth-text {
  color: #1a1060;
}

/* V5 星耀黑金 - 深色底金色字 */
.luxury-card.level-theme-v5 {
  background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 50%, #1a1a1a 100%);
  color: #E6C678;
  box-shadow: 0 12rpx 40rpx rgba(230, 198, 120, 0.2);
}
.luxury-card.level-theme-v5 .level-v,
.luxury-card.level-theme-v5 .level-num,
.luxury-card.level-theme-v5 .level-title,
.luxury-card.level-theme-v5 .growth-text {
  color: #E6C678;
}

/* V6 Set baR合伙人 - 亮白紫渐变（参考滴滴高端卡片风格） */
.luxury-card.level-theme-v6 {
  background: linear-gradient(135deg, #e6f0ff 0%, #ffffff 30%, #e0c8ff 70%, #c49aff 100%);
  color: #2a1060;
  box-shadow: 0 12rpx 40rpx rgba(160, 100, 255, 0.25);
}
.luxury-card.level-theme-v6 .level-v,
.luxury-card.level-theme-v6 .level-num,
.luxury-card.level-theme-v6 .level-title,
.luxury-card.level-theme-v6 .growth-text {
  color: #4a1a90;
}

.luxury-card::after {
  content: 'V';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  font-size: 240rpx;
  font-weight: 900;
  opacity: 0.08;
  font-family: 'Inter', sans-serif;
  transform: rotate(15deg);
  pointer-events: none;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.level-box {
  display: flex;
  align-items: baseline;
}

.level-v {
  font-style: italic;
  font-size: 48rpx;
  color: #E6C678;
  font-weight: 800;
  margin-right: 4rpx;
}

.level-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #E6C678;
  margin-right: 16rpx;
}

.level-title {
  font-size: 24rpx;
  color: rgba(230, 198, 120, 0.8);
  letter-spacing: 2rpx;
}

.growth-box {
  text-align: right;
  width: 240rpx;
}

.growth-text {
  font-size: 20rpx;
  color: #888;
  margin-bottom: 12rpx;
  display: block;
}

.growth-bar {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 3rpx;
}

.growth-inner {
  height: 100%;
  background: var(--gold-500, #E6C678);
  border-radius: 10rpx;
  box-shadow: 0 0 10rpx rgba(230, 198, 120, 0.5);
}

.level-theme-v1 .growth-inner,
.level-theme-v2 .growth-inner,
.level-theme-v3 .growth-inner,
.level-theme-v4 .growth-inner {
  background: #333; /* 浅色背景下用深色进度条 */
}

/* 统计数据区 */
.premium-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 50rpx;
  padding: 20rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-val {
  font-size: 52rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 0 30rpx rgba(230, 198, 120, 0.5);
  font-family: 'SF Pro Display', sans-serif;
  font-weight: 800;
}

.stat-name {
  font-size: 22rpx;
  color: #888;
}

.scale-up {
  transform: scale(1.1);
}

/* 主充值按钮 */
.main-recharge {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 40rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

/* 快捷导航 */
.quick-nav {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 20rpx;
  margin-top: 34rpx;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.nav-item text {
  font-size: 22rpx;
  color: #E6C678;
  margin-top: 12rpx;
}

.icon-circle {
  width: 90rpx;
  height: 90rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.03);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.quick-icon-img {
  width: 42rpx;
  height: 42rpx;
}

/* CSS 纯享小图标 */
.css-icon-in, .css-icon-out {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #E6C678;
  border-bottom: 4rpx solid #E6C678;
  position: relative;
}

.css-icon-in { transform: rotate(-45deg); top: -4rpx; }
.css-icon-out { transform: rotate(135deg); top: 4rpx; }

.css-icon-in::after, .css-icon-out::after {
  content: "";
  position: absolute;
  width: 4rpx; height: 32rpx;
  background: #E6C678;
  transform-origin: center;
}

.css-icon-in::after { transform: rotate(45deg) translate(-14rpx, -14rpx); }
.css-icon-out::after { transform: rotate(45deg) translate(14rpx, 14rpx); }

.css-icon-exchange {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #E6C678;
  border-radius: 50%;
  position: relative;
}

.css-icon-exchange::before {
  content: "$";
  color: #E6C678;
  font-size: 20rpx;
  font-weight: bold;
}

/* 4. 邀请奖励区域 */
.invite-section {
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  background: rgba(30, 20, 10, 0.85);
}

.invite-header {
  text-align: center;
  margin-bottom: 16rpx;
}

.invite-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--gold-500, #E6C678);
}

.invite-desc {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 30rpx;
  line-height: 1.5;
}

.invite-code-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.code-label,
.input-label {
  font-size: 28rpx;
  color: #fff;
}

.code-value-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-value {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-family: monospace;
}

.copy-btn {
  padding: 8rpx 16rpx;
  background: rgba(230, 198, 120, 0.2);
  border-radius: 8rpx;
}

.copy-icon {
  font-size: 24rpx;
}

.invite-input-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.input-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.invite-input {
  width: 240rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #fff;
}

.confirm-btn {
  padding: 12rpx 32rpx;
  background: var(--gold-500, #E6C678);
  border-radius: 30rpx;
  color: #1a1a1a;
  font-size: 26rpx;
  font-weight: 600;
}

.invited-list-entry {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 30rpx;
  gap: 10rpx;
}

.invited-title {
  font-size: 28rpx;
  color: var(--gold-500, #E6C678);
}

.invited-arrow {
  font-size: 24rpx;
  color: var(--gold-500, #E6C678);
}

/* 邀请弹窗特定样式 */
.invite-modal {
  width: 90%;
  max-width: 600rpx;
}

.invite-desc-popup {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 30rpx;
  line-height: 1.5;
}

.invite-modal .invite-code-row,
.invite-modal .invite-input-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.invite-modal .invited-list-entry {
  padding-top: 24rpx;
  padding-bottom: 10rpx;
}

/* 3. 功能菜单列表 */
.menu-container {
  margin-top: 34rpx;
}

.menu-group-title {
  font-size: 24rpx;
  color: #555;
  margin-left: 10rpx;
  margin-bottom: 24rpx;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.premium-menu {
  border-radius: 28rpx;
  background: rgba(255,255,255,0.055) !important;
  border: 1rpx solid rgba(255,255,255,0.08);
  overflow: hidden;
}

.premium-menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 36rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.03);
  transition: all 0.2s ease;
}

.premium-menu-item:active {
  background: rgba(230, 198, 120, 0.03);
}

.premium-menu-item:last-child {
  border-bottom: none;
}

.menu-info {
  display: flex;
  align-items: center;
}

.menu-icon-wrapper {
  width: 46rpx;
  height: 46rpx;
  border-radius: 18rpx;
  margin-right: 24rpx;
  background: rgba(214, 74, 59, 0.12);
  border: 1rpx solid rgba(214, 74, 59, 0.24);
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.copy-icon-img {
  width: 26rpx;
  height: 26rpx;
}

.menu-label {
  font-size: 28rpx;
  color: #CCC;
  font-weight: 400;
}

.menu-arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid #444;
  border-bottom: 3rpx solid #444;
  transform: rotate(-45deg);
}

/* 登出区域 */
.logout-wrapper {
  margin-top: 60rpx;
  padding: 0 40rpx;
}

.logout-btn-new {
  width: 100% !important;
  background: transparent !important;
  opacity: 0.6;
}

/* 4. 尊享弹窗样式 */
.luxury-modal {
  width: 600rpx;
  padding: 60rpx 40rpx;
  position: relative;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx) scale(0.9);
    opacity: 0;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

.modal-head {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #E6C678;
  margin-bottom: 50rpx;
}

.premium-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.grid-item {
  padding: 30rpx 0;
  text-align: center;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  transition: all 0.2s;
}

.active-grid {
  background: rgba(230, 198, 120, 0.1);
  border-color: #E6C678;
}

.grid-val {
  font-size: 32rpx;
  color: #E6C678;
  font-weight: bold;
  display: block;
}

.grid-sub {
  font-size: 20rpx;
  color: #666;
}

.input-luxury {
  border-bottom: 2rpx solid rgba(230, 198, 120, 0.2);
  padding: 20rpx 0;
  margin-bottom: 30rpx;
}
.lux-bonus {
  font-size: 22rpx;
  color: #E6C678;
  margin-top: 10rpx;
  opacity: 0.8;
}

.lux-rules {
  background: rgba(255, 255, 255, 0.02);
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(230, 198, 120, 0.1);
}

.lux-rules text {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.recharge-rules {
  margin-top: 22rpx;
}

.voucher-modal {
  max-height: 82vh;
}

.voucher-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.voucher-package {
  min-height: 118rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(230, 198, 120, 0.16);
}

.voucher-package:active {
  transform: scale(0.985);
  opacity: 0.88;
}

.voucher-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.voucher-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #F8F5EC;
}

.voucher-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.46);
}

.voucher-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  margin-left: 20rpx;
}

.voucher-price {
  font-size: 28rpx;
  font-weight: 800;
  color: #E6C678;
}

.voucher-count {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #FFF3C8;
  background: rgba(214, 74, 59, 0.22);
}

.point-records-modal {
  max-height: 78vh;
}

.point-record-list {
  max-height: 620rpx;
  margin-bottom: 34rpx;
}

.point-record-empty {
  padding: 88rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.48);
}

.point-record-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.point-record-item:last-child {
  border-bottom: 0;
}

.point-record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.point-record-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.point-record-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #F8F5EC;
}

.point-record-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

.point-record-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.point-record-points {
  font-size: 32rpx;
  font-weight: 900;
}

.point-record-points.plus {
  color: #E6C678;
}

.point-record-points.minus {
  color: #D64A3B;
}

.point-record-status {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.56);
}

.point-record-remark {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.42);
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  transition: all 0.2s;
}

.btn-cancel {
  background: rgba(255, 255, 255, 0.05);
  color: #888;
}

.btn-confirm {
  background: linear-gradient(135deg, #E6C678 0%, #8C6A2F 100%);
  color: #000;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(230, 198, 120, 0.3);
}

.btn-confirm:active {
  transform: scale(0.96);
}

.action-text {
  color: #cc9966;
  font-size: 24rpx;
}

.action-btn:active {
  background: rgba(157, 46, 69, 0.3);
}

/* --- 7. 弹窗额外样式 --- */
.deposit-rules {
  display: flex;
  flex-direction: column;
  background: rgba(255, 200, 100, 0.1);
  padding: 20rpx;
