<view class="container redesign-bg">
  <view class="hero-bg-lux-member"></view>
  
  <!-- 1. 用户信息区域 (沉浸式) -->
  <view class="member-page-title">
    <text class="member-kicker">Set baR</text>
    <text class="member-heading">会员中心</text>
  </view>

  <view class="premium-user-box" bindtap="onUserInfoClick">
    <view class="avatar-border">
      <image class="user-avatar" src="{{userInfo.avatar}}" binderror="onAvatarError" />
    </view>
    <view class="user-details">
      <text class="user-nickname">{{userInfo.nickname}}</text>
    </view>
  </view>

  <!-- 2. 会员身份与数据展示 (毛玻璃卡片) -->
  <view class="luxury-card glass-panel gold-border shadow-lux level-theme-v{{memberInfo.levelNum || 1}}">
    <view class="card-top" bindtap="goToMemberLevel">
      <view class="level-box">
        <image class="member-level-emblem" src="{{memberInfo.levelIcon}}" mode="aspectFill" />
        <view class="level-copy">
          <view class="level-code-row">
            <text class="level-v">V</text>
            <text class="level-num">{{memberInfo.levelNum || 1}}</text>
          </view>
          <text class="level-title">{{memberInfo.levelName || '尊荣白银'}}</text>
        </view>
      </view>
      <view class="growth-box">
        <text class="growth-text" wx:if="{{!memberInfo.isMaxLevel}}">距下一等级还需充值 ¥{{memberInfo.nextLevelDiff}}</text>
        <text class="growth-text" wx:else>已达最高会员等级</text>
        <view class="growth-bar">
          <view class="growth-inner" style="width: {{memberInfo.growthPercent || 20}}%"></view>
        </view>
      </view>
    </view>
    
    <!-- 数据统计区 (骨架屏支持) -->
    <view class="premium-stats">
      <view class="stat-item">
        <block wx:if="{{loading}}">
          <skeleton shape="line" customStyle="width: 80rpx; height: 40rpx; margin: 10rpx auto;" />
        </block>
        <block wx:else>
          <text class="stat-val font-bold text-gold">{{stats.coins}}</text>
        </block>
        <text class="stat-name">金币余额</text>
      </view>
      <view class="stat-item scale-up">
        <block wx:if="{{loading}}">
          <skeleton shape="line" customStyle="width: 100rpx; height: 50rpx; margin: 10rpx auto;" />
        </block>
        <block wx:else>
          <text class="stat-val font-bold text-gold">{{stats.points}}</text>
        </block>
        <text class="stat-name">累计积分</text>
      </view>
      <view class="stat-item">
        <block wx:if="{{loading}}">
          <skeleton shape="line" customStyle="width: 60rpx; height: 40rpx; margin: 10rpx auto;" />
        </block>
        <block wx:else>
          <text class="stat-val font-bold text-gold">{{stats.wineVouchers}}</text>
        </block>
        <text class="stat-name">酒券</text>
      </view>
    </view>

    <!-- 核心操作按钮 -->
    <button class="btn-primary main-recharge" bindtap="onRecharge">立即充值</button>
    
    <!-- 快捷功能区 (线性布局) -->
    <view class="quick-nav">
      <view class="nav-item" bindtap="showDepositDialog">
        <view class="icon-circle gold-border shimmer-effect">
          <image class="quick-icon-img" src="/images/icons/wallet-gold.svg" mode="aspectFit" />
        </view>
        <text>存分</text>
      </view>
      <view class="nav-item" bindtap="showWithdrawDialog">
        <view class="icon-circle gold-border shimmer-effect">
          <image class="quick-icon-img" src="/images/icons/coupon-gold.svg" mode="aspectFit" />
        </view>
        <text>取分</text>
      </view>
      <view class="nav-item" bindtap="showExchangeDialog">
        <view class="icon-circle gold-border shimmer-effect">
          <image class="quick-icon-img" src="/images/icons/special-gold.svg" mode="aspectFit" />
        </view>
        <text>兑换</text>
      </view>
      <view class="nav-item" bindtap="showPointRecordsDialog">
        <view class="icon-circle gold-border shimmer-effect">
          <image class="quick-icon-img" src="/images/icons/orders-gold.svg" mode="aspectFit" />
        </view>
        <text>记录</text>
      </view>
    </view>
  </view>

  <!-- 3. 功能菜单 (分组展示) -->
  <view class="menu-container">
    <view class="menu-group-title">我的服务</view>
    <view class="premium-menu glass-panel">
      <block wx:for="{{menuList}}" wx:key="text">
        <view class="premium-menu-item" bindtap="onMenuClick" data-index="{{index}}">
          <view class="menu-info">
            <view class="menu-icon-wrapper">
              <image class="menu-icon-img" src="{{item.icon}}" mode="aspectFit" />
            </view>
            <text class="menu-label">{{item.text}}</text>
          </view>
          <view class="menu-arrow-icon"></view>
        </view>
      </block>
      <!-- 邀请奖励入口 -->
      <view class="premium-menu-item" bindtap="showInvitePopup">
        <view class="menu-info">
          <view class="menu-icon-wrapper">
            <image class="menu-icon-img" src="/images/icons/members-gold.svg" mode="aspectFit" />
          </view>
          <text class="menu-label">邀请奖励</text>
        </view>
        <view class="menu-arrow-icon"></view>
      </view>
    </view>
  </view>

  <!-- 登出区域 -->
  <view class="logout-wrapper" wx:if="{{isLogin}}">
    <button class="btn-secondary logout-btn-new" bindtap="onLogout">退出当前账户</button>
  </view>

  <!-- 底部占位 -->
  <view style="height: 230rpx;"></view>
  <tab-bar selected="3"></tab-bar>

  <!-- ================= 弹窗重构 (基于全局样式) ================= -->
  
  <!-- 充值弹窗 -->
  <view class="modal-mask" wx:if="{{showRechargePopup}}" bindtap="hideRecharge">
    <view class="luxury-modal glass-panel gold-border" catchtap="true">
      <view class="modal-head">充值金币</view>
      
      <view class="premium-grid">
        <view wx:for="{{rechargeOptions}}" wx:key="amount" 
              class="grid-item {{selectedAmount === item.amount ? 'active-grid' : ''}}" 
              bindtap="selectAmount" data-amount="{{item.amount}}">
          <text class="grid-val">¥{{item.amount}}</text>
          <text class="grid-sub">{{item.desc}}</text>
        </view>
      </view>

      <view class="lux-rules recharge-rules">
        <text>• 充值仅开放固定套餐</text>
        <text>• 选择套餐后按对应金币和积分入账</text>
      </view>

      <view class="modal-btns">
        <view class="btn-cancel" bindtap="hideRecharge">取消</view>
        <view class="btn-confirm" bindtap="submitRecharge">立即支付</view>
      </view>
    </view>
  </view>

  <!-- 存积分弹窗 -->
  <view class="modal-mask" wx:if="{{showDepositPopup}}" bindtap="hideDepositDialog">
    <view class="luxury-modal glass-panel gold-border" catchtap="stopBubble">
      <view class="modal-head">存储积分</view>
      <view class="input-luxury">
        <input class="lux-input" type="number" placeholder="请输入存入数量" 
               value="{{depositAmount}}" bindinput="onDepositInput" />
      </view>
      <view class="lux-rules">
        <text>• 赢得积分1:10存入账户</text>
        <text>• 充值积分1:5存入账户</text>
      </view>
      <view class="modal-btns">
        <view class="btn-cancel" bindtap="hideDepositDialog">返回</view>
        <view class="btn-confirm" bindtap="submitDeposit">确认提交</view>
      </view>
    </view>
  </view>

  <!-- 取积分弹窗 -->
  <view class="modal-mask" wx:if="{{showWithdrawPopup}}" bindtap="hideWithdrawDialog">
    <view class="luxury-modal glass-panel gold-border" catchtap="stopBubble">
      <view class="modal-head">取出积分</view>
      <view class="input-luxury">
        <input class="lux-input" type="number" placeholder="请输入取出数量" 
               value="{{withdrawAmount}}" bindinput="onWithdrawInput" />
      </view>
      <view class="lux-rules">
        <text>• 当前积分余额：{{stats.points}}</text>
        <text>• 取出后可用于店内消费</text>
      </view>
      <view class="modal-btns">
        <view class="btn-cancel" bindtap="hideWithdrawDialog">返回</view>
        <view class="btn-confirm" bindtap="submitWithdraw">确认取出</view>
      </view>
    </view>
  </view>

  <!-- 存取分记录弹窗 -->
  <view class="modal-mask" wx:if="{{showPointRecordsPopup}}" bindtap="hidePointRecordsDialog">
    <view class="luxury-modal glass-panel gold-border point-records-modal" catchtap="stopBubble">
      <view class="modal-head">存取分记录</view>
      <view wx:if="{{pointRecordsLoading}}" class="point-record-empty">加载中...</view>
      <view wx:elif="{{pointRecords.length === 0}}" class="point-record-empty">暂无存取分记录</view>
      <scroll-view wx:else scroll-y class="point-record-list">
        <view wx:for="{{pointRecords}}" wx:key="id" class="point-record-item">
          <view class="point-record-row">
            <view class="point-record-main">
              <text class="point-record-title">{{item.title}}</text>
              <text class="point-record-time">{{item.createdAtText}}</text>
            </view>
            <view class="point-record-side">
              <text class="point-record-points {{item.directionClass}}">{{item.pointsText}}</text>
              <text class="point-record-status">{{item.statusText}}</text>
            </view>
          </view>
          <text wx:if="{{item.remark}}" class="point-record-remark">{{item.remark}}</text>
        </view>
      </scroll-view>
      <view class="modal-btns">
        <view class="btn-cancel" bindtap="hidePointRecordsDialog">返回</view>
      </view>
    </view>
  </view>

  <!-- 酒券购买弹窗 -->
  <view class="modal-mask" wx:if="{{showExchangePopup}}" bindtap="hideExchangeDialog">
    <view class="luxury-modal glass-panel gold-border member-voucher-disabled-modal" catchtap="stopBubble">
      <view class="modal-head">酒券购买</view>
      <view class="voucher-list">
        <view
          wx:for="{{voucherPackages}}"
          wx:key="id"
          class="voucher-package"
          bindtap="purchaseVoucher"
          data-id="{{item.id}}"
        >
          <view class="voucher-main">
            <text class="voucher-name">{{item.name}}</text>
            <text class="voucher-desc">{{item.description || '15天有效，赠送8000积分'}}</text>
          </view>
          <view class="voucher-side">
            <text class="voucher-price">{{item.price}}金币</text>
            <text class="voucher-count">{{item.voucherCount || 1}}张</text>
          </view>
        </view>
      </view>
      <view class="lux-rules">
        <text>• 酒券15天有效，过期自动失效</text>
        <text>• 最后一天会提醒快过期</text>
        <text>• 购买酒券赠送8000积分</text>
      </view>
      <view class="modal-btns">
        <view class="btn-cancel" bindtap="hideExchangeDialog">返回</view>
      </view>
    </view>
  </view>

  <!-- 邀请奖励弹窗 -->
  <view class="modal-mask" wx:if="{{showInvitePopup}}" bindtap="hideInvitePopup">
    <view class="luxury-modal glass-panel gold-border invite-modal" catchtap="stopBubble">
      <view class="modal-head">邀请好友获得奖励</view>
      <view class="invite-desc-popup">
        <text>带一个新用户消费，双方可获得500积分奖励</text>
      </view>
      
      <!-- 我的邀请码 -->
      <view class="invite-code-row">
        <text class="code-label">我的邀请码</text>
        <view class="code-value-box">
          <text class="code-value">{{inviteCode || 'e7f0014b'}}</text>
          <view class="copy-btn" bindtap="copyInviteCode">
            <image class="copy-icon-img" src="/images/icons/orders-gold.svg" mode="aspectFit" />
          </view>
        </view>
      </view>
      
      <!-- 填写邀请码 -->
      <view class="invite-input-row">
        <text class="input-label">填写邀请码</text>
        <view class="input-box">
          <input class="invite-input" placeholder="输入邀请码" value="{{inputInviteCode}}" bindinput="onInviteCodeInput" />
          <view class="confirm-btn" bindtap="submitInviteCode">
            <text>确认</text>
          </view>
        </view>
      </view>
      
      <!-- 已邀请用户列表入口 -->
      <view class="invited-list-entry" bindtap="showInvitedList">
        <text class="invited-title">已邀请用户列表 ></text>
      </view>
    </view>
  </view>

</view>
