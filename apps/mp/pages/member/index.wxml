<view class="container redesign-bg">
  <view class="hero-bg-lux-member"></view>
  
  <!-- 1. 用户信息区域 (沉浸式) -->
  <view class="premium-user-box" bindtap="onUserInfoClick">
    <view class="avatar-border">
      <image class="user-avatar" src="{{userInfo.avatar}}" />
    </view>
    <view class="user-details">
      <text class="user-nickname">{{userInfo.nickname}}</text>
      <view class="user-id-badge">
        <text class="id-label">UID:</text>
        <text class="id-value">{{userInfo.id}}</text>
      </view>
    </view>
  </view>

  <!-- 2. 会员身份与数据展示 (毛玻璃卡片) -->
  <view class="luxury-card glass-panel gold-border shadow-lux">
    <view class="card-top">
      <view class="level-box">
        <text class="level-v">V</text>
        <text class="level-num">1</text>
        <text class="level-title">皇家会员</text>
      </view>
      <view class="growth-box">
        <text class="growth-text">距下一等级 {{memberInfo.nextLevelDiff}} 成长值</text>
        <view class="growth-bar">
          <view class="growth-inner" style="width: 20%"></view>
        </view>
      </view>
    </view>
    
    <!-- 数据统计区 -->
    <view class="premium-stats">
      <view class="stat-item">
        <text class="stat-val font-bold text-gold">{{stats.coins}}</text>
        <text class="stat-name">金币余额</text>
      </view>
      <view class="stat-item scale-up">
        <text class="stat-val font-bold text-gold">{{stats.points}}</text>
        <text class="stat-name">累计积分</text>
      </view>
      <view class="stat-item">
        <text class="stat-val font-bold text-gold">{{stats.coupons}}</text>
        <text class="stat-name">礼遇券</text>
      </view>
    </view>

    <!-- 核心操作按钮 -->
    <button class="btn-primary main-recharge" bindtap="onRecharge">立即充值</button>
    
    <!-- 快捷功能区 (线性布局) -->
    <view class="quick-nav">
      <view class="nav-item" bindtap="showDepositDialog">
        <view class="icon-circle gold-border shimmer-effect">
          <view class="css-icon-in"></view>
        </view>
        <text>存分</text>
      </view>
      <view class="nav-item" bindtap="showWithdrawDialog">
        <view class="icon-circle gold-border shimmer-effect">
          <view class="css-icon-out"></view>
        </view>
        <text>取分</text>
      </view>
      <view class="nav-item" bindtap="showExchangeDialog">
        <view class="icon-circle gold-border shimmer-effect">
          <view class="css-icon-exchange"></view>
        </view>
        <text>兑换</text>
      </view>
    </view>
  </view>

  <!-- 3. 功能菜单 (分组展示) -->
  <view class="menu-container">
    <view class="menu-group-title">我的服务</view>
    <view class="premium-menu glass-panel">
      <block wx:for="{{menuList}}" wx:key="text">
        <view class="premium-menu-item" bindtap="onMenuClick" data-index="{{index}}">
          <view class="menu-info">
            <view class="menu-icon-wrapper"></view>
            <text class="menu-label">{{item.text}}</text>
          </view>
          <view class="menu-arrow-icon"></view>
        </view>
      </block>
    </view>
  </view>

  <!-- 登出区域 -->
  <view class="logout-wrapper" wx:if="{{isLogin}}">
    <button class="btn-secondary logout-btn-new" bindtap="onLogout">退出当前账户</button>
  </view>

  <!-- 底部占位 -->
  <view style="height: 120rpx;"></view>
  <tab-bar selected="3"></tab-bar>

  <!-- ================= 弹窗重构 (基于全局样式) ================= -->
  
  <!-- 充值弹窗 -->
  <view class="modal-mask" wx:if="{{showRechargePopup}}" bindtap="hideRecharge">
    <view class="luxury-modal glass-panel gold-border" catchtap="true">
      <view class="modal-head">充值金币</view>
      
      <view class="premium-grid">
        <view wx:for="{{rechargeOptions}}" wx:key="amount" 
              class="grid-item {{selectedAmount === item.amount ? 'active-grid' : ''}}" 
              bindtap="selectAmount" data-amount="{{item.amount}}">
          <text class="grid-val">¥{{item.amount}}</text>
          <text class="grid-sub">{{item.desc}}</text>
        </view>
      </view>

      <view class="input-luxury container">
        <input class="lux-input" type="number" placeholder="输入其他金额" 
               placeholder-class="lux-placeholder" value="{{inputAmount}}" 
               bindinput="onInputAmount" />
        <view class="lux-bonus">赠送 {{selectedAmount ? (selectedAmount * 15) : (inputAmount * 15 || 0)}} 积分</view>
      </view>

      <view class="modal-btns">
        <view class="btn-cancel" bindtap="hideRecharge">取消</view>
        <view class="btn-confirm" bindtap="submitRecharge">立即支付</view>
      </view>
    </view>
  </view>

  <!-- 存积分弹窗 -->
  <view class="modal-mask" wx:if="{{showDepositPopup}}" bindtap="hideDepositDialog">
    <view class="luxury-modal glass-panel gold-border" catchtap="stopBubble">
      <view class="modal-head">存储积分</view>
      <view class="input-luxury">
        <input class="lux-input" type="number" placeholder="请输入存入数量" 
               value="{{depositAmount}}" bindinput="onDepositInput" />
      </view>
      <view class="lux-rules">
        <text>• 5000以内 1:1 退回</text>
        <text>• 超出部分 1000:1 兑换抽奖</text>
      </view>
      <view class="modal-btns">
        <view class="btn-cancel" bindtap="hideDepositDialog">返回</view>
        <view class="btn-confirm" bindtap="submitDeposit">确认提交</view>
      </view>
    </view>
  </view>

</view>
