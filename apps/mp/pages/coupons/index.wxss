/* Pages/coupons/index.wxss */
page {
  background-color: #080808;
}

.container {
  min-height: 100vh;
}

/* 1. 标签页 (Redesign Standard) */
.tabs {
  display: flex;
  background: rgba(8, 8, 8, 0.9);
  backdrop-filter: blur(20rpx);
  padding: 0 40rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 34rpx 0;
  position: relative;
}

.tab-text {
  font-size: 26rpx;
  color: #444;
  letter-spacing: 2rpx;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #D4AF37;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 2rpx;
  background: #D4AF37;
  box-shadow: 0 0 10rpx #D4AF37;
}

/* 2. 列表容器 */
.list-container {
  padding: 40rpx 30rpx;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 券面视觉 */
.coupon-lux {
  display: flex;
  height: 220rpx;
  position: relative;
}

/* 左侧：面值 */
.coupon-side-l {
  width: 200rpx;
  background: linear-gradient(135deg, #111, #000);
  border: 1rpx solid rgba(212, 175, 55, 0.2);
  border-right: 2rpx dashed rgba(212, 175, 55, 0.1);
  border-radius: 20rpx 0 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.side-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.val-box {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.val-cur { font-size: 24rpx; color: #D4AF37; margin-right: 4rpx; }
.val-num { font-size: 60rpx; font-weight: 800; line-height: 1; }
.val-unit { font-size: 24rpx; color: #D4AF37; margin-left: 4rpx; }

.side-label {
  font-size: 14rpx;
  color: #333;
  letter-spacing: 6rpx;
  font-weight: 800;
}

/* 缺口效果 */
.notch-top, .notch-bottom {
  position: absolute;
  right: -10rpx;
  width: 10rpx; height: 10rpx;
  background: #080808; /* 背景色 */
}
.notch-top { top: -2rpx; border-radius: 0 0 0 10rpx; border-left: 1rpx solid rgba(212, 175, 55, 0.2); border-bottom: 1rpx solid rgba(212, 175, 55, 0.2); }
.notch-bottom { bottom: -2rpx; border-radius: 10rpx 0 0 0; border-left: 1rpx solid rgba(212, 175, 55, 0.2); border-top: 1rpx solid rgba(212, 175, 55, 0.2); }

/* 右侧：详情 */
.coupon-side-r {
  flex: 1;
  border-radius: 0 20rpx 20rpx 0;
  border-left: none !important;
  display: flex;
  flex-direction: column;
  padding: 30rpx;
}

.r-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.c-name {
  font-size: 28rpx;
  color: #EEE;
  font-weight: 700;
  display: block;
}

.v-level-tag {
  font-size: 14rpx;
  color: #000;
  background: #D4AF37;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-weight: 900;
  margin-top: 6rpx;
  display: inline-block;
}

.status-dot-badge {
  font-size: 18rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
}
.status-AVAILABLE { color: #22C55E; }
.status-USED { color: #444; }
.status-EXPIRED { color: #222; }

.c-desc {
  font-size: 20rpx;
  color: #555;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.r-footer {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.validity-box {
  display: flex;
  align-items: center;
}

.v-dot {
  width: 6rpx; height: 6rpx;
  background: #333;
  border-radius: 50%;
  margin-right: 12rpx;
}

.validity-box text {
  font-size: 18rpx;
  color: #333;
}

/* 按钮操作 */
.btn-lux-claim {
  background: #D4AF37;
  color: #000;
  font-size: 20rpx;
  font-weight: 800;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  line-height: 1;
}

.btn-lux-use {
  background: rgba(212, 175, 55, 0.05);
  border: 1rpx solid #D4AF37;
  color: #D4AF37;
  font-size: 20rpx;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  line-height: 1;
}

.btn-disabled {
  background: #111;
  color: #222;
}

/* 无效券视觉衰减 */
.lux-inactive .val-num { opacity: 0.2; }
.lux-inactive .c-name { color: #333; }
.lux-inactive .coupon-side-r { opacity: 0.5; }

/* 空状态 */
.empty-lux-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.css-icon-ticket-empty {
  width: 100rpx; height: 60rpx;
  border: 4rpx solid rgba(212, 175, 55, 0.1);
  border-radius: 8rpx;
  margin-bottom: 40rpx;
  position: relative;
}
.css-icon-ticket-empty::after {
  content: "";
  position: absolute;
  top: 15rpx; left: 20rpx;
  width: 60rpx; height: 30rpx;
  border-top: 2rpx dashed rgba(212, 175, 55, 0.1);
}

.empty-text {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 60rpx;
  letter-spacing: 4rpx;
}

.btn-goto-available {
  background: linear-gradient(135deg, #D4AF37, #B8860B);
  color: #000;
  font-size: 26rpx;
  font-weight: 700;
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
}