/* Pages/coupons/index.wxss */
page {
  background-color: #050506;
}

.container {
  min-height: 100vh;
}

/* 1. 标签页 (Redesign Standard) */
.tabs {
  display: flex;
  background: rgba(8, 8, 8, 0.9);
  backdrop-filter: blur(20rpx);
  padding: 0 40rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 34rpx 0;
  position: relative;
}

.tab-text {
  font-size: 26rpx;
  color: #444;
  letter-spacing: 2rpx;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #E6C678;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 2rpx;
  background: #E6C678;
  box-shadow: 0 0 10rpx #E6C678;
}

/* 2. 列表容器 */
.list-container {
  padding: 40rpx 30rpx;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 券面视觉 */
.coupon-lux {
  display: flex;
  height: 220rpx;
  position: relative;
}

/* 左侧：面值 */
.coupon-side-l {
  width: 200rpx;
  background: linear-gradient(135deg, #111, #000);
  border: 1rpx solid rgba(230, 198, 120, 0.2);
  border-right: 2rpx dashed rgba(230, 198, 120, 0.1);
  border-radius: 20rpx 0 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.side-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.val-box {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.val-cur { font-size: 24rpx; color: #E6C678; margin-right: 4rpx; }
.val-num { font-size: 60rpx; font-weight: 800; line-height: 1; }
.val-unit { font-size: 24rpx; color: #E6C678; margin-left: 4rpx; }

.side-label {
  font-size: 14rpx;
  color: #333;
  letter-spacing: 6rpx;
  font-weight: 800;
}

/* 缺口效果 */
.notch-top, .notch-bottom {
  position: absolute;
  right: -10rpx;
  width: 10rpx; height: 10rpx;
  background: #050506; /* 背景色 */
}
.notch-top { top: -2rpx; border-radius: 0 0 0 10rpx; border-left: 1rpx solid rgba(230, 198, 120, 0.2); border-bottom: 1rpx solid rgba(230, 198, 120, 0.2); }
.notch-bottom { bottom: -2rpx; border-radius: 10rpx 0 0 0; border-left: 1rpx solid rgba(230, 198, 120, 0.2); border-top: 1rpx solid rgba(230, 198, 120, 0.2); }

/* 右侧：详情 */
.coupon-side-r {
  flex: 1;
  border-radius: 0 20rpx 20rpx 0;
  border-left: none !important;
  display: flex;
  flex-direction: column;
  padding: 30rpx;
}

.r-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.c-name {
  font-size: 28rpx;
  color: #EEE;
  font-weight: 700;
  display: block;
}

.v-level-tag {
  font-size: 14rpx;
  color: #000;
  background: #E6C678;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-weight: 900;
  margin-top: 6rpx;
  display: inline-block;
}

.status-dot-badge {
  font-size: 18rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
}
.status-AVAILABLE { color: #22C55E; }
.status-USED { color: #444; }
.status-EXPIRED { color: #222; }

.c-desc {
  font-size: 20rpx;
  color: #555;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.r-footer {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.validity-box {
  display: flex;
  align-items: center;
}

.v-dot {
  width: 6rpx; height: 6rpx;
  background: #333;
  border-radius: 50%;
  margin-right: 12rpx;
}

.validity-box text {
  font-size: 18rpx;
  color: #333;
}

/* 按钮操作 */
.btn-lux-claim {
  background: #E6C678;
  color: #000;
  font-size: 20rpx;
  font-weight: 800;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  line-height: 1;
}

.btn-lux-use {
  background: rgba(230, 198, 120, 0.05);
  border: 1rpx solid #E6C678;
  color: #E6C678;
  font-size: 20rpx;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
  line-height: 1;
}

.btn-disabled {
  background: #111;
  color: #222;
}

/* 无效券视觉衰减 */
.lux-inactive .val-num { opacity: 0.2; }
.lux-inactive .c-name { color: #333; }
.lux-inactive .coupon-side-r { opacity: 0.5; }

/* 空状态 */
.empty-lux-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.css-icon-ticket-empty {
  width: 100rpx; height: 60rpx;
  border: 4rpx solid rgba(230, 198, 120, 0.1);
  border-radius: 8rpx;
  margin-bottom: 40rpx;
  position: relative;
}
.css-icon-ticket-empty::after {
  content: "";
  position: absolute;
  top: 15rpx; left: 20rpx;
  width: 60rpx; height: 30rpx;
  border-top: 2rpx dashed rgba(230, 198, 120, 0.1);
}

.empty-text {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 60rpx;
  letter-spacing: 4rpx;
}

.btn-goto-available {
  background: linear-gradient(135deg, #E6C678, #8C6A2F);
  color: #000;
  font-size: 26rpx;
  font-weight: 700;
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.redeem-modal {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 38rpx 32rpx 42rpx;
  border-radius: 28rpx;
  background: rgba(11, 10, 10, 0.96);
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  color: #E6C678;
  font-weight: 900;
  text-align: center;
}

.modal-subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.48);
  text-align: center;
}

.redeem-section-title {
  margin: 34rpx 0 18rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.76);
  font-weight: 700;
}

.redeem-option-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.redeem-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(230, 198, 120, 0.18);
  background: rgba(255, 255, 255, 0.05);
}

.redeem-option.active {
  border-color: #E6C678;
  background: rgba(230, 198, 120, 0.12);
  box-shadow: 0 0 24rpx rgba(230, 198, 120, 0.14);
}

.redeem-name {
  font-size: 28rpx;
  color: #fff;
  font-weight: 800;
}

.redeem-desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
}

.redeem-count {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(202, 72, 52, 0.28);
  color: #F5D98A;
  font-size: 20rpx;
}

.redeem-table-list {
  white-space: nowrap;
}

.redeem-table {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  height: 62rpx;
  margin-right: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(230, 198, 120, 0.18);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.68);
  background: rgba(255, 255, 255, 0.05);
  font-size: 24rpx;
}

.redeem-table.active {
  color: #101010;
  background: linear-gradient(135deg, #F3D989, #A98037);
  border-color: transparent;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 38rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.btn-cancel {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.68);
}

.btn-confirm {
  background: linear-gradient(135deg, #F3D989, #A98037);
  color: #101010;
}
