/* pages/table/index.wxss */
page {
  background-color: #080808;
  padding-bottom: 120rpx;
}

.container {
  padding: 30rpx;
}

/* --- 1. 顶部导航栏 --- */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 50rpx;
}

.store-name {
  color: #D4AF37;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-shadow: 0 0 20rpx rgba(212, 175, 55, 0.3);
}

.rule-btn {
  background: rgba(212, 175, 55, 0.1);
  color: #D4AF37;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
}

/* --- 2. 牌桌区域 --- */
.table-section {
  margin-bottom: 60rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.main-title {
  color: #FDFDFD;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.update-time {
  color: #666;
  font-size: 20rpx;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.05);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #D4AF37;
  border-radius: 50%;
  box-shadow: 0 0 15rpx #D4AF37;
  animation: dotPulse 1.5s infinite;
}

@keyframes dotPulse {
  0% { transform: scale(1); opacity: 1; box-shadow: 0 0 10rpx #D4AF37; }
  50% { transform: scale(1.4); opacity: 0.6; box-shadow: 0 0 25rpx #D4AF37; }
  100% { transform: scale(1); opacity: 1; box-shadow: 0 0 10rpx #D4AF37; }
}

.status-badge text {
  font-size: 22rpx;
  color: #D4AF37;
}

/* 信息卡片 */
.info-card {
  display: flex;
  justify-content: space-around;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.label {
  color: #666;
  font-size: 20rpx;
  text-transform: uppercase;
}

.value {
  color: #D4AF37;
  font-size: 32rpx;
  font-weight: 700;
}

.divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(212, 175, 55, 0.1);
}

/* 牌桌视图 */
.poker-table-container {
  position: relative;
  width: 100%;
  height: 900rpx;
  background: radial-gradient(circle at center, #1a1a1a 0%, #050505 100%);
  border-radius: 400rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.2);
  box-shadow: 
    0 40rpx 80rpx rgba(0,0,0,0.9), 
    inset 0 0 60rpx rgba(0,0,0,0.8),
    inset 0 0 100rpx rgba(212, 175, 55, 0.05);
  overflow: visible;
}

/* 牌桌底部氛围发光 */
.poker-table-container::after {
  content: "";
  position: absolute;
  top: 50%; left: 50%;
  width: 110%; height: 110%;
  background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.08) 0%, transparent 75%);
  transform: translate(-50%, -50%);
  z-index: 0;
  pointer-events: none;
}

.table-bg {
  width: 90%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.1;
  z-index: 1;
}

/* 座位布局 */
.seat {
  position: absolute;
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  border: 4rpx solid #111;
  background: #111;
  box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.8);
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.seat.empty .avatar {
  border: 2rpx dashed rgba(212, 175, 55, 0.3);
  background: rgba(255, 255, 255, 0.02);
  box-shadow: none;
  animation: seatPulse 3s infinite ease-in-out;
}

@keyframes seatPulse {
  0%, 100% { transform: scale(1); opacity: 0.3; }
  50% { transform: scale(1.05); opacity: 0.6; box-shadow: 0 0 20rpx rgba(212, 175, 55, 0.1); }
}

.seat.playing .avatar {
  border-color: #D4AF37;
  box-shadow: 0 0 30rpx rgba(212, 175, 55, 0.4);
}

.seat.reserved .avatar {
  border-color: #409EFF;
  box-shadow: 0 0 30rpx rgba(64, 158, 255, 0.3);
}

.nickname {
  font-size: 20rpx;
  color: #888;
  margin-top: 10rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-number {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: #111;
  border: 1rpx solid #D4AF37;
  color: #D4AF37;
  font-size: 20rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: 700;
  z-index: 11;
}

/* 座位定位 (9人椭圆布局) */
.seat-1 { top: 0; left: 50%; transform: translate(-50%, -40rpx); }
.seat-2 { top: 15%; right: 5%; }
.seat-3 { top: 50%; right: -30rpx; transform: translateY(-50%); }
.seat-4 { bottom: 15%; right: 5%; }
.seat-5 { bottom: 0; left: 65%; transform: translate(-50%, 40rpx); }
.seat-6 { bottom: 0; left: 35%; transform: translate(-50%, 40rpx); }
.seat-7 { bottom: 15%; left: 5%; }
.seat-8 { top: 50%; left: -30rpx; transform: translateY(-50%); }
.seat-9 { top: 15%; left: 5%; }

/* 弹窗升级 */
.modal-content {
  width: 650rpx;
  padding: 50rpx;
}

.rules-title {
  color: #D4AF37;
  font-size: 36rpx;
  margin-bottom: 40rpx;
}

.rule-item {
  color: #888;
  font-size: 24rpx;
  line-height: 1.8;
}
