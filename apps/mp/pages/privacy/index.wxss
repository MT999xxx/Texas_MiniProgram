.container {
  padding: 32rpx;
  background: linear-gradient(180deg, #120a0a 0%, #1a0e0e 100%);
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #d4af37;
  text-align: center;
  margin-bottom: 40rpx;
}

.update-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-bottom: 40rpx;
}

.intro {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.8;
  margin-bottom: 40rpx;
  padding: 24rpx;
  background: rgba(230, 198, 120, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid rgba(230, 198, 120, 0.2);
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #d4af37;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #d4af37;
}

.section-content {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.8;
}

.info-table {
  margin: 20rpx 0;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 8rpx;
  overflow: hidden;
}

.info-row {
  display: flex;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 200rpx;
  padding: 20rpx;
  background: rgba(230, 198, 120, 0.1);
  color: #d4af37;
  font-weight: 500;
}

.info-value {
  flex: 1;
  padding: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

.highlight {
  color: #d4af37;
}

.footer {
  margin-top: 60rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid rgba(230, 198, 120, 0.2);
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}
