/* Pages/order-detail/index.wxss */
page {
  background-color: #080808;
}

.container {
  min-height: 100vh;
  padding: 30rpx;
}

/* 加载渲染 */
.loading-lux {
  width: 40rpx; height: 40rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.2);
  border-top-color: #D4AF37;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 详情布局 */
.detail-container {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-bottom: 200rpx;
}

/* 1. 状态英雄位 */
.status-hero {
  padding: 60rpx 40rpx;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.status-orb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 34rpx;
  position: relative;
  box-shadow: 0 0 30rpx rgba(0,0,0,0.5);
}

.status-orb-PENDING { background: radial-gradient(circle, #D4AF37, #B8860B); box-shadow: 0 0 40rpx rgba(212, 175, 55, 0.3); }
.status-orb-PAID { background: radial-gradient(circle, #22C55E, #166534); box-shadow: 0 0 40rpx rgba(34, 197, 94, 0.3); }
.status-orb-IN_PROGRESS { background: radial-gradient(circle, #3B82F6, #1D4ED8); box-shadow: 0 0 40rpx rgba(59, 130, 246, 0.3); }
.status-orb-COMPLETED { background: radial-gradient(circle, #AAA, #333); }

.status-main {
  flex: 1;
}

.status-title {
  font-size: 48rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 18rpx;
  color: #444;
  letter-spacing: 2rpx;
}

.order-sn-tag {
  position: absolute;
  top: 30rpx; right: 30rpx;
  font-size: 18rpx;
  color: #222;
  font-family: monospace;
}

/* 2. 通用区块项 */
.sec-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.sec-indicator {
  width: 4rpx; height: 24rpx;
  background: #D4AF37;
  margin-right: 16rpx;
  box-shadow: 0 0 10rpx #D4AF37;
}

.sec-title {
  font-size: 26rpx;
  color: #EEE;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 商品项 */
.item-lux {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.02);
}

.item-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-info .name {
  font-size: 28rpx;
  color: #DDD;
  display: block;
}

.item-info .spec {
  font-size: 20rpx;
  color: #444;
}

.item-price-box {
  text-align: right;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-price-box .qty {
  font-size: 24rpx;
  color: #555;
}

.item-price-box .price {
  font-size: 28rpx;
  font-weight: 600;
}

/* 费用汇总 */
.cost-summary {
  margin-top: 30rpx;
}

.cost-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.cost-row .l { font-size: 24rpx; color: #444; }
.cost-row .v { font-size: 24rpx; color: #888; }

.discount .v { color: #22C55E; }

.sum-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.05);
  margin: 20rpx 0;
}

.grand-total .l { font-size: 28rpx; color: #EEE; font-weight: 700; }
.grand-total .v { font-size: 36rpx; font-weight: 800; }

/* 3. 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.grid-item .l {
  font-size: 20rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.grid-item .v {
  font-size: 24rpx;
  color: #888;
}

.copy-v { color: #555 !important; font-family: monospace; }

/* 4. 极致流程 */
.lux-steps {
  padding-left: 20rpx;
}

.step-lux {
  display: flex;
  position: relative;
  padding-bottom: 50rpx;
}

.step-point {
  width: 20rpx;
  margin-right: 30rpx;
  display: flex;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.step-point .dot {
  width: 12rpx; height: 12rpx;
  background: #222;
  border-radius: 50%;
  margin-top: 10rpx;
  transition: all 0.3s;
}

.step-lux.completed .dot { background: #D4AF37; box-shadow: 0 0 10rpx #D4AF37; }
.step-lux.current .dot { background: #D4AF37; transform: scale(1.5); box-shadow: 0 0 20rpx #D4AF37; }

.step-line {
  position: absolute;
  left: 9rpx;
  top: 30rpx;
  bottom: 0;
  width: 2rpx;
  background: rgba(255, 255, 255, 0.03);
  z-index: 1;
}

.step-lux.completed .step-line { background: rgba(212, 175, 55, 0.1); }

.step-body .s-title {
  font-size: 26rpx;
  color: #444;
  display: block;
}

.step-lux.completed .s-title, .step-lux.current .s-title { color: #BBB; }

.step-body .s-time {
  font-size: 20rpx;
  color: #222;
}

/* 5. 底部动作位 */
.bottom-actions {
  position: fixed;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
  padding: 30rpx 40rpx;
  z-index: 100;
}

.full-btn-group {
  display: flex;
  gap: 20rpx;
}

.btn-lux {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 45rpx;
}

.btn-cancel-detail { border: 1rpx solid #222; color: #555; }
.btn-pay-detail { background: #D4AF37; color: #000; box-shadow: 0 10rpx 20rpx rgba(212, 175, 55, 0.2); }
.btn-contact-detail { border: 1rpx solid #D4AF37; color: #D4AF37; }
.btn-reorder-detail { background: rgba(255, 255, 255, 0.05); color: #BBB; }