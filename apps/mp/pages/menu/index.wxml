<view class="container redesign-bg">
  <view class="hero-bg-lux-menu"></view>
  <!-- 1. 沉浸式头部导航 -->
  <view class="header-bar glass-panel shadow-lux">
    <view class="brand-info">
      <text class="store-name text-gold-gradient font-bold">AAA CLUB</text>
      <text class="store-slogan">ROYAL POKER & BAR</text>
    </view>
  </view>

  <!-- 2. 桌位选择区 (极简金边) -->
  <view class="table-selector glass-panel gold-border">
    <view class="table-icon">📍</view>
    <scroll-view scroll-x class="table-scroll">
      <view 
        wx:for="{{tables}}" 
        wx:key="id" 
        class="table-item {{selectedTableId === item.id ? 'selected shadow-lux' : ''}}"
        bindtap="selectTable"
        data-table-id="{{item.id}}"
        data-table-name="{{item.name}}"
      >
        {{item.name}}
      </view>
    </scroll-view>
    <view class="selected-badge" wx:if="{{selectedTableName}}">
      {{selectedTableName}}
    </view>
  </view>

  <!-- 3. 点餐主区域 -->
  <view class="content-container">
    
    <!-- 左侧分类 (极暗侧边栏) -->
    <scroll-view scroll-y class="sidebar">
      <block wx:for="{{categories}}" wx:key="id">
        <view class="category-item {{currentCategory === index ? 'active' : ''}}" bindtap="switchCategory" data-index="{{index}}">
          <text class="cat-name">{{item.name}}</text>
          <view class="cat-indicator" wx:if="{{currentCategory === index}}"></view>
        </view>
      </block>
    </scroll-view>

    <!-- 右侧商品列表 -->
    <scroll-view scroll-y class="goods-list">
      <block wx:for="{{goodsList}}" wx:key="id">
        <view class="goods-item glass-panel gold-border shadow-lux">
          <image class="goods-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="goods-info">
            <text class="goods-name">{{item.name}}</text>
            <text class="goods-desc">{{item.description}}</text>
            <view class="price-row">
              <view class="price-box">
                <text class="price-unit">¥</text>
                <text class="goods-price">{{item.price}}</text>
              </view>
              <view class="add-btn-lux shimmer-effect" bindtap="addToCart" data-id="{{item.id}}" data-name="{{item.name}}" data-price="{{item.price}}" data-image-url="{{item.imageUrl}}" data-half-dozen-price="{{item.halfDozenPrice}}" data-dozen-price="{{item.dozenPrice}}">
                <view class="plus-icon"></view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view class="list-footer">名仕乐享 · 尽在三条A</view>
    </scroll-view>

  </view>

  <!-- 4. 尊享购物车底部栏 -->
  <view class="cart-bar glass-panel shadow-lux shimmer-effect" wx:if="{{cartCount > 0}}">
    <view class="cart-info" bindtap="toggleCart">
      <view class="cart-icon-box gold-border">
        <view class="css-cart-icon"></view>
        <view class="cart-badge">{{cartCount}}</view>
      </view>
      <view class="cart-price">
        <text class="total-label">合计</text>
        <text class="price-symbol">¥</text>
        <text class="price-value">{{cartAmount}}</text>
      </view>
    </view>
    <view class="checkout-btn-lux" bindtap="checkout">
      去结算
    </view>
  </view>

  <!-- 5. 购物车详情弹窗 (毛玻璃卡片) -->
  <view class="cart-detail {{showCart ? 'show' : ''}}" catchtap="hideCart">
    <view class="cart-content glass-panel gold-border" catchtap="stopPropagation">
      <view class="cart-header">
        <text class="text-gold font-bold">已选礼遇</text>
        <view class="clear-cart-box" bindtap="clearCart">
          <text class="clear-icon">🗑️</text>
          <text>清空</text>
        </view>
      </view>
      <scroll-view scroll-y class="cart-list">
        <block wx:for="{{cartItems}}" wx:key="id">
          <view class="cart-item">
            <view class="item-info">
              <text class="item-name">{{item.name}}</text>
              <view class="item-price-box">
                <text class="i-unit">¥</text>
                <text class="i-val">{{item.price}}</text>
              </view>
            </view>
            <view class="item-controls">
              <view class="control-btn-lux minus" bindtap="decreaseCart" data-id="{{item.id}}"></view>
              <text class="item-count">{{item.count}}</text>
              <view class="control-btn-lux plus" bindtap="increaseCart" data-id="{{item.id}}"></view>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <!-- 6. 规格选择弹窗 (极臻系列) -->
  <view class="modal-mask" wx:if="{{showSpecDialog}}" bindtap="hideSpecDialog">
    <view class="luxury-modal glass-panel gold-border" catchtap="stopBubble">
      <view class="spec-header-lux">
        <view class="spec-product-info">
          <image class="spec-product-image gold-border" src="{{specProduct.imageUrl}}" mode="aspectFill" />
          <view class="spec-product-detail">
            <text class="spec-product-name text-gold-gradient">{{specProduct.name}}</text>
            <view class="spec-product-price">
              <text class="s-unit">¥</text>
              <text class="s-val">{{specProduct.price}}</text>
              <text class="s-label">/瓶</text>
            </view>
          </view>
        </view>
        <view class="spec-close-btn" catchtap="hideSpecDialog">✕</view>
      </view>
      
      <scroll-view scroll-y class="spec-body-lux">
        <!-- 包装规格选择 -->
        <view class="spec-section">
          <text class="spec-label">品鉴规格</text>
          <view class="spec-options">
            <view 
              wx:for="{{packageOptions}}" 
              wx:key="value"
              class="spec-option {{selectedPackage === item.value ? 'selected shadow-lux' : ''}}"
              bindtap="selectPackage"
              data-value="{{item.value}}"
            >
              <text class="opt-label">{{item.label}}</text>
              <text class="opt-desc">{{item.quantity}}瓶</text>
              <text class="opt-price" wx:if="{{item.value !== 'single'}}">¥{{item.totalPrice}}</text>
            </view>
          </view>
        </view>

        <!-- 温度选择 -->
        <view class="spec-section">
          <text class="spec-label">侍酒温度</text>
          <view class="spec-options">
            <view 
              wx:for="{{temperatureOptions}}" 
              wx:key="value"
              class="spec-option {{selectedTemperature === item.value ? 'selected shadow-lux' : ''}}"
              bindtap="selectTemperature"
              data-value="{{item.value}}"
            >
              <text class="opt-label">{{item.label}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="spec-footer-lux">
        <view class="spec-price-info">
          <text class="spec-total-label">尊享小计</text>
          <text class="spec-total-val text-gold">¥{{specTotalPrice}}</text>
        </view>
        <button class="btn-primary spec-confirm-btn-lux shimmer-effect" bindtap="confirmAddSpec">加入购物车</button>
      </view>
    </view>
  </view>

</view>
