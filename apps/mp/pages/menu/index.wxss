/* pages/menu/index.wxss */
page {
  background-color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* --- 头部区域 --- */
.header-bar {
  padding: 20rpx 30rpx;
  background-color: #1c1c1e;
  border-bottom: 1rpx solid #333;
}

.store-name {
  color: #8b0000;
  font-size: 32rpx;
  font-weight: bold;
}

/* --- 桌位选择器 --- */
.table-selector {
  padding: 16rpx 30rpx;
  background-color: #1c1c1e;
  border-bottom: 1rpx solid #333;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.table-label {
  color: #999;
  font-size: 26rpx;
  white-space: nowrap;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.table-scroll {
  flex: 1;
  white-space: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.table-scroll::-webkit-scrollbar {
  display: none;
}

.table-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  background-color: #2c2c2e;
  color: #ccc;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
  white-space: nowrap;
}

.table-item.selected {
  background-color: #8b0000;
  color: #fff;
  border-color: #cc0000;
}

.selected-table {
  color: #8b0000;
  font-size: 24rpx;
  white-space: nowrap;
  margin-left: 16rpx;
  flex-shrink: 0;
}


/* --- 内容区域 --- */
.content-container {
  flex: 1;
  display: flex;
  overflow: hidden;
  margin-bottom: 120rpx;
}

/* --- 左侧侧边栏 --- */
.sidebar {
  width: 180rpx;
  background-color: #1a1a1a;
  height: 100%;
}

.category-item {
  padding: 40rpx 20rpx;
  text-align: center;
  color: #996666;
  font-size: 28rpx;
  border-bottom: 1rpx solid #330000;
}

.category-item.active {
  background-color: #8b0000;
  color: #fff;
  font-weight: bold;
}

/* --- 右侧商品列表 --- */
.goods-list {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.goods-item {
  display: flex;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #330000;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  background-color: #222;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  color: #cc3333;
  font-size: 32rpx;
  font-weight: bold;
}

.goods-desc {
  color: #996666;
  font-size: 24rpx;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.goods-price {
  color: #8b0000;
  font-size: 36rpx;
  font-weight: bold;
}

.add-btn {
  width: 50rpx;
  height: 50rpx;
  background-color: #8b0000;
  border-radius: 50%;
  color: #fff;
  font-size: 40rpx;
  line-height: 46rpx;
  text-align: center;
  font-weight: bold;
}

/* --- 购物车底部栏 --- */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #1a1a1a;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.5);
  z-index: 100;
  border-top: 1rpx solid #330000;
}

.cart-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.cart-icon-wrapper {
  position: relative;
  margin-right: 20rpx;
}

.cart-icon {
  width: 60rpx;
  height: 60rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  background-color: #8b0000;
  border-radius: 16rpx;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.cart-price {
  color: #cc3333;
}

.price-symbol {
  font-size: 24rpx;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
  margin-left: 4rpx;
}

.checkout-btn {
  width: 200rpx;
  height: 70rpx;
  background-color: #333;
  color: #996666;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
}

.checkout-btn.active {
  background-color: #8b0000;
  color: #fff;
}

/* --- 购物车详情弹窗 --- */
.cart-detail {
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  height: 70%;
  background-color: rgba(0, 0, 0, 0.5);
  transition: bottom 0.3s ease;
  z-index: 999;
}

.cart-detail.show {
  bottom: 0;
}

.cart-content {
  position: absolute;
  bottom: 100rpx;
  left: 0;
  right: 0;
  height: calc(100% - 100rpx);
  background-color: #1a1a1a;
  border-radius: 30rpx 30rpx 0 0;
  padding: 30rpx;
  border: 1rpx solid #330000;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #330000;
  color: #cc3333;
  font-size: 32rpx;
  font-weight: bold;
}

.clear-cart {
  color: #996666;
  font-size: 28rpx;
  font-weight: normal;
}

.cart-list {
  height: calc(100% - 80rpx);
  margin-top: 20rpx;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #330000;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-name {
  color: #cc3333;
  font-size: 30rpx;
  margin-bottom: 10rpx;
}

.item-price {
  color: #8b0000;
  font-size: 28rpx;
}

.item-controls {
  display: flex;
  align-items: center;
}

.control-btn {
  width: 50rpx;
  height: 50rpx;
  background-color: #333;
  border-radius: 50%;
  color: #cc3333;
  font-size: 36rpx;
  line-height: 46rpx;
  text-align: center;
  font-weight: bold;
}

.item-count {
  width: 60rpx;
  text-align: center;
  color: #cc3333;
  font-size: 30rpx;
  margin: 0 20rpx;
}

/* ==== 规格选择弹窗样式 ==== */
.spec-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: none;
  align-items: flex-end;
  z-index: 9999;
}

.spec-dialog.show {
  display: flex;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.spec-content {
  width: 100%;
  max-height: 80vh;
  background-color: #1a1a1a;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.spec-header {
  padding: 40rpx 40rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #333;
}

.spec-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #8b0000;
}

.spec-close {
  font-size: 56rpx;
  color: #999;
  line-height: 1;
  padding: 0 16rpx;
}

.spec-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx 40rpx;
}

.spec-product-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 24rpx;
  background-color: #222;
  border-radius: 20rpx;
}

.spec-product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.spec-product-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.spec-product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.spec-product-price {
  font-size: 28rpx;
  color: #8b0000;
  font-weight: 600;
}

.spec-section {
  margin-bottom: 48rpx;
}

.spec-label {
  display: block;
  font-size: 28rpx;
  color: #cc9999;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.spec-option {
  flex: 1;
  min-width: calc(50% - 10rpx);
  padding: 28rpx 24rpx;
  background-color: #222;
  border: 2rpx solid #333;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.3s ease;
}

.spec-option.selected {
  background-color: rgba(139, 0, 0, 0.15);
  border-color: #8b0000;
  box-shadow: 0 0 20rpx rgba(139, 0, 0, 0.3);
}

.option-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.spec-option.selected .option-label {
  color: #8b0000;
}

.option-desc {
  font-size: 24rpx;
  color: #999;
}

.option-price {
  font-size: 26rpx;
  color: #8b0000;
  font-weight: 600;
  margin-top: 4rpx;
}

.spec-footer {
  padding: 32rpx 40rpx;
  background-color: #1a1a1a;
  border-top: 1rpx solid #333;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.spec-price-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.spec-total-label {
  font-size: 28rpx;
  color: #999;
}

.spec-total-price {
  font-size: 44rpx;
  font-weight: bold;
  color: #8b0000;
  font-family: 'DIN Alternate', sans-serif;
}

.spec-confirm-btn {
  flex: 1;
  padding: 28rpx 0;
  background: linear-gradient(135deg, #8b0000, #4a0e0e);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 0, 0, 0.4);
  transition: all 0.3s ease;
}

.spec-confirm-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(139, 0, 0, 0.3);
}
