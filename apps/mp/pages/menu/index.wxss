/* pages/menu/index.wxss */
page {
  background-color: #080808;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  height: 100%;
  position: relative;
  z-index: 10;
}

/* 0. 背景层优化 */
.hero-bg-lux-menu {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  background: 
    radial-gradient(circle at 10% 10%, rgba(212, 175, 55, 0.05) 0%, transparent 40%),
    radial-gradient(circle at 90% 90%, rgba(26, 21, 10, 0.5) 0%, #080808 100%);
}

/* --- 1. 沉浸式头部 --- */
.header-bar {
  padding: 40rpx 30rpx 20rpx;
  background: rgba(8, 8, 8, 0.6) !important;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  justify-content: center;
}

.brand-info {
  text-align: center;
}

.store-name {
  font-size: 40rpx;
  letter-spacing: 12rpx;
  display: block;
}

.store-slogan {
  font-size: 14rpx;
  color: #444;
  letter-spacing: 8rpx;
  font-weight: 300;
  margin-top: 4rpx;
}

/* --- 2. 桌位选择区 --- */
.table-selector {
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.02) !important;
  display: flex;
  align-items: center;
  border-radius: 0 !important;
  border-left: none !important;
  border-right: none !important;
}

.table-icon {
  font-size: 24rpx;
  margin-right: 20rpx;
  opacity: 0.6;
}

.table-scroll {
  flex: 1;
  white-space: nowrap;
}

.table-item {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  background: rgba(255, 255, 255, 0.03);
  color: #666;
  font-size: 22rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  transition: all 0.3s;
}

.table-item.selected {
  background: #D4AF37 !important;
  color: #000 !important;
  border-color: #F9E498 !important;
  font-weight: 600;
}

.selected-badge {
  color: #D4AF37;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  background: rgba(212, 175, 55, 0.1);
  border-radius: 20rpx;
  margin-left: 10rpx;
}

/* --- 3. 内容区域 --- */
.content-container {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 侧边栏 */
.sidebar {
  width: 160rpx;
  background-color: #050505;
  height: 100%;
}

.category-item {
  padding: 44rpx 20rpx;
  position: relative;
  text-align: center;
  transition: all 0.2s;
}

.cat-name {
  font-size: 24rpx;
  color: #555;
  letter-spacing: 2rpx;
}

.category-item.active {
  background: rgba(212, 175, 55, 0.02);
}

.category-item.active .cat-name {
  color: #D4AF37;
  font-weight: 600;
}

.cat-indicator {
  position: absolute;
  left: 0; top: 30%; height: 40%;
  width: 4rpx;
  background: #D4AF37;
  box-shadow: 0 0 10rpx #D4AF37;
}

/* 商品列表 */
.goods-list {
  flex: 1;
  height: 100%;
  padding: 30rpx;
  box-sizing: border-box;
}

.goods-item {
  display: flex;
  padding: 30rpx 24rpx;
  margin-bottom: 30rpx;
  border-radius: 30rpx;
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.015);
  border: 1rpx solid rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.2);
}

.goods-item::after {
  content: "";
  position: absolute;
  top: 0; right: 0; width: 60rpx; height: 60rpx;
  background: radial-gradient(circle at top right, rgba(212, 175, 55, 0.1), transparent 70%);
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  background: #111;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  color: #EEE;
  font-size: 30rpx;
  font-weight: 600;
}

.goods-desc {
  font-size: 20rpx;
  color: #555;
  line-height: 1.4;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.price-unit {
  font-size: 22rpx;
  color: #D4AF37;
  margin-right: 4rpx;
}

.goods-price {
  font-size: 38rpx;
  color: #D4AF37;
  font-weight: 700;
  font-family: 'SF Pro Text', sans-serif;
}

.add-btn-lux {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 15rpx rgba(212, 175, 55, 0.3);
}

.plus-icon {
  width: 24rpx;
  height: 4rpx;
  background: #000;
  border-radius: 2rpx;
  position: relative;
}

.plus-icon::after {
  content: "";
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: #000;
  transform: rotate(90deg);
  border-radius: 2rpx;
}

.list-footer {
  text-align: center;
  font-size: 18rpx;
  color: #222;
  padding: 40rpx 0;
  letter-spacing: 10rpx;
}

/* --- 4. 底部购物车栏 --- */
.cart-bar {
  position: fixed;
  bottom: 40rpx;
  left: 30rpx; right: 30rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  z-index: 1000;
  border-radius: 100rpx;
}

.cart-icon-box {
  width: 90rpx;
  height: 90rpx;
  background: #000;
  border-radius: 50%;
  margin-top: -46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.8);
}

.css-cart-icon {
  width: 36rpx;
  height: 30rpx;
  border: 4rpx solid #D4AF37;
  border-top: none;
  border-radius: 4rpx 4rpx 10rpx 10rpx;
  position: relative;
}

.css-cart-icon::before {
  content: "";
  position: absolute;
  top: -10rpx; left: 6rpx;
  width: 20rpx; height: 10rpx;
  border: 3rpx solid #D4AF37;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.cart-badge {
  position: absolute;
  top: -8rpx; right: -8rpx;
  min-width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #B22222, #8b0000);
  border-radius: 50%;
  color: #FFF;
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 4rpx 10rpx rgba(178, 34, 34, 0.5);
}

.cart-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.cart-price {
  margin-left: 24rpx;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 20rpx;
  color: #666;
  margin-right: 12rpx;
}

.price-symbol {
  font-size: 24rpx;
  color: #D4AF37;
}

.price-value {
  font-size: 48rpx;
  color: #D4AF37;
  font-weight: 800;
  font-family: 'SF Pro Display', sans-serif;
  margin-left: 4rpx;
}

.checkout-btn-lux {
  height: 76rpx;
  padding: 0 60rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
  color: #000;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 25rpx rgba(212, 175, 55, 0.3);
  position: relative;
  overflow: hidden;
}

.checkout-btn-lux::after {
  content: "";
  position: absolute;
  top: 0; left: -100%; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: btnShimmer 3s infinite;
}

@keyframes btnShimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* --- 5. 购物车详情弹窗 --- */
.cart-detail {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10rpx);
  z-index: 1001;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s;
}

.cart-detail.show {
  visibility: visible;
  opacity: 1;
}

.cart-content {
  position: absolute;
  bottom: 160rpx;
  left: 30rpx; right: 30rpx;
  max-height: 60vh;
  padding: 40rpx;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.clear-cart-box {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #444;
}

.clear-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.cart-list {
  flex: 1;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.02);
}

.item-name {
  font-size: 28rpx;
  color: #CCC;
  margin-bottom: 6rpx;
  display: block;
}

.item-price-box {
  display: flex;
  align-items: baseline;
}

.i-unit { font-size: 18rpx; color: #D4AF37; margin-right: 4rpx; }
.i-val { font-size: 26rpx; color: #D4AF37; font-weight: 600; }

.item-controls {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.control-btn-lux {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.control-btn-lux.minus::after {
  content: "";
  width: 16rpx; height: 2rpx;
  background: #D4AF37;
}

.control-btn-lux.plus::after, .control-btn-lux.plus::before {
  content: "";
  position: absolute;
  background: #D4AF37;
}

.control-btn-lux.plus::after { width: 16rpx; height: 2rpx; }
.control-btn-lux.plus::before { width: 2rpx; height: 16rpx; }

.item-count {
  font-size: 28rpx;
  color: #EEE;
  min-width: 40rpx;
  text-align: center;
}

/* --- 6. 规格选择弹窗 --- */
.spec-header-lux {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 50rpx;
}

.spec-product-info {
  display: flex;
  align-items: center;
}

.spec-product-image {
  width: 130rpx;
  height: 130rpx;
  border-radius: 20rpx;
  margin-right: 30rpx;
  background: #111;
}

.spec-product-detail {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.spec-product-name {
  font-size: 36rpx;
  font-weight: 700;
}

.spec-product-price {
  display: flex;
  align-items: baseline;
}

.s-unit { font-size: 22rpx; color: #D4AF37; margin-right: 4rpx; }
.s-val { font-size: 34rpx; color: #D4AF37; font-weight: 700; }
.s-label { font-size: 18rpx; color: #444; margin-left: 8rpx; }

.spec-close-btn {
  font-size: 40rpx;
  color: #333;
  padding: 10rpx;
}

.spec-body-lux {
  max-height: 50vh;
}

.spec-section {
  margin-bottom: 44rpx;
}

.spec-label {
  font-size: 24rpx;
  color: #444;
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: 2rpx;
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.spec-option {
  flex: 1;
  min-width: calc(33.33% - 14rpx);
  padding: 24rpx 10rpx;
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s;
}

.spec-option.selected {
  background: rgba(212, 175, 55, 0.08) !important;
  border-color: #D4AF37 !important;
}

.opt-label { font-size: 26rpx; color: #888; margin-bottom: 4rpx; }
.spec-option.selected .opt-label { color: #D4AF37; font-weight: 600; }

.opt-desc { font-size: 18rpx; color: #444; }
.opt-price { font-size: 20rpx; color: #D4AF37; margin-top: 6rpx; opacity: 0.8; }

.spec-footer-lux {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30rpx;
}

.spec-price-info {
  display: flex;
  flex-direction: column;
}

.spec-total-label { font-size: 18rpx; color: #444; }
.spec-total-val { font-size: 44rpx; font-weight: 800; }

.spec-confirm-btn-lux {
  flex: 1;
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
}
