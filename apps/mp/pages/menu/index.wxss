/* pages/menu/index.wxss */
page {
  background-color: #050506;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.container {
  height: 100vh;
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 0. 背景层优化 */
.hero-bg-lux-menu {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  background:
    linear-gradient(180deg, rgba(5, 5, 6, 0.9), rgba(5, 5, 6, 0.78)),
    url('/images/setbar-panther-hero.jpg');
  background-size: cover;
  background-position: 72% 20%;
  opacity: 0.92;
}

/* --- 1. 沉浸式头部 --- */
.header-bar {
  padding: 38rpx 32rpx 22rpx;
  background: rgba(5, 5, 6, 0.62);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  justify-content: flex-start;
  backdrop-filter: blur(24rpx);
  position: relative;
  z-index: 2;
  flex-shrink: 0;
}

.brand-info {
  text-align: left;
}

.store-kicker {
  display: block;
  font-size: 16rpx;
  color: #D64A3B;
  font-weight: 800;
  letter-spacing: 6rpx;
  margin-bottom: 8rpx;
}

.store-brand {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 243, 200, 0.7);
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}

.store-name {
  font-size: 54rpx;
  color: #F8F5EC;
  letter-spacing: 0;
  line-height: 1;
  display: block;
}

.store-slogan {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.44);
  letter-spacing: 4rpx;
  font-weight: 500;
  margin-top: 12rpx;
}

/* --- 2. 桌位选择区 --- */
.table-selector {
  padding: 18rpx 30rpx;
  background: rgba(5, 5, 6, 0.74);
  display: flex;
  align-items: center;
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(24rpx);
  position: relative;
  z-index: 2;
  flex-shrink: 0;
}

.table-icon-img {
  width: 30rpx;
  height: 30rpx;
  margin-right: 18rpx;
}

.table-scroll {
  flex: 1;
  white-space: nowrap;
}

.table-item {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  background: rgba(255, 255, 255, 0.055);
  color: rgba(255, 255, 255, 0.5);
  font-size: 22rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.3s;
}

.table-item.selected {
  background: rgba(214, 74, 59, 0.2) !important;
  color: #FFF3C8 !important;
  border-color: rgba(214, 74, 59, 0.55) !important;
  font-weight: 600;
}

.selected-badge {
  color: #E6C678;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  background: rgba(230, 198, 120, 0.1);
  border-radius: 20rpx;
  margin-left: 10rpx;
}

/* --- 3. 内容区域 --- */
.content-container {
  height: 0;
  flex: 1;
  min-height: 0;
  display: flex;
  overflow: hidden;
  background: rgba(5, 5, 6, 0.7);
  position: relative;
  z-index: 1;
}

/* 侧边栏 */
.sidebar {
  width: 156rpx;
  background: rgba(5, 5, 6, 0.88);
  height: 100%;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-right: 1rpx solid rgba(255, 255, 255, 0.05);
}

.sidebar.has-cart {
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

.category-item {
  padding: 38rpx 16rpx;
  position: relative;
  text-align: center;
  transition: all 0.2s;
}

.cat-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.42);
  letter-spacing: 1rpx;
}

.category-item.active {
  background: linear-gradient(90deg, rgba(214, 74, 59, 0.16), transparent);
}

.category-item.active .cat-name {
  color: #FFF3C8;
  font-weight: 600;
}

.cat-indicator {
  position: absolute;
  left: 0; top: 30%; height: 40%;
  width: 6rpx;
  border-radius: 999rpx;
  background: #D64A3B;
  box-shadow: 0 0 18rpx rgba(214, 74, 59, 0.75);
}

/* 商品列表 */
.goods-list {
  flex: 1;
  height: 100%;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.goods-list.has-cart {
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

.goods-item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(18rpx);
  box-shadow: none;
}

.goods-item::after {
  content: "";
  position: absolute;
  top: 0; right: 0; width: 60rpx; height: 60rpx;
  background: radial-gradient(circle at top right, rgba(230, 198, 120, 0.1), transparent 70%);
}

.goods-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  margin-right: 22rpx;
  background: #111;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  color: #F8F5EC;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.25;
}

.goods-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.38);
  line-height: 1.4;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-bonus {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #F29A5B;
  font-weight: 600;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.price-unit {
  font-size: 22rpx;
  color: #E6C678;
  margin-right: 4rpx;
}

.goods-price {
  font-size: 38rpx;
  color: #E6C678;
  font-weight: 700;
  font-family: 'SF Pro Text', sans-serif;
}

.add-btn-lux {
  width: 58rpx;
  height: 58rpx;
  background: rgba(214, 74, 59, 0.18);
  border: 1rpx solid rgba(214, 74, 59, 0.42);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(214, 74, 59, 0.18);
}

.plus-icon-img {
  width: 34rpx;
  height: 34rpx;
}

.list-footer {
  text-align: center;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.14);
  padding: 8rpx 0 0;
  letter-spacing: 10rpx;
}

/* --- 4. 底部购物车栏 --- */
.cart-bar {
  position: fixed;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  left: 24rpx; right: 24rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  z-index: 1000;
  border-radius: 34rpx;
  background: rgba(12, 10, 12, 0.9) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.cart-icon-box {
  width: 90rpx;
  height: 90rpx;
  background: rgba(214, 74, 59, 0.16);
  border-radius: 24rpx;
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 1rpx solid rgba(214, 74, 59, 0.38);
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.5);
}

.cart-icon-img {
  width: 42rpx;
  height: 42rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx; right: -8rpx;
  min-width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #B22222, #9D2E45);
  border-radius: 50%;
  color: #FFF;
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 4rpx 10rpx rgba(178, 34, 34, 0.5);
}

.cart-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.cart-price {
  margin-left: 24rpx;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 20rpx;
  color: #666;
  margin-right: 12rpx;
}

.price-symbol {
  font-size: 24rpx;
  color: #E6C678;
}

.price-value {
  font-size: 48rpx;
  color: #E6C678;
  font-weight: 800;
  font-family: 'SF Pro Display', sans-serif;
  margin-left: 4rpx;
}

.checkout-btn-lux {
  height: 76rpx;
  padding: 0 60rpx;
  background: linear-gradient(135deg, #E6C678 0%, #8C6A2F 100%);
  color: #000;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 25rpx rgba(230, 198, 120, 0.3);
  position: relative;
  overflow: hidden;
}

.checkout-btn-lux::after {
  content: "";
  position: absolute;
  top: 0; left: -100%; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: btnShimmer 3s infinite;
}

@keyframes btnShimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* --- 5. 购物车详情弹窗 --- */
.cart-detail {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10rpx);
  z-index: 1001;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s;
}

.cart-detail.show {
  visibility: visible;
  opacity: 1;
}

.cart-content {
  position: absolute;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  left: 30rpx; right: 30rpx;
  max-height: 60vh;
  padding: 40rpx;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.clear-cart-box {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #444;
}

.clear-icon-img {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  opacity: 0.72;
}

.cart-list {
  flex: 1;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.02);
}

.item-name {
  font-size: 28rpx;
  color: #CCC;
  margin-bottom: 6rpx;
  display: block;
}

.item-price-box {
  display: flex;
  align-items: baseline;
}

.i-unit { font-size: 18rpx; color: #E6C678; margin-right: 4rpx; }
.i-val { font-size: 26rpx; color: #E6C678; font-weight: 600; }

.item-controls {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.control-btn-lux {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(230, 198, 120, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.control-btn-lux.minus::after {
  content: "";
  width: 16rpx; height: 2rpx;
  background: #E6C678;
}

.control-btn-lux.plus::after, .control-btn-lux.plus::before {
  content: "";
  position: absolute;
  background: #E6C678;
}

.control-btn-lux.plus::after { width: 16rpx; height: 2rpx; }
.control-btn-lux.plus::before { width: 2rpx; height: 16rpx; }

.item-count {
  font-size: 28rpx;
  color: #EEE;
  min-width: 40rpx;
  text-align: center;
}

/* --- 6. 规格选择弹窗 --- */
.spec-header-lux {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 50rpx;
}

.spec-product-info {
  display: flex;
  align-items: center;
}

.spec-product-image {
  width: 130rpx;
  height: 130rpx;
  border-radius: 20rpx;
  margin-right: 30rpx;
  background: #111;
}

.spec-product-detail {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.spec-product-name {
  font-size: 36rpx;
  font-weight: 700;
}

.spec-product-price {
  display: flex;
  align-items: baseline;
}

.s-unit { font-size: 22rpx; color: #E6C678; margin-right: 4rpx; }
.s-val { font-size: 34rpx; color: #E6C678; font-weight: 700; }
.s-label { font-size: 18rpx; color: #444; margin-left: 8rpx; }

.spec-close-btn {
  font-size: 40rpx;
  color: #333;
  padding: 10rpx;
}

.spec-body-lux {
  max-height: 50vh;
}

.spec-section {
  margin-bottom: 44rpx;
}

.spec-label {
  font-size: 24rpx;
  color: #444;
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: 2rpx;
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.spec-option {
  flex: 1;
  min-width: calc(33.33% - 14rpx);
  padding: 24rpx 10rpx;
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s;
}

.spec-option.selected {
  background: rgba(230, 198, 120, 0.08) !important;
  border-color: #E6C678 !important;
}

.opt-label { font-size: 26rpx; color: #888; margin-bottom: 4rpx; }
.spec-option.selected .opt-label { color: #E6C678; font-weight: 600; }

.opt-desc { font-size: 18rpx; color: #444; }
.opt-price { font-size: 20rpx; color: #E6C678; margin-top: 6rpx; opacity: 0.8; }

.spec-footer-lux {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30rpx;
}

.spec-price-info {
  display: flex;
  flex-direction: column;
}

.spec-total-label { font-size: 18rpx; color: #444; }
.spec-total-val { font-size: 44rpx; font-weight: 800; }

.spec-confirm-btn-lux {
  flex: 1;
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
}
