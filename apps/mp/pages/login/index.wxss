.login-container {
  min-height: 100vh;
  position: relative;
  background: #000000; /* 纯黑背景 */
  display: flex;
  flex-direction: column;
  padding: 80rpx 40rpx 160rpx;
}

/* 主要内容 */
.main-content {
  flex: 1;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 60rpx; /* 减小间距以容纳新字段 */
}

/* 个人信息设置 */
.profile-setup {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 60rpx;
}

.avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.avatar-btn {
  width: 180rpx !important;
  height: 180rpx !important;
  border-radius: 50% !important;
  padding: 0;
  margin: 0;
  background: #1e293b;
  position: relative;
  border: 4rpx solid #f6c244;
  overflow: visible; /* Allow tag to peek out */
  box-shadow: 0 0 30rpx rgba(246, 194, 68, 0.4);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-edit-tag {
  position: absolute;
  right: 0rpx;
  bottom: 0rpx;
  width: 54rpx;
  height: 54rpx;
  background: #f6c244;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 4rpx solid #000;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.3);
}

.tag-icon {
  font-size: 24rpx;
}

.setup-hint {
  color: #f6c244;
  font-size: 26rpx;
  font-weight: 500;
  opacity: 0.8;
}

.nickname-input-group {
  width: 100%;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(246, 194, 68, 0.2);
  border-radius: 30rpx;
  padding: 34rpx 40rpx;
  box-sizing: border-box;
  margin-top: 20rpx;
}

.nickname-label {
  font-size: 32rpx;
  color: #94a3b8;
  margin-right: 30rpx;
}

.nickname-input {
  flex: 1;
  font-size: 32rpx;
  color: #f6c244;
  text-align: left;
}

.login-btn.disabled {
  opacity: 0.5;
  filter: grayscale(1);
  pointer-events: none;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-text {
  font-size: 180rpx; /* 更大的Logo */
  font-weight: 800;
  color: #f6c244;
  font-family: "Big Caslon", "Book Antiqua", "Palatino Linotype", Georgia, serif;
  letter-spacing: 8rpx;
  text-shadow: 0 0 60rpx rgba(246, 194, 68, 0.6);
  background: linear-gradient(to bottom, #fce293, #f6c244);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.app-name {
  display: block;
  font-size: 60rpx; /* 更大的字体 */
  font-weight: 700;
  color: #ffffff;
  margin-top: 40rpx;
  letter-spacing: 8rpx;
}

.app-desc {
  display: block;
  font-size: 38rpx;
  color: #94a3b8;
  margin-top: 24rpx;
  letter-spacing: 2rpx;
}

/* 登录卡片 */
.login-card {
  background: #000000; /* 卡片背景也改为黑色 */
  border-radius: 60rpx;
  padding: 120rpx 20rpx; /* 减少内边距以让按钮更宽 */
  border: 1rpx solid rgba(246, 194, 68, 0.3); /* 稍微加强一点边框感 */
}

.card-header {
  text-align: center;
  margin-bottom: 100rpx;
}

.welcome-title {
  display: block;
  font-size: 72rpx; /* 更大 */
  font-weight: 800;
  color: #f6c244;
  margin-bottom: 32rpx;
  letter-spacing: 4rpx;
}

.welcome-subtitle {
  font-size: 38rpx;
  color: #cbd5e1;
  opacity: 0.9;
}

/* 登录按钮 */
.login-btn {
  width: 100% !important; /* 强制占满卡片宽度 */
  background: linear-gradient(135deg, #f6c244, #d9a01b);
  border: none;
  border-radius: 120rpx;
  height: 160rpx; /* 加高 */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 80rpx;
  padding: 0;
  box-shadow: 0 15rpx 50rpx rgba(246, 194, 68, 0.5);
}

.login-btn.loading {
  background: #475569;
  box-shadow: none;
}

.login-btn::after {
  border: none;
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-text {
  font-size: 48rpx; /* 大字体 */
  font-weight: 800;
  color: #000000;
  white-space: nowrap; /* 禁止换行 */
}

/* 协议 */
.agreement {
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
  margin-top: 60rpx;
}

.agreement-text {
  color: #64748b;
}

.agreement-link {
  color: #f6c244;
  margin: 0 8rpx;
  font-weight: 600;
}

/* 游客提示 */
.guest-tip {
  margin-top: 100rpx;
  text-align: center;
}

.guest-link {
  display: inline-block;
  font-size: 34rpx;
  color: #94a3b8;
  padding: 28rpx 80rpx;
  background: rgba(30, 41, 59, 0.4);
  border-radius: 120rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* 隐藏背景层和页脚 */
.bg-overlay, .footer {
  display: none !important;
}