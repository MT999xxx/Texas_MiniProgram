/* pages/login/index.wxss */
.login-container {
  min-height: 100vh;
  position: relative;
  background-color: #080808;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 沉浸式背景背景层 */
.bg-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(circle at top right, #1a150a 0%, #080808 100%);
  display: block;
}

.bg-pattern {
  width: 100%; height: 100%;
  opacity: 0.03;
  background-image: radial-gradient(#D4AF37 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}

/* 主要内容 */
.main-content {
  flex: 1;
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 50rpx;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 80rpx;
  animation: fadeInDown 1.2s ease;
}

.logo {
  margin-bottom: 30rpx;
}

.logo-text {
  font-size: 160rpx;
  font-weight: 900;
  color: #D4AF37;
  letter-spacing: 24rpx;
  background: linear-gradient(180deg, #D4AF37 0%, #B8860B 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.4);
}

.app-name {
  display: block;
  font-size: 24rpx;
  color: #888;
  letter-spacing: 12rpx;
  text-transform: uppercase;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  padding: 60rpx 40rpx;
  animation: fadeInUp 1s ease;
}

.card-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.welcome-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #FDFDFD;
  margin-bottom: 16rpx;
}

.welcome-subtitle {
  font-size: 24rpx;
  color: #666;
  letter-spacing: 2rpx;
}

/* 个人信息设置 */
.profile-setup {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-wrapper {
  margin-bottom: 40rpx;
  position: relative;
}

.avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50% !important;
  padding: 0;
  background: #111;
  border: 2rpx solid #D4AF37;
  box-shadow: 0 0 30rpx rgba(212, 175, 55, 0.2);
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-edit-tag {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: #D4AF37;
  color: #000;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
  border: 4rpx solid #080808;
}

.setup-hint {
  font-size: 22rpx;
  color: #888;
  margin-top: 16rpx;
}

.nickname-input-group {
  width: 100%;
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(212, 175, 55, 0.1);
  border-radius: 12rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
}

.nickname-label {
  font-size: 28rpx;
  color: #D4AF37;
  margin-right: 30rpx;
  font-weight: 600;
}

.nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: #FDFDFD;
}

/* 登录按钮 */
.login-btn {
  width: 100% !important;
  height: 100rpx !important;
  background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%) !important;
  border-radius: 50rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(212, 175, 55, 0.3);
  transition: all 0.2s;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
  letter-spacing: 4rpx;
}

.login-btn.disabled {
  background: #333 !important;
  box-shadow: none !important;
  opacity: 0.5;
}

/* 协议 */
.agreement {
  margin-top: 40rpx;
}

.agreement-label {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
}

.agreement-checkbox {
  margin-top: 4rpx;
  margin-right: 12rpx;
  transform: scale(0.8);
}

.agreement-text {
  color: #666;
}

.agreement-link {
  color: #D4AF37;
  padding: 0 4rpx;
  font-weight: 500;
}

/* 其他内容 */
.footer {
  margin-top: auto;
  padding-bottom: 40rpx;
}

.footer-text {
  font-size: 20rpx;
  color: #333;
  letter-spacing: 2rpx;
}

.guest-tip {
  margin-top: 30rpx;
}

.guest-link {
  font-size: 26rpx;
  color: #888;
  text-decoration: underline;
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}