/* pages/login/index.wxss */
.login-container {
  min-height: 100vh;
  position: relative;
  background-color: #050506;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 0. 沉浸式背景背景层 (同步全站极致规范) */
.hero-bg-lux-login {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  background:
    linear-gradient(180deg, rgba(5, 5, 6, 0.5), rgba(5, 5, 6, 0.96)),
    url('/images/share-cover.jpg'),
    radial-gradient(circle at 70% 20%, rgba(230, 198, 120, 0.12) 0%, transparent 60%),
    radial-gradient(circle at 0% 80%, rgba(102, 72, 255, 0.08) 0%, #050506 100%);
  background-size: cover, cover, auto, auto;
  background-position: center, center, center, center;
  overflow: hidden;
}

.hero-bg-lux-login::before {
  content: "";
  position: absolute;
  top: -50%; left: -50%; width: 200%; height: 200%;
  background-image: radial-gradient(rgba(230, 198, 120, 0.12) 1rpx, transparent 1rpx);
  background-size: 96rpx 96rpx;
  opacity: 0.24;
  animation: floatParticles 60s linear infinite;
}

/* 主要内容 */
.main-content {
  flex: 1;
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 50rpx;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 80rpx;
  animation: fadeInDown 1.2s ease;
}

.logo {
  margin-bottom: 30rpx;
}

.logo-text {
  font-size: 108rpx;
  font-weight: 800;
  color: #E6C678;
  letter-spacing: 3rpx;
  background: linear-gradient(180deg, #FFF3C8 0%, #E6C678 52%, #8C6A2F 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 10rpx 40rpx rgba(230, 198, 120, 0.34);
  position: relative;
}

.logo-text::after {
  content: "Set baR";
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  -webkit-background-clip: text;
  animation: logoShimmer 4s infinite;
}

@keyframes logoShimmer {
  0% { transform: translateX(-10%); opacity: 0; }
  50% { opacity: 0.5; }
  100% { transform: translateX(10%); opacity: 0; }
}

.app-name {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.52);
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  padding: 60rpx 40rpx;
  animation: fadeInUp 1s ease;
}

.card-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.welcome-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #FDFDFD;
  margin-bottom: 16rpx;
}

.welcome-subtitle {
  font-size: 24rpx;
  color: #666;
  letter-spacing: 2rpx;
}

/* 个人信息设置 */
.profile-setup {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-wrapper {
  margin-bottom: 40rpx;
  position: relative;
}

.avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50% !important;
  padding: 0;
  background: #111;
  border: 2rpx solid #E6C678;
  box-shadow: 0 0 30rpx rgba(230, 198, 120, 0.22);
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-edit-tag {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: #E6C678;
  color: #000;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
  border: 4rpx solid #050506;
}

.setup-hint {
  font-size: 22rpx;
  color: #888;
  margin-top: 16rpx;
}

.nickname-input-group {
  width: 100%;
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(230, 198, 120, 0.12);
  border-radius: 12rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
}

.nickname-label {
  font-size: 28rpx;
  color: #E6C678;
  margin-right: 30rpx;
  font-weight: 600;
}

.nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: #FDFDFD;
}

/* 登录按钮 */
.login-btn {
  width: 100% !important;
  height: 100rpx !important;
  background: linear-gradient(135deg, #FFF3C8 0%, #E6C678 100%) !important;
  border-radius: 50rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(230, 198, 120, 0.28);
  transition: all 0.2s;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
  letter-spacing: 4rpx;
}

.login-btn.disabled {
  background: #333 !important;
  box-shadow: none !important;
  opacity: 0.5;
}

/* 协议 */
.agreement {
  margin-top: 40rpx;
}

.agreement-label {
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
}

.agreement-checkbox {
  margin-top: 4rpx;
  margin-right: 12rpx;
  transform: scale(0.8);
}

.agreement-text {
  color: #666;
}

.agreement-link {
  color: #E6C678;
  padding: 0 4rpx;
  font-weight: 500;
}

/* 其他内容 */
.footer {
  margin-top: auto;
  padding-bottom: 40rpx;
}

.footer-text {
  font-size: 20rpx;
  color: #333;
  letter-spacing: 2rpx;
}

.guest-tip {
  margin-top: 30rpx;
}

.guest-link {
  font-size: 26rpx;
  color: #888;
  text-decoration: underline;
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}