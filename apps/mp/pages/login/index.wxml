<view class="login-container">
  <view class="hero-bg-lux-login"></view>

  <!-- Main Content -->
  <view class="main-content">
    <!-- Branding Section -->
    <view class="logo-section">
      <view class="logo">
        <text class="logo-text">Set baR</text>
      </view>
      <text class="app-name">酒廊 · 鸡尾酒吧</text>
    </view>

    <!-- Glassmorphism Card -->
    <view class="login-card glass-panel gold-border shadow-lux">
      <view class="card-header">
        <text class="welcome-title">欢迎回来</text>
        <text class="welcome-subtitle">今晚，从 Set baR 开始</text>
      </view>

      <!-- Profile Section -->
      <view class="profile-setup">
        <view class="avatar-wrapper">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="avatar-img" src="{{avatarUrl || '/images/huiyuan2.jpg'}}" mode="aspectFill" />
            <view class="avatar-edit-tag">📷</view>
          </button>
          <text class="setup-hint">设置您的会员头像</text>
        </view>

        <view class="nickname-input-group glass-panel">
          <text class="nickname-label">昵称</text>
          <input type="nickname" class="nickname-input" placeholder="输入您的名牌"
                 bindinput="onInputNickname" value="{{nickname}}"
                 placeholder-class="lux-placeholder" maxlength="20" />
        </view>
      </view>

      <!-- Action Button -->
      <button class="login-btn {{(!nickname) ? 'disabled' : ''}}"
              bindtap="onLoginClick" wx:if="{{!loading}}">
        <text class="btn-text">授权并开启</text>
      </button>

      <!-- Loading State -->
      <view class="login-btn disabled" wx:if="{{loading}}">
        <text class="btn-text">认证中...</text>
      </view>

      <!-- Agreements -->
      <view class="agreement">
        <checkbox-group bindchange="onAgreementChange">
          <label class="agreement-label">
            <checkbox value="agreed" checked="{{isAgreed}}" class="agreement-checkbox" />
            <view class="agreement-content">
              <text class="agreement-text">我已阅读并同意</text>
              <text class="agreement-link" catchtap="showUserAgreement">用户协议</text>
              <text class="agreement-text">与</text>
              <text class="agreement-link" catchtap="showPrivacyPolicy">隐私政策</text>
            </view>
          </label>
        </checkbox-group>
      </view>
    </view>

    <view class="guest-tip" wx:if="{{showGuestTip}}">
      <text class="guest-link" bindtap="continueAsGuest">匿名访客模式</text>
    </view>

    <view class="footer">
      <text class="footer-text">© Set baR · 现代黑金酒廊</text>
    </view>
  </view>
</view>
