<view class="login-container">
  <!-- 背景 -->
  <view class="bg-overlay">
    <view class="bg-pattern"></view>
  </view>

  <!-- 主要内容 -->
  <view class="main-content">
    <!-- Logo区域 -->
    <view class="logo-section">
      <view class="logo">
        <text class="logo-text">AAA</text>
      </view>
      <text class="app-name">德州扑克主题酒吧</text>
      <text class="app-desc">三条A</text>
    </view>

    <!-- 登录卡片 -->
    <view class="login-card">
      <view class="card-header">
        <text class="welcome-title">欢迎来到德州</text>
        <text class="welcome-subtitle">请设置您的个人资料以开启体验</text>
      </view>

      <!-- 个人信息设置 -->
      <view class="profile-setup">
        <view class="avatar-wrapper">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="avatar-img" src="{{avatarUrl || '/images/huiyuan2.jpg'}}" />
            <view class="avatar-edit-tag">
              <text class="tag-icon">📸</text>
            </view>
          </button>
          <text class="setup-hint">点击设置头像</text>
        </view>
        
        <view class="nickname-input-group">
          <text class="nickname-label">昵称</text>
          <input type="nickname" class="nickname-input" placeholder="请输入或选择昵称" bindinput="onInputNickname" bindchange="onInputNickname" value="{{nickname}}" placeholder-style="color: rgba(255,255,255,0.3)" />
        </view>
      </view>

      <!-- 登录按钮 -->
      <button
        class="login-btn {{(!nickname) ? 'disabled' : ''}}"
        bindtap="onLoginClick"
        wx:if="{{!loading}}"
      >
        <view class="btn-content">
          <text class="btn-text">确认并登录</text>
        </view>
      </button>

      <!-- 加载状态 -->
      <view class="login-btn loading" wx:if="{{loading}}">
        <view class="btn-content">
          <text class="loading-icon">⏳</text>
          <text class="btn-text">登录中...</text>
        </view>
      </view>


      <!-- 协议 -->
      <view class="agreement">
        <text class="agreement-text">登录即表示同意</text>
        <text class="agreement-link" bindtap="showUserAgreement">《用户协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" bindtap="showPrivacyPolicy">《隐私政策》</text>
      </view>
    </view>

    <!-- 底部装饰 -->
    <view class="footer">
      <text class="footer-text">Powered by 三条A</text>
    </view>
  </view>

  <!-- 游客模式提示 -->
  <view class="guest-tip" wx:if="{{showGuestTip}}">
    <text class="guest-link" bindtap="continueAsGuest">暂不登录，以游客身份体验</text>
  </view>
</view>