.skeleton-item {
  background: #1a1a1a;
  position: relative;
  overflow: hidden;
}

.shape-block {
  border-radius: 8rpx;
  width: 100%;
  height: 100rpx;
}

.shape-circle {
  border-radius: 50%;
  width: 100rpx;
  height: 100rpx;
}

.shape-line {
  border-radius: 4rpx;
  width: 100%;
  height: 32rpx;
}

.animate::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg, 
    rgba(255, 255, 255, 0) 0, 
    rgba(255, 255, 255, 0.05) 50%, 
    rgba(255, 255, 255, 0) 100%
  );
  animation: skeleton-shimmer 1.5s infinite;
}

@keyframes skeleton-shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}
