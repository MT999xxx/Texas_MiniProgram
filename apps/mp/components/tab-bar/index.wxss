/* components/tab-bar/index.wxss */
.custom-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(128rpx + env(safe-area-inset-bottom));
  padding: 10rpx 30rpx calc(10rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 0;
  background: linear-gradient(180deg, rgba(5, 5, 6, 0.82), rgba(0, 0, 0, 0.97));
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 -18rpx 60rpx rgba(0, 0, 0, 0.56);
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
  display: flex;
  z-index: 9999;
}

.tab-item {
  flex: 1;
  min-width: 0;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: background 0.18s ease, transform 0.18s ease, opacity 0.18s ease;
}

.tab-item:active {
  transform: scale(0.96);
  opacity: 0.82;
}

.tab-item.active {
  background: linear-gradient(180deg, rgba(214, 74, 59, 0.14), rgba(230, 198, 120, 0.08));
}

.tab-icon-shell {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-img {
  width: 38rpx;
  height: 38rpx;
  opacity: 0.86;
}

.tab-item.active .tab-icon-img {
  opacity: 1;
  filter: drop-shadow(0 0 14rpx rgba(214, 74, 59, 0.48));
}

.tab-item text {
  font-size: 20rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.42);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.tab-item.active text {
  color: #FFF3C8;
  text-shadow: 0 0 16rpx rgba(230, 198, 120, 0.28);
}
