<!--components/tab-bar/index.wxml-->
<view class="custom-tab-bar">
  <block wx:for="{{list}}" wx:key="index">
    <view wx:if="{{!item.hidden}}" class="tab-item {{selected === index ? 'active' : ''}}" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
      <view class="tab-icon-shell">
        <image class="tab-icon-img" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit" />
      </view>
      <text>{{item.text}}</text>
    </view>
  </block>
</view>
