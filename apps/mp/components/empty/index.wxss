.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  background: rgba(212, 175, 55, 0.05);
  border-radius: 50%;
  position: relative;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
}

.icon-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
}

/* 基于 CSS 的黑金图标 - 盒子 (空列表) */
.type-box .icon-inner {
  border: 4rpx solid #D4AF37;
  border-radius: 8rpx;
}
.type-box .icon-inner::after {
  content: "";
  position: absolute;
  top: 40%;
  left: 10%;
  width: 80%;
  height: 4rpx;
  background: #D4AF37;
  box-shadow: 0 10rpx 0 #D4AF37;
}

/* 基于 CSS 的黑金图标 - 列表 */
.type-list .icon-inner {
  width: 60rpx;
}
.type-list .icon-inner::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: #D4AF37;
  box-shadow: 0 20rpx 0 #D4AF37, 0 40rpx 0 #D4AF37;
}

.empty-text {
  font-size: 32rpx;
  color: #D4AF37;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #888;
}
