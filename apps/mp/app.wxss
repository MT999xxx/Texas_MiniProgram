/* =========================================================
   Royal Night Gold Design System (重构版)
   ========================================================= */

page {
  background-color: #080808;
  color: #FDFDFD;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', sans-serif;
  line-height: 1.5;
}

/* 1. 全局设计变量 */
.container {
  padding: 30rpx;
  box-sizing: border-box;
}

/* 2. 核心按钮样式 */
button {
  border-radius: 12rpx; /* 更加硬朗、高级的微圆角 */
  font-size: 28rpx;
  transition: all 0.2s ease;
  overflow: visible;
}

button::after {
  border: none;
}

button:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 皇家金渐变按钮 */
.btn-primary {
  background: linear-gradient(135deg, #D4AF37 0%, #B8860B 100%);
  color: #000;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(212, 175, 55, 0.2);
}

/* 奢华红渐变按钮 (用于扑克特色) */
.btn-danger {
  background: linear-gradient(135deg, #8b0000 0%, #4a0e0e 100%);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(139, 0, 0, 0.2);
}

/* 极夜黑辅按钮 */
.btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  color: #D4AF37;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
}

/* 3. 字体样式 */
.text-gold { color: #D4AF37; }
.text-white { color: #FDFDFD; }
.text-muted { color: #888888; }
.text-red { color: #B22222; }

/* 4. 装饰效果 (Glassmorphism & Shadows) */

/* 毛玻璃质感 */
/* Royal Night Gold 系统通行工具类 */
.glass-panel {
  background: rgba(255, 255, 255, 0.03) !important;
  backdrop-filter: blur(30rpx) !important;
  -webkit-backdrop-filter: blur(30rpx) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.08); /* 稍微增加明亮度 */
  border-radius: 30rpx;
}

.gold-border {
  border: 1rpx solid rgba(212, 175, 55, 0.25) !important;
  position: relative;
}

/* 深度阴影 */
.shadow-lux {
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.8) !important;
}

/* 金色渐变文字 */
.text-gold-gradient {
  background: linear-gradient(180deg, #F9E498 0%, #D4AF37 50%, #B8860B 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.bg-dark {
  background-color: #080808 !important;
}

.redesign-bg {
  background: radial-gradient(circle at top right, #1a150a 0%, #080808 100%) !important;
  min-height: 100vh;
}

/* 通用动画 */
@keyframes shimmer {
  0% { transform: translateX(-100%) rotate(30deg); }
  100% { transform: translateX(200%) rotate(30deg); }
}

.shimmer-effect {
  position: relative;
  overflow: hidden;
}

.shimmer-effect::after {
  content: "";
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.1), transparent);
  animation: shimmer 3s infinite;
}

/* 5. 间距辅助类 (保留原有习惯但优化数值) */
.mt-sm { margin-top: 10rpx; }
.mt-md { margin-top: 20rpx; }
.mt-lg { margin-top: 40rpx; }
.mb-md { margin-bottom: 20rpx; }
.mb-lg { margin-bottom: 40rpx; }

/* 6. 辅助工具 */
.flex { display: flex; }
.flex-column { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-1 { flex: 1; }

.text-center { text-align: center; }
.font-bold { font-weight: 600; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 全局弹窗背景遮罩 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(5px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
